  (title_block 
    (title "Motorola MC68030RC25B DUT daughter board") 
    (date "2026-09-13") 
    (rev "1.0") 
    (comment 1 "CPGA128 / 5 V / full bus, burst and takeover / experimental direct interface")) 
  (text "HOST CONTRACT\n5V_SELECT grounded; 3V3_SELECT floating. CPU clock: 12.5-25 MHz; timing not yet qualified.\nX/Y: open-drain only; keep enabled, release HIGH, never drive HIGH. Internal host pulls used.\nPreload all tied unused bank bits LOW before every host-output enable.\nRespect byte lanes and bus-release delays; never drive always-output bank.\nCPU TTL output-high and host keeper margins are NOT guaranteed. See design-notes.md." 
    (at 255.27 383.54 0) 
    (effects 
      (font 
        (size 1.1 1.1))) 
    (uuid "d25a3a1a-b208-4725-a675-be83de1e9dba")))
