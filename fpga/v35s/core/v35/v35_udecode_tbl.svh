                default: v35_uml = 1'b0;
            endcase
            default: v35_uml = 1'b0;
        endcase
    endfunction

    function automatic logic [2:0] v35_upage(input logic [7:0] b);
        case (b)
            8'h10, 8'h11, 8'h12, 8'h13, 8'h14, 8'h15, 8'h16, 8'h17, 8'h28, 8'h2A, 8'h2D, 8'h31, 8'h33, 8'h94, 8'h95, 8'hFF: v35_upage = 3'd1;
            8'h18, 8'h19, 8'h1A, 8'h1B, 8'h1C, 8'h1D, 8'h1E, 8'h1F, 8'h39, 8'h3B: v35_upage = 3'd2;
            8'h9C: v35_upage = 3'd3;
            default: v35_upage = 3'd0;
        endcase
    endfunction
