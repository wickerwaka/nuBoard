                    8'h18, 8'h19, 8'h1A, 8'h1B, 8'h1C, 8'h1D, 8'h1F: f = '{12'd2588, 1'b0, 3'd3, 1'b1, 1'b0, 1'b0, 1'b0, 1'b0};
