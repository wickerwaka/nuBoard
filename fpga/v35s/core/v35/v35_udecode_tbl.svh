                    8'hA8, 8'hA9, 8'hAA, 8'hAB, 8'hAC, 8'hAD, 8'hAE, 8'hAF: f = '{11'd1712, 1'b0, 3'd5, 1'b0, 1'b0, 1'b0, 1'b0, 1'b0};
                    8'h18, 8'h19, 8'h1A, 8'h1B, 8'h1C, 8'h1D, 8'h1F: f = '{11'd1721, 1'b0, 3'd3, 1'b1, 1'b0, 1'b0, 1'b0, 1'b0};
                    8'h58, 8'h59, 8'h5A, 8'h5B, 8'h5C, 8'h5D, 8'h5E, 8'h5F: f = '{11'd1736, 1'b0, 3'd3, 1'b0, 1'b0, 1'b0, 1'b0, 1'b0};
                    8'h98, 8'h99, 8'h9A, 8'h9B, 8'h9C, 8'h9D, 8'h9E, 8'h9F: f = '{11'd1739, 1'b0, 3'd3, 1'b0, 1'b0, 1'b0, 1'b0, 1'b0};
