    function automatic logic [2:0] v35_umodrm(input logic [7:0] op, input logic [7:0] mb);
        logic [2:0] dsp;
        dsp = mb[7:6] == 2'd1 ? 3'd1 : mb[7:6] == 2'd2 ? 3'd2 : (mb[7:6] == 2'd0 && mb[2:0] == 3'd6) ? 3'd2 : 3'd0;
