            8'hC7: v35_umodrm = dsp + 3'd2;
            8'hF6: v35_umodrm = dsp + (mb[5:4] == 2'd0 ? 3'd1 : 3'd0);
            8'hF7: v35_umodrm = dsp + (mb[5:4] == 2'd0 ? 3'd2 : 3'd0);
            default: v35_umodrm = dsp;
        endcase
    endfunction

