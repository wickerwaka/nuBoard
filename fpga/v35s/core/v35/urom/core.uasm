; MX0 core routines: the reset, the shared heads, the trap routines, the prefixes, HALT.
; One line is one microinstruction (one CPU clock); the comment names its act. (MX0d) Every
; routine's length at EA = 3, W = 0 is the data book's formula; a word marked OPEN is a book
; clock no act names (README "MX0d": the agenda the mechanism note's rule puts on them).

routine reset
    e                                       ; E: pop the first opcode (the reset vector's), the decode follows

; (MX3c) the 0F page has no head word: the E word pops the second opcode byte with the opcode
; (into the ModR/M register) and the dispatch reads the second level on it (page.uasm)

; ---- the traps: an opcode / cell without a routine pops its bytes by its format and ends
; (MX0 reports these runs; nothing is executed). The loop counter is the instruction's
; remaining byte count (LEN), a loop of one pop a word.
routine trap
    cnt=len                                 ; the counter: the bytes after the opcode (the format's)
    jmp=trap_test                           ; to the common pop loop

routine trapm
    cnt=len                                 ; the counter: the displacement and immediate bytes after the ModR/M byte
    jmp=trap_test                           ; to the common pop loop

routine trap0f
    cnt=len                                 ; the counter: the 0F form's immediate bytes
    jmp=trap_test                           ; to the common pop loop

routine trap0fm
    pop=modrm cnt=len                       ; pop the 0F form's ModR/M byte; the counter: its displacement and immediate
trap_test: jc=CNTZ:trap_end                 ; nothing left to pop: end
trap_pop: pop=il loop=trap_pop              ; pop one byte (into IL: discarded); the counter step
trap_end: e                                 ; E: pop the next opcode

; ---- prefixes: their own instruction (data book: 2)
routine pfx op=26,2E,36,3E book="segment override prefix" why="the prefix register written on the E word: the book's 2"
    pfx e nb                                ; the segment prefix register <- the prefix's segment (the format's); E; (F3) nb: no interrupt or single step at the next instruction's start (f3_step)

routine lock op=F0 book="BUSLOCK" why="the bus lock pin is not built: its one word is the E word"
    pfx e nb                                ; E: pop the next opcode (BUSLOCK: the lock output not built); (F3) nb: a prefix, no boundary after it; (F5b) pfx: a segment prefix before it kept

; ---- HALT (data book: N/A): (WO50, DESIGN-INT section 1) HALT's wait is a loop of two halt words:
; B tests the release, A the take, alternating, so each test is made every second clock; B is
; HALT's own first word. On a halt word the condition field is read as the loop's two tests (no
; new condition code): DN is the controller's wake, SGN the take as it stands (sgo:
; NMI's or the maskable offer's). The prefetcher stops at HALT's pop (the queue suspended from the
; loop's second clock: a fetch pending under an EU cycle is still made) and stays stopped under
; the take's words. Release (B): the E, the instruction after HALT, whose start takes no maskable
; request (NBI: it runs, a take follows at its end); with IE 0 the wake is the controller's count
; from B in a slot (f5_la_w1 .. w9). Take (A, IE 1): the take's dispatch with no E and no fetch
; (the pushed PC is behind HALT: f3_vec)
routine halt op=F4 hlt=1 why="(WO50) HALT's wait as silicon's two-word loop (B the release test, A the take test, each every second clock; DESIGN-INT section 1, f5_la_w1 .. w9 exact). OPEN: the take out of HALT with IE 1 (A before B: the dispatch with no E) is built in the trial's phase; its first take is 4 clocks early or late in most f5_la_a / b / e / g frames (the phase differs on silicon with and without a fetch pending at HALT's pop; the selecting signal is not found: rows H1)"
hl_b: halt jnc=DN:hl_a                      ; B: the release test (on a halt word the condition DN reads the controller's wake); not released: the take test
    e seg=NBI                               ; the release: E, the instruction after HALT; NBI: its start takes no maskable request (it runs first)
hl_a: halt jnc=SGN:hl_b                     ; A: the take test (on a halt word SGN reads the take as it stands); none: back to B
    halt                                    ; a word under the take (the prefetch stop stands)
    halt                                    ; a word under the take (the prefetch stop stands)
    halt redisp                             ; the take's dispatch: the interrupt entry with no E and no fetch (no take after all: HALT again)
