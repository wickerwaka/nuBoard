; MX0 register routines: the two-operand register forms, the short register forms, the flag
; operations and conversions, the immediate forms, the unary group's register forms.
; (MX0d) Every routine's length at EA = 3, W = 0 is the data book's formula (the user's first
; draft of every routine); the shape follows the V20 routine (V20UC.TXT) where one exists. The
; measured V35S costs are the book's plus the dispatch's fetch stall (README "MX0c", "MX0d"),
; so they are not a reason for a word. A ModR/M form's ModR/M byte is popped by the E word that
; pops its opcode. A word marked OPEN is a book clock no act names.
; Register reads are RAM reads (ports A and B, this word's data in its second tick), a write is
; the RAM's write port at the word's end; SIG is the ALU result of an earlier word.

; ---- two operands, ModR/M register form (V20 ALU_RM 0000-0001)
routine alu_rr op=00-03,08-0B,10-13,18-1B,20-23,28-2B,30-33 mod=reg book="ADD reg,reg" why="the two registers' RAM read, the ALU and E on one word, the write after it: the book's 2 (MX2: silicon's S-to-S 3 is the take sync's wait on the ModR/M pop, the E word waiting for the word its room asked for: F3-push-mov_aw_dw-k2-pE-w0, the frozen model's next start on that word's delivery, S+3; MX1b's read word of its own put the E a clock after it)"
    ra=DST rb=SRC alu=GRP ax=RA ay=RB wf e  ; read the destination and the source; the group's ALU op, flags (W); E
    wr=DST ws=SIG                           ; post-E: the result into the destination (0001)

routine cmp_rr op=38-3B mod=reg book="CMP reg,reg" why="the registers' RAM read, CMP and E on one word: the book's 2 (MX2: as ADD reg,reg, silicon's 3 the take sync's wait)"
    ra=DST rb=SRC alu=GRP ax=RA ay=RB wf e  ; read both operands; CMP (the difference's flags, W); E

routine mov_rr op=88-8B mod=reg book="MOV reg,reg" why="the source's RAM read and its pass with E on one word, the write after it: the book's 2 (MX2: silicon's S-to-S 3 is the take sync's wait, F3-push-mov_aw_dw-k2-pE-w0: the frozen model's next start at S+3 on the delivery of the word the ModR/M pop's room asked for)"
    rb=SRC alu=PASS ax=RB e                 ; read the source; through the ALU; E
    wr=DST ws=SIG                           ; post-E: the destination <- SIGMA (004D)

; V20 XCHG_RM 0048-004A: two reads, then one write a word (the write port is one)
routine xch_rr op=86,87 mod=reg book="XCH reg,reg" diff=-1 why="book error: the book's 3 against silicon's 3 (v35s-eu-timing.md; the a6 sweep's cost (docs/v35s-mechanisms/classes.md) less the dispatch's fetch stall its method puts under the marker: 2); the reads and the r/m write on the E word, the reg write after it"
    ra=REG rb=RM wr=RM ws=RA d1=TB s1=RB e  ; read both; the r/m register <- the reg one; tmpb <- the r/m one; E
    wr=REG ws=TB                            ; post-E: the reg register <- tmpb

routine test_rr op=84,85 mod=reg book="TEST reg,reg" why="(qprobe round 8, Q20) TEST r,r is `P . BN .` (the qprobe t-test / em3-test runs): the reads, the AND, the E word bus-idle (B: waits while a fetch's pin cycle runs) with N: the book's 4"
    ra=REG rb=RM d1=TA s1=RA d2=TB s2=RB    ; read both into tmpa / tmpb
    alu=AND ax=TA ay=TB wf                  ; AND, flags (W)
    e bi                                    ; E (TEST writes nothing); (qprobe round 8, Q20) bi: the bus-idle third word (B N)

; MOV to / from a segment register (V20 MOV_SREG 0050)
routine mov_sr op=8C mod=reg book="MOV reg16,sreg" diff=-1 why="book error: the book's 3 against silicon's 3 (a6 MOV CW,SS 3; the a6 sweep's cost (docs/v35s-mechanisms/classes.md) less the dispatch's fetch stall its method puts under the marker: 2); the read on the E word, the write after it"
    rb=SREG wid=WORD alu=PASS ax=RB e       ; read the segment register through the ALU; E
    wr=RM wid=WORD ws=SIG                   ; post-E: the register <- it

routine mov_rs op=8E mod=reg book="MOV sreg,reg16" diff=-2 lead=2 why="(qprobe rules 12, 14) MOV sreg,r16 is `PN .` with lead 2: the boundary into it no sooner than two clocks after its opcode's release (the qprobe sr runs); book error: the book's 4 against silicon's 3 (a6 MOV DS1,DW 3; the a6 sweep's cost (docs/v35s-mechanisms/classes.md) less the dispatch's fetch stall its method puts under the marker: 2); the read on the E word, the segment write after it"
    rb=RM wid=WORD alu=PASS ax=RB e nb      ; read the register through the ALU; E; (F3) nb: no interrupt or single step at the next instruction's start (f3_step)
    wr=SREG wid=WORD ws=SIG                 ; post-E: the segment register <- it (RAM and the segment flop)

; ---- short register forms
routine inc16 op=40-47 book="INC reg16" why="one word and the post-E write: the book's 2"
    ra=OPR wid=WORD alu=INC ax=RA wf e      ; read the register; +1, flags but CY (W); E
    wr=OPR wid=WORD ws=SIG                  ; post-E: the register <- SIGMA

routine dec16 op=48-4F book="DEC reg16" why="as INC: the book's 2"
    ra=OPR wid=WORD alu=DEC ax=RA wf e      ; read the register; -1, flags but CY (W); E
    wr=OPR wid=WORD ws=SIG                  ; post-E: the register <- SIGMA

; V20 XCHG_AX 005C-005E (NOP is XCH AW,AW)
routine xch_aw op=90-97 book="XCH AW,reg16" why="OPEN: the reads, one book clock with no act, one write on the E word, the other after it: the book's 4 (NOP / XCH AW,DW S-to-S 4: F3-push-nop-k4-pE-w0, F3-push-xch_aw_dw-k4-pE-w0)"
    ra=AW rb=OPR wid=WORD d1=TA s1=RA d2=TB s2=RB ro   ; read AW and the register into tmpa / tmpb (005C); (qprobe rule 6) ro: the next opcode released (the model's N on the first word)
    open                                    ; OPEN: a book clock with no act (XCH AW,reg16 4)
    wr=OPR wid=WORD ws=TA e                 ; the register <- tmpa (AW) (005D); E
    wr=AW wid=WORD ws=TB                    ; post-E: AW <- tmpb (the register) (005E)

routine flag op=F5,F8,F9,FC,FD book="CLR1 CY" why="one word: the book's 2"
    alu=FLAG wf e                           ; the format's flag operation on the PSW; E

routine flag_di op=FA book="DI" why="OPEN: the book's 4, two clocks with no act (the interrupt controller is not built)"
    open                                    ; OPEN: a book clock with no act (DI 4)
    open                                    ; OPEN: a book clock with no act (DI 4)
    alu=FLAG wf e nb                        ; IE <- 0; E; (F3) nb: no interrupt or single step at the next instruction's start (f3_step)

routine flag_ei op=FB book="EI" why="OPEN: the book's 12, ten clocks with no act (the interrupt controller is not built)"
    open call=w9                            ; OPEN: 10 clocks: a book clock with no act (EI 12) (the call and the shared delay's 9)
    alu=FLAG wf e nb                        ; IE <- 1; E; (F3) nb: no interrupt or single step at the next instruction's start (f3_step)

routine lahf op=9F book="MOV AH,PSW" why="one word: the book's 2"
    wr=AW wid=HIGH ws=PSW e                 ; AH <- the PSW's low byte; E

routine sahf op=9E book="MOV PSW,AH" why="the read and the PSW write: the book's 3"
    ra=AW wid=WORD d1=TB s1=RA              ; read AW into tmpb
    alu=PSWL ax=TB wf e                     ; the PSW's low byte <- AH; E

; V20 CBW 0060-0061
routine cvtbw op=98 book="CVTBW" why="the book's 3 (qprobe rule 6: CVTBW is `N . .`, the next opcode released on the first word, three words to the dispatch); the read and the extension with the release, the write on the E word"
    ra=AW wid=WORD alu=SEXT ax=RA ro        ; read AW; AL sign-extended; (qprobe) ro: the next opcode released
    wr=AW wid=WORD ws=SIG e                 ; AW <- SIGMA; E

; V20 CWD 0064-0067: DW <- AW's sign
routine cvtwl op=99 book="CVTWL" why="OPEN: the book's 8: a read and a write (V20 CWD), five clocks with no act"
    ra=AW wid=WORD alu=SIGNW ax=RA          ; read AW; its sign as a word (0000 / FFFF)
    open call=w4                            ; OPEN: 5 clocks: a book clock with no act (CVTWL 8) (the call and the shared delay's 4)
    wr=DW wid=WORD ws=SIG e                 ; DW <- SIGMA; E

; ---- immediates (V20 ALU_ACC 0004-0007, MOV r,imm): the immediate's bytes popped one a word,
; into tmpb, the ALU, the write
routine mov_ri8 op=B0-B7 book="MOV reg,imm" width=byte why="OPEN: (qprobe rule 6) MOV r8,imm8 is `. . . BNP .`: three words, then the word that waits while a fetch runs (B), releases the immediate and the next opcode (P, N) and is the E word, then the dispatch: 5; the byte is popped a word before its release (the loader's IL is loaded before the E word that writes it); two words with no act"
    open                                    ; OPEN: (qprobe rule 6) a word with no act before the immediate's release (`. . . BNP .`)
    open                                    ; OPEN: (qprobe rule 6) a word with no act before the immediate's release (`. . . BNP .`)
    pop=il                                  ; pop the immediate's (low) byte (its release is the E word's)
    wr=OPR ws=IMM e bi ro rl=1              ; the register <- the immediate; E; (qprobe) bi: waits while a fetch runs; ro rl=1: the next opcode and the immediate released

routine mov_ri16 op=B8-BF book="MOV reg,imm" width=word why="OPEN: (qprobe rule 6) MOV r16,imm16 is `. . . . BNPP .`: four words, then the word that waits while a fetch runs (B), releases both immediate bytes and the next opcode and is the E word, then the dispatch: 6; the bytes are popped on the two words before it; two words with no act"
    open                                    ; OPEN: (qprobe rule 6) a word with no act before the immediate's release (`. . . BNP .`)
    open                                    ; OPEN: (qprobe rule 6) a word with no act before the immediate's release (`. . . BNP .`)
    pop=il                                  ; pop the immediate's (low) byte (its release is the E word's)
    pop=ih                                  ; pop its high byte (its release is the E word's)
    wr=OPR ws=IMM e bi ro rl=2              ; the register <- the immediate; E; (qprobe) bi: waits while a fetch runs; ro rl=2: the next opcode and both immediate bytes released

routine alu_ai8 op=04,0C,14,1C,24,2C,34 book="ADD acc,imm" width=byte why="OPEN: (qprobe rule 14) ADD AL,imm8 is `. . . BNP .` (as MOV r8,imm8; the qprobe ld-addal runs): two words with no act, the immediate's pop, the B / release / E word with the ALU, the dispatch with the write: 5; before qprobe: book error of one, the book's 4 one short of silicon's"
    open                                    ; OPEN: (qprobe rule 14) a word with no act before the immediate's release (`. . . BNP .`)
    open                                    ; OPEN: (qprobe rule 14) a word with no act before the immediate's release (`. . . BNP .`)
    pop=il                                  ; pop the immediate's byte (its release is the E word's)
    ra=AW alu=GRP ax=RA ay=IMM wf e bi ro rl=1  ; read AL; the block's ALU op with the immediate, flags (W); E; (qprobe) bi; ro rl=1: the next opcode and the immediate released
    wr=AW ws=SIG                            ; post-E: AL <- SIGMA

routine alu_ai16 op=05,0D,15,1D,25,2D,35 book="ADD acc,imm" width=word why="OPEN: (qprobe rule 6) ADD AW,imm16 is `. . . . BNPP .` (as MOV r16,imm16): four words, the B / release / E word with the ALU, the dispatch with the write: 6; two words with no act"
    open                                    ; OPEN: (qprobe rule 6) a word with no act before the immediate's release (`. . . BNP .`)
    open                                    ; OPEN: (qprobe rule 6) a word with no act before the immediate's release (`. . . BNP .`)
    pop=il                                  ; pop the immediate's (low) byte (its release is the E word's)
    pop=ih                                  ; pop its high byte (its release is the E word's)
    ra=AW alu=GRP ax=RA ay=IMM wf e bi ro rl=2  ; read AW; the block's ALU op with the immediate, flags (W); E; (qprobe) bi; ro rl=2: the next opcode and both immediate bytes released
    wr=AW ws=SIG                            ; post-E: AW <- SIGMA

routine cmp_ai8 op=3C book="CMP acc,imm" width=byte diff=-1 why="OPEN: book error of one: the immediate's first byte popped at S+3, the next at S+4 and E on the clock after the last pop (the frozen model's takes and starts, F3-push-mov_cl_imm-k4-pE-w0: S 81, T 84, S-to-S 4 unstalled (the IMM class)): one OPEN word before the pops (the immediate's latency: the same three clocks after S in every immediate form, README MX1b), the pops, CMP on the E word: 4; the book's value against silicon's (F3-push-mov_cl_imm-k4-pE-w0: S 81, T 84, S-to-S 4 unstalled (the IMM class), the frozen model exact) one short"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    ra=AW alu=GRP ax=RA ay=IMM wf e         ; read AL; CMP with the immediate, flags (W); E

routine cmp_ai16 op=3D book="CMP acc,imm" width=word diff=-1 why="OPEN: book error of one: the immediate's first byte popped at S+3, the next at S+4 and E on the clock after the last pop (the frozen model's takes and starts, F3-push-add_aw_imm-k4-pE-w0 (the IMM class)): one OPEN word before the pops (the immediate's latency: the same three clocks after S in every immediate form, README MX1b), the pops, CMP on the E word: 5; the book's value against silicon's (F3-push-add_aw_imm-k4-pE-w0 (the IMM class), the frozen model exact) one short"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    pop=ih                                  ; pop its high byte (S+4)
    ra=AW alu=GRP ax=RA ay=IMM wf e         ; read AW; CMP with the immediate, flags (W); E

routine test_ai8 op=A8 book="TEST acc,imm" width=byte diff=-1 why="OPEN: book error of one: the immediate's first byte popped at S+3, the next at S+4 and E on the clock after the last pop (the frozen model's takes and starts, F3-push-mov_cl_imm-k4-pE-w0: S 81, T 84, S-to-S 4 unstalled (the IMM class)): one OPEN word before the pops (the immediate's latency: the same three clocks after S in every immediate form, README MX1b), the pops, the AND on the E word: 4; the book's value against silicon's (F3-push-mov_cl_imm-k4-pE-w0: S 81, T 84, S-to-S 4 unstalled (the IMM class), the frozen model exact) one short"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    ra=AW alu=AND ax=RA ay=IMM wf e         ; read AL; AND with the immediate, flags (W); E

routine test_ai16 op=A9 book="TEST acc,imm" width=word diff=-1 why="OPEN: book error of one: the immediate's first byte popped at S+3, the next at S+4 and E on the clock after the last pop (the frozen model's takes and starts, F3-push-add_aw_imm-k4-pE-w0 (the IMM class)): one OPEN word before the pops (the immediate's latency: the same three clocks after S in every immediate form, README MX1b), the pops, the AND on the E word: 5; the book's value against silicon's (F3-push-add_aw_imm-k4-pE-w0 (the IMM class), the frozen model exact) one short"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    pop=ih                                  ; pop its high byte (S+4)
    ra=AW alu=AND ax=RA ay=IMM wf e         ; read AW; AND with the immediate, flags (W); E

; ---- the 80-83 group, register form (V20 GRP1 003C-0040)
routine grp1_rb op=80,82,83 mod=reg reg=0-6 bookv=5 book="ADD reg,imm" why="OPEN: (qprobe rule 6) ADD r16,imm8 (83 /0, register) is `P . . BNP .`: the ModR/M byte released on the first word (the loader's), two words, the B / release / E word with the ALU, the dispatch with the write: 5; two words with no act"
    open                                    ; OPEN: (qprobe rule 6) a word with no act before the immediate's release (`P . . BNP .`; the ModR/M byte released here by the loader)
    open                                    ; OPEN: (qprobe rule 6) a word with no act before the immediate's release (`. . . BNP .`)
    pop=il                                  ; pop the immediate's (low) byte (its release is the E word's)
    ra=RM alu=GRP ax=RA ay=IMM wf e bi ro rl=1  ; read the register; the group's ALU op with the immediate (83: sign-extended), flags (W); E; (qprobe) bi; ro rl=1: the next opcode and the immediate released
    wr=RM ws=SIG                            ; post-E: the register <- SIGMA

routine grp1_rw op=81 mod=reg reg=0-6 book="ADD reg,imm" diff=-1 why="OPEN: book error of one: the immediate's first byte popped at S+3, the next at S+4 and E on the clock after the last pop (the frozen model's takes and starts, F3-push-add_dw_imm-k4-pE-w0: S 98, T 98 101 102): one OPEN word before the pops (the immediate's latency: the same three clocks after S in every immediate form, README MX1b), the pops, the ALU on the E word, the write after it: 5; the book's value against silicon's (F3-push-add_dw_imm-k4-pE-w0: S 98, T 98 101 102, the frozen model exact) one short"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    pop=ih                                  ; pop its high byte (S+4)
    ra=RM alu=GRP ax=RA ay=IMM wf e         ; read the register; the group's ALU op with the immediate (83: sign-extended), flags (W); E
    wr=RM ws=SIG                            ; post-E: the register <- SIGMA

routine grp1_cb op=80,82,83 mod=reg reg=7 book="CMP reg,imm" width=byte diff=-1 why="OPEN: book error of one: the immediate's first byte popped at S+3, the next at S+4 and E on the clock after the last pop (the frozen model's takes and starts, F3-push-mov_cl_imm-k4-pE-w0: S 81, T 84, S-to-S 4 unstalled (the IMM class)): one OPEN word before the pops (the immediate's latency: the same three clocks after S in every immediate form, README MX1b), the pops, CMP on the E word: 4; the book's value against silicon's (F3-push-mov_cl_imm-k4-pE-w0: S 81, T 84, S-to-S 4 unstalled (the IMM class), the frozen model exact) one short"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    ra=RM alu=GRP ax=RA ay=IMM wf e         ; read the register; CMP with the immediate (83: sign-extended), flags (W); E

routine grp1_cw op=81 mod=reg reg=7 book="CMP reg,imm" width=word diff=-1 why="OPEN: book error of one: the immediate's first byte popped at S+3, the next at S+4 and E on the clock after the last pop (the frozen model's takes and starts, F3-push-add_dw_imm-k4-pE-w0 (the IMM class)): one OPEN word before the pops (the immediate's latency: the same three clocks after S in every immediate form, README MX1b), the pops, CMP on the E word: 5; the book's value against silicon's (F3-push-add_dw_imm-k4-pE-w0 (the IMM class), the frozen model exact) one short"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    pop=ih                                  ; pop its high byte (S+4)
    ra=RM alu=GRP ax=RA ay=IMM wf e         ; read the register; CMP with the immediate (83: sign-extended), flags (W); E

; ---- the unary group, register form (V20 0174-0175): read, the operation, the write, E
routine inc_rm op=FE,FF mod=reg reg=0 book="INC reg8" why="(qprobe round 8, Q20) `P . . BN .`: read, op, write, the E word bus-idle (B: waits while a fetch's pin cycle runs) with N (measured: INC r8, the qprobe t-incb / em3-incb runs): the book's 5"
    rb=RM d1=TB s1=RB                       ; the operand read into tmpb
    alu=INC ax=TB wf                        ; +1, flags but CY (W)
    wr=RM ws=SIG                            ; the write-back
    e bi                                    ; E: pop the next opcode; (qprobe round 8, Q20) bi: the group's bus-idle fourth word (B N: waits while a fetch's pin cycle runs)

routine dec_rm op=FE,FF mod=reg reg=1 book="DEC reg8" why="(qprobe round 8, Q20) `P . . BN .`: read, op, write, the E word bus-idle (B: waits while a fetch's pin cycle runs) with N (DEC by analogy with INC r8 (not measured)): the book's 5"
    rb=RM d1=TB s1=RB                       ; the operand read into tmpb
    alu=DEC ax=TB wf                        ; -1, flags but CY (W)
    wr=RM ws=SIG                            ; the write-back
    e bi                                    ; E: pop the next opcode; (qprobe round 8, Q20) bi: the group's bus-idle fourth word (B N: waits while a fetch's pin cycle runs)

routine not_rm op=F6,F7 mod=reg reg=2 book="NOT reg" why="(qprobe round 8, Q20) `P . . BN .`: read, op, write, the E word bus-idle (B: waits while a fetch's pin cycle runs) with N (measured: NOT r16, the qprobe t-notr / em3-notr runs): the book's 5"
    rb=RM d1=TB s1=RB                       ; the operand read into tmpb
    alu=NOT ax=TB                           ; the complement (no flags)
    wr=RM ws=SIG                            ; the write-back
    e bi                                    ; E: pop the next opcode; (qprobe round 8, Q20) bi: the group's bus-idle fourth word (B N: waits while a fetch's pin cycle runs)

routine neg_rm op=F6,F7 mod=reg reg=3 book="NEG reg" why="(qprobe round 8, Q20) `P . . BN .`: read, op, write, the E word bus-idle (B: waits while a fetch's pin cycle runs) with N (NEG by analogy with NOT r (not measured)): the book's 5"
    rb=RM d1=TB s1=RB                       ; the operand read into tmpb
    alu=NEG ax=TB wf                        ; 0 - the operand, flags (W)
    wr=RM ws=SIG                            ; the write-back
    e bi                                    ; E: pop the next opcode; (qprobe round 8, Q20) bi: the group's bus-idle fourth word (B N: waits while a fetch's pin cycle runs)

routine test_rib op=F6 mod=reg reg=0-1 why="OPEN: TEST reg,imm8 (not in the book's table): one OPEN word (the immediate's latency, S+3: README MX1b), the pop, the AND on the E word"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    rb=RM alu=AND ax=RB ay=IMM wf e         ; read the register; AND with the immediate, flags (W); E

routine test_riw op=F7 mod=reg reg=0-1 why="OPEN: TEST reg,imm16: as the byte form with the second byte"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the immediate's (low) byte (S+3)
    pop=ih                                  ; pop its high byte (S+4)
    rb=RM alu=AND ax=RB ay=IMM wf e         ; read the register; AND with the immediate, flags (W); E
