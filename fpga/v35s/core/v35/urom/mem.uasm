    pop=il                                  ; pop the immediate byte (released on the datum word)
    rl=x bi alt                             ; (qprobe round 10, A4) V: the late request word (waits while a fetch runs then, not on its last clock; no REQ_PRI): the read due four clocks after it
    open call=w1                            ; OPEN: (qprobe round 10) two words with no act (the call and the shared delay's 1)
