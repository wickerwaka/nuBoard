; MX1 the memory forms (docs/v35s-mechanisms.md sections 3.3, 3.5, 3.6). A ModR/M memory
; routine (mod=mem) is entered from its EA head (ea.uasm: the displacement's pops and, ea=book,
; the book's EA clock) with its first word the EA's add: base (port A) + index (port B) + the
; displacement into the address register (the default segment: a prefix's, else SS for a BP
; mode, else DS0). The add uses both RAM read ports, and the request's address is the segment
; + the address register as a register (the add's 3-input sum into a request address in one
; tick is too long a chain: README "MX1"), so a request is posted on a word after the add.
; A load posts the read and the F word takes the datum (the odd word's pair is the bus unit's);
; a store moves the datum into OPRW and posts the write, its E held to the cycle's end with
; RAMEN = 1 (the hold); a read-modify-write posts the read, F, the ALU, the write's post, E
; held. The reservation rises on the add (the routine knows it will post; the displacement is
; popped). The shape follows the V20 routine (V20UC.TXT) where one exists, never its counts.
; Every length is the data book's formula at each path's EA (m00 3, d8 3, d16 4, dir 3) plus
; the declared difference; an OPEN word is a book clock no act names.

; ---- loads (V20 MOV_RM 004C-004D, the load direction: M -> tmpa, tmpa -> R)
routine ld diff=m00:+2,d8:+2,d16:+2,dir:+2 op=8A,8B mod=mem book="MOV reg,mem" why="OPEN: the add, the post, five clocks no act names under the cycle, F into tmpa on the clock before E (V20 MOV_RM 004C: the model's next S at S+11 whether the datum lands at S+8 or S+9, F4-push-ld_bw-k1-pE-w0), the register from tmpa on the E word at S+11 (F4-push-ld_bw-k2-pE-w0: S 92, P:read 97, S-to-S 11: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    open call=w4                            ; OPEN: 5 clocks: a clock of the model's with no act (MOV reg,mem) (the call and the shared delay's 4)
    f d1=TA s1=OPR                          ; F: the datum into tmpa (004C M -> tmpa)
    wr=REG ws=TA e                          ; the register <- tmpa (004D); E
; ---- load + ALU (V20 ALU_RM 0000-0001: M -> tmpb, R -> tmpa; ALU OPC; SIGMA -> R)
routine ld_alu diff=m00:+2,d8:+2,d16:+2,dir:+2 op=02,03,0A,0B,12,13,1A,1B,22,23,2A,2B,32,33 mod=mem book="ADD reg,mem" why="OPEN: the add, the post, five clocks no act names under the cycle, F with the register's read and the block's ALU op on the clock before E (V20 0000), the write on the E word (F5-push-add_aw_m-k2-pE-w0: S 92, P:read 97, S-to-S 11: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    open call=w4                            ; OPEN: 5 clocks: a clock of the model's with no act (ADD reg,mem) (the call and the shared delay's 4)
    f ra=REG alu=GRP ax=RA ay=OPR wf        ; F: the register and the datum; the block's ALU op, flags (W) (0000)
    wr=REG ws=SIG e                         ; the register <- SIGMA (0001); E
routine cmp_rm diff=m00:+2,d8:+2,d16:+2,dir:+2 op=3A,3B mod=mem book="CMP reg,mem" why="OPEN: ADD reg,mem's routine (five clocks no act names under the cycle, F on the clock before E), its write suppressed (F5-push-cmp_aw_m-k2-pE-w0: S-to-S 11: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    open call=w4                            ; OPEN: 5 clocks: a clock of the model's with no act (CMP reg,mem) (the call and the shared delay's 4)
    f ra=REG alu=GRP ax=RA ay=OPR wf        ; F: the register and the datum; CMP, flags (W)
    e                                       ; E: the write-back word, its write suppressed (CMP)
; ---- read-modify-write (V20 ALU_RM with the memory destination: SIGMA -> M [-06-])
routine rmw diff=m00:+1,d8:+1,d16:+1,dir:+1 op=00,01,08,09,10,11,18,19,20,21,28,29,30,31 mod=mem book="ADD mem,reg" why="OPEN: the add, the read's post, F with the ALU (0000), the write's post (0001: the write two clocks after the datum), E held to its end (RAMEN) (F5-push-add_m_aw-k2-pE-w0: S 95, P:read 100, the write 105, S-to-S 13: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f ra=REG alu=GRP ax=OPR ay=RA wf resv   ; F: the datum and the register; the ALU op, flags (W) (0000); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write (0001 SIGMA -> M)
    e                                       ; E: held until the write's end (RAMEN)

routine cmp_mr diff=m00:+2,d8:+2,d16:+2,dir:+2 op=38,39 mod=mem book="CMP mem,reg" why="OPEN: the read, five clocks no act names under the cycle, F with CMP on the clock before E (no write) (as F5-push-cmp_aw_m-k2-pE-w0: S-to-S 11: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    open call=w4                            ; OPEN: 5 clocks: a clock of the model's with no act (CMP mem,reg) (the call and the shared delay's 4)
    f ra=REG alu=GRP ax=OPR ay=RA wf        ; F: the datum and the register; CMP, flags (W)
    e                                       ; E: the write-back word, its write suppressed (CMP)
; TEST mem,reg (V20 TEST_RM 0044-0045: M -> tmpa, R -> tmpb; AND; SIGMA -> NULL)
routine test_m8 diff=m00:-1,d8:-1,d16:-1,dir:-1 op=84 mod=mem book="TEST mem,reg" width=byte why="OPEN: the read, seven clocks no act names under the cycle, F with the AND on the clock before E (F5-push-test_m_aw-k2-pE-w0: S 94, P:read 99, S-to-S 13: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    open call=w6                            ; OPEN: 7 clocks: a clock of the model's with no act (TEST mem,reg) (the call and the shared delay's 6)
    f ra=REG alu=AND ax=OPR ay=RA wf        ; F: the datum and the register; AND, flags (W) (0044)
    e                                       ; E (TEST writes nothing)
routine test_m16 op=85 mod=mem book="TEST mem,reg" width=word why="OPEN: the read, seven clocks no act names under the cycle, F with the AND on the clock before E (F5-push-test_m_aw-k2-pE-w0: S 94, P:read 99, S-to-S 13: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    open call=w6                            ; OPEN: 7 clocks: a clock of the model's with no act (TEST mem,reg) (the call and the shared delay's 6)
    f ra=REG alu=AND ax=OPR ay=RA wf        ; F: the datum and the register; AND, flags (W) (0044)
    e                                       ; E (TEST writes nothing)
; XCH mem,reg (V20 XCHG_RM 0048-004A: M -> tmpa, R -> tmpb; tmpa -> R [-06-]; tmpb -> M)
routine xch_m diff=m00:+2,d8:+2,d16:+2,dir:+2 op=86,87 mod=mem book="XCH mem,reg" why="OPEN: the read, F: the register into the write datum and the datum into the register (0048-0049), three clocks no act names, the write's post (004A), E held (F5-push-xch_m_aw-k2-pE-w0: S 96, P:read 101, the write 108, S-to-S 15: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f ra=REG d1=OPRW s1=RA wr=REG ws=OPR resv   ; F: the register into the write datum (0048), the datum into the register (0049); the reservation
    open call=w2                            ; OPEN: 3 clocks: a clock of the model's with no act (XCH mem,reg) (the call and the shared delay's 2)
    bus=MEMW                                ; post the write (004A tmpb -> M)
    e                                       ; E: held until the write's end (RAMEN)

; ---- stores (V20 MOV_RM 004C-004D, the store direction: R -> tmpa, tmpa -> M; the operand
; pre-read suppressed, pla_3 MODRM_STORE)
routine st diff=m00:+1,d8:+1,d16:+1,dir:+1 op=88,89 mod=mem book="MOV mem,reg" why="OPEN: the add, the register's read with the post (S+4: the write at S+5), E held to the write's end (F5-push-st_bw-k2-pE-w0: S 90, the write 95, S-to-S 8: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    ra=REG d1=OPRW s1=RA bus=MEMW           ; the register into the write datum (004C); post the write (004D)
    e                                       ; E: held until the write's end (RAMEN)

; MOV mem,imm (C6 / C7 /0): the immediate popped after the EA (the V20's routine pops it after
; the loader's EA), into the write datum, the post
routine st_imm8 diff=m00:-1,dir:+1 op=C6 mod=mem reg=0,1,2,3,4,5,6,7 ea=bare book="MOV mem,imm" width=byte why="the add, the immediate's pop, the datum with the post, E held to the write's end: its acts fill the book's EA clocks (ea=bare). A book error of one at mod 00: the book's EA + 6 for both widths against the byte form's write a clock before the word's on silicon (v35s-chains.md F19: C6 07 and 83 /7 one clock earlier than C7 07), the word's 10 (a6 MOV word [BW],0x1234) less the dispatch's fetch stall 9: the byte 8; the direct form +1: the two pops the book's EA 3 does not resolve"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate byte
    d1=OPRW s1=IMM bus=MEMW                 ; the immediate into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine st_imm16 diff=d8:+1,d16:+1,dir:+2 op=C7 mod=mem reg=0,1,2,3,4,5,6,7 ea=bare book="MOV mem,imm" width=word why="the add, the immediate's two pops, the datum with the post, E held to the write's end: the book's EA + 6 at mod 00 (silicon's 10: a6 MOV word [BW],0x1234); the displacement's pops the book's EA does not resolve: d8 +1, d16 +1, the direct form +2 (no OPEN word: ea=bare)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate's low byte
    pop=ih                                  ; pop its high byte
    d1=OPRW s1=IMM bus=MEMW                 ; the immediate into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

; MOV mem16,sreg / MOV sreg,mem16 (V20 MOV_SREG 0050: R -> M [-06-] [E])
routine st_sr op=8C mod=mem book="MOV mem16,sreg" why="the add, the segment register's read with the post, E held to the write's end: the book's EA + 6"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    rb=SREG wid=WORD d1=OPRW s1=RB bus=MEMW ; the segment register into the write datum; post the write (a word)
    e                                       ; E: held until the write's end (RAMEN)

routine ld_sr diff=m00:-1,d8:-1,d16:-1,dir:-1 op=8E mod=mem book="MOV sreg,mem16" why="OPEN: book error of one: the book's EA + 9 against silicon's MOV DS1,[BW] 11 (a6, docs/v35s-mechanisms/classes.md LOAD_SEG) less the dispatch's fetch stall its method puts under the marker: 10 at mod 00 with the head's book error; the add, the post, the cycle, F: the segment register from the datum on the E word; two book clocks with no act before the post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    open                                    ; OPEN: a book clock with no act (MOV sreg,mem16 EA + 9)
    open                                    ; OPEN: a book clock with no act (MOV sreg,mem16 EA + 9)
    bus=MEMR wid=WORD                       ; post the read (a word)
    f wr=SREG wid=WORD ws=OPR e nb          ; F: the segment register <- the datum (RAM and the segment flop); E; (F3) nb: no interrupt or single step at the next instruction's start (f3_step)

; LDS / LES (V20 LES 00F8-00FA: OPR -> R, SIGMA -> tmpb, ALU INC2 [F]; SIGMA -> IND, MEMR;
; OPR -> ES [FE]): the offset word, the address + 2, the segment word
routine les op=C4 mod=mem book="MOV DS0/DS1,reg16,memptr32" why="OPEN: the add, the offset's read, the address + 2 under the cycle, F: the register and the address register (00F8), the segment's read (00F9), F: DS1 on the E word (00FA): the book's EA + 17 with six book clocks with no act before the first post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    open call=w5                            ; OPEN: 6 clocks: a book clock with no act (LES EA + 17) (the call and the shared delay's 5)
    bus=MEMR wid=WORD                       ; post the offset's read (a word)
    alu=INC2 ax=ADDR resv                   ; the address + 2 into SIGMA (00F8 ALU INC2); the reservation (the second read)
    f wr=REG wid=WORD ws=OPR d1=ADDR s1=SIG ; F: the register <- the offset (00F8 OPR -> R); the address register <- the address + 2
    bus=MEMR wid=WORD                       ; post the segment's read (00F9 SIGMA -> IND; MEMR)
    f wr=DS1 wid=WORD ws=OPR e              ; F: DS1 <- the segment (00FA OPR -> ES); E

routine lds op=C5 mod=mem book="MOV DS0/DS1,reg16,memptr32" why="OPEN: LES's routine with DS0 (V20 LDS 00FC-00FE): the book's EA + 17 with six book clocks with no act before the first post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    open call=w5                            ; OPEN: 6 clocks: a book clock with no act (LDS EA + 17) (the call and the shared delay's 5)
    bus=MEMR wid=WORD                       ; post the offset's read (a word)
    alu=INC2 ax=ADDR resv                   ; the address + 2 into SIGMA; the reservation (the second read)
    f wr=REG wid=WORD ws=OPR d1=ADDR s1=SIG ; F: the register <- the offset; the address register <- the address + 2
    bus=MEMR wid=WORD                       ; post the segment's read
    f wr=DS0 wid=WORD ws=OPR e              ; F: DS0 <- the segment; E

; LDEA (V20 LEA 0054-0055: the EA, then SIGMA -> R after the E row)
routine ldea op=8D mod=mem book="LDEA" why="the add, the register from the address register on the E word: the book's EA + 2 on every path but mod 00's EA book error (the head)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    wr=REG wid=WORD ws=ADDR e               ; the register <- the address (0055 SIGMA -> R); E

; ---- the group 1 memory forms (V20 GRP1 003C-0040: Q -> tmpbL, Q -> tmpbH, tmpb -> tmpa; ALU
; OPC; M -> tmpb; SIGMA -> M [-06-]): the immediate popped after the EA, then the read (silicon:
; the one-byte immediate's read a clock before the two-byte one's, v35s-chains.md F19), F with
; the group's op, the write's post, E held
routine grp1_mb diff=m00:+1,d8:+1,d16:+1,dir:+1 op=80,82 mod=mem reg=0-6 bookv=14 book="ADD mem,imm" why="OPEN: the add, the read, F with the immediate's pops after the datum (the model's takes), the group's op, the write's post, E held (F5-push-add_m_imm-k2-pE-w0: S 96, P:read 101, the immediate taken at S+8 S+9, P:write 106, the write 108, S-to-S 15: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f d1=TB s1=OPR pop=il resv              ; F: the datum into tmpb; pop the immediate's (low) byte (S+8); the reservation
    alu=GRP ax=TB ay=IMM wf                 ; the group's ALU op with the immediate, flags (W) (003E)
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write (0040)
    e                                       ; E: held until the write's end (RAMEN)

