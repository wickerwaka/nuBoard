; MX1 the memory forms (docs/v35s-mechanisms.md sections 3.3, 3.5, 3.6). A ModR/M memory
; routine (mod=mem) is entered from its EA head (ea.uasm: the displacement's pops and, ea=book,
; the book's EA clock) with its first word the EA's add: base (port A) + index (port B) + the
; displacement into the address register (the default segment: a prefix's, else SS for a BP
; mode, else DS0). The add uses both RAM read ports, and the request's address is the segment
; + the address register as a register (the add's 3-input sum into a request address in one
; tick is too long a chain: README "MX1"), so a request is posted on a word after the add.
; A load posts the read and the F word takes the datum (the odd word's pair is the bus unit's);
; a store moves the datum into OPRW and posts the write, its E held to the cycle's end with
; RAMEN = 1 (the hold); a read-modify-write posts the read, F, the ALU, the write's post, E
; held. The reservation rises on the add (the routine knows it will post; the displacement is
; popped). The shape follows the V20 routine (V20UC.TXT) where one exists, never its counts.
; Every length is the data book's formula at each path's EA (m00 3, d8 3, d16 4, dir 3) plus
; the declared difference; an OPEN word is a book clock no act names.

; ---- loads (V20 MOV_RM 004C-004D, the load direction: M -> tmpa, tmpa -> R)
routine ld diff=d16:-1 op=8A,8B mod=mem ea=q book="MOV reg,mem" why="book error of one at mod 10 (the book's EA 4; the qprobe ld16 runs: MOV AW,[BW+d16] in the four words of every mode); OPEN: (qprobe round 6) MOV r,mem is `P Y . DN .`, `P Y . P DN .`, `P Y . PP DN .` (the qprobe lbw, lbi, ld8, ld16, ldir runs; model_m.py L_*): the measured heads (ea=q, ea.uasm: the ModR/M byte released on word 1, the request word Y on word 2, the add on word 3, the displacement released on word 4), the read's post on word 5 (Y + 3), D: F with the register's write and N, the boundary; book error where the routine is shorter, silicon longer than the book where it is longer"
    bus=MEMR                                ; post the read (Y + 3: granted on Y + 4, or later)
    f wr=REG ws=OPR e ro                    ; D: F: the register <- the datum (004C-004D); E; N
; ---- load + ALU (V20 ALU_RM 0000-0001: M -> tmpb, R -> tmpa; ALU OPC; SIGMA -> R)
routine ld_alu op=02,03,0A,0B,12,13,1A,1B,22,23,2A,2B,32,33 mod=mem ea=q book="ADD reg,mem" diff=d16:-1 why="(qprobe round 8, Q19) ADD AW,[BW] is the load, `P Y . DN .` (the qprobe rw-addm runs, 12 / 12 in the model): the measured heads (ea=q: the request word on word 2, the add, the displacement released on word 4), the read's post (Y + 3), D N (F: the register and the datum, the block's ALU op, flags, E), the write after it; the other ALU ops and EA modes by analogy (measured: ADD AW,[BW]); book error of one at mod 10 (the heads' EA, as MOV r,mem); before round 8: the add, the post, five clocks no act names, F, the write on the E word (F5-push-add_aw_m-k2-pE-w0)"
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=GRP ax=RA ay=OPR wf e      ; D: F: the register and the datum; the block's ALU op, flags (W) (0000); E; N
    wr=REG ws=SIG                           ; post-E: the register <- SIGMA (0001)
routine cmp_rm op=3A,3B mod=mem ea=q book="CMP reg,mem" diff=d16:-1 why="(qprobe round 8, Q19) CMP AW,[BW] is the load, `P Y . DN .` (the qprobe rw-cmpm runs, 12 / 12 in the model): the measured heads (ea=q), the read's post (Y + 3), D N (F: CMP, flags, E); the byte form and the other EA modes by analogy; book error of one at mod 10 (the heads' EA); before round 8: ADD reg,mem's routine with its write suppressed (F5-push-cmp_aw_m-k2-pE-w0)"
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=GRP ax=RA ay=OPR wf e      ; D: F: the register and the datum; CMP, flags (W); E; N

; ---- read-modify-write (V20 ALU_RM with the memory destination: SIGMA -> M [-06-])
routine rmw diff=m00:+2,d8:+2,d16:+1,dir:+2 op=00,01,08,09,10,11,18,19,20,21,28,29,30,31 mod=mem ea=q book="ADD mem,reg" why="(qprobe round 21, spec 17 B1, Q98) one routine for the whole write-back ALU group on memory, byte and word: OR / AND / SUB / XOR / ADC / SBB [BW],r16 and ADD / OR / SUB [BW],r8 run ADD [BW],r16's routine (the qprobe r21f orw / andw / subw / xorw / adcw / sbbw / addb / orb / subb runs, 66 / 66 each); AND / XOR / ADC / SBB byte by analogy; the round-6 routine of the other ALU ops and the byte form retired. OPEN: silicon longer than the book (measured, the qprobe shapes below; the extra words OPEN): (qprobe round 8, Q19) ADD [BW],AW is `P Y . . DZ N` and ADD [BW+d8],AW `P Y . P DZ N` (the qprobe rw-add / rw-add8 / rmw runs): the read as a load (the measured heads, ea=q: the request word on word 2), D (F: the datum and the register, the ALU op, flags), the write's post on the word after it (Z: the write two clocks after the datum word: the address is already the bus unit's, the second request skips the two clocks a first one spends handing it over), E (an on-chip store holds it to the write's end: RAMEN), N on the boundary word (the model's: released when the dispatch executes, on the write's last clock: rule 7, E_PEND). Measured: [BW] and [BW+d8] with a register source (op 01); the other EA modes by analogy (Q18's rule: the heads; they share the routine); the byte form and the other ALU ops keep the round-6 routine (rmw_b); beyond the book in the book check's machine (E held to the write's end: the on-chip timing; the heads' request word); before round 8: the add, the read's post (S+4), F, the write's post, E held (F5-push-add_m_aw-k2-pE-w0)"
    bus=MEMR                                ; post the read (Y + 3)
    f ee ra=REG alu=GRP ax=OPR ay=RA wf        ; D: F: the datum and the register; the ALU op, flags (W) (0000) ; ee (WO46): the early end (RAMEN 0: this word is E, the next word the dispatch)
    d1=OPRW s1=SIG bus=MEMW                 ; Z: the result into the write datum; post the write (0001 SIGMA -> M: the write two clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock; an on-chip store holds it to the write's end (RAMEN)

routine cmp_mr op=38,39 mod=mem ea=q book="CMP mem,reg" diff=m00:+2,d8:+2,d16:+1,dir:+2 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 15, spec 11 B) CMP mem,reg is `P Y . D . N .` (the qprobe cmpmr / cmpmr8 runs, 48 / 48 in the model): the measured heads (ea=q), the read (Y + 3), D (F with CMP), a word, E with N; OPEN: the read, five clocks no act names under the cycle, F with CMP on the clock before E (no write) (as F5-push-cmp_aw_m-k2-pE-w0: S-to-S 11: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    bus=MEMR                                ; post the read (Y + 3)
    f ee ra=REG alu=GRP ax=OPR ay=RA wf        ; D: F: the datum and the register; CMP, flags (W) ; ee (WO46): the early end (RAMEN 0: this word is E, the next word the dispatch)
    open                                    ; OPEN: (qprobe round 15) a word with no act
    e ro                                    ; E: the write suppressed (CMP); N
; TEST mem,reg (V20 TEST_RM 0044-0045: M -> tmpa, R -> tmpb; AND; SIGMA -> NULL)
routine test_m8 diff=m00:-3,d8:-2,d16:-2,dir:-1 op=84 mod=mem ea=bare book="TEST mem,reg" width=byte why="OPEN: book error where the routine is shorter (silicon's measured shape below): (qprobe round 9, Q25) TEST [BW],AW is `P . B Y DN .` (the qprobe testm runs, 24 / 24 in the model): TEST r,r's bus-idle third word, then a load: the add (the ModR/M byte released by the loader), a word with no act, B (bus-idle: waits while a fetch's pin cycle runs), Y (the request word: the read due four clocks after it, posted three words later), two words with no act, the read's post (Y + 3), D N (F: AND, flags; E); measured: the word form at [BW]; the byte form and the displacement modes (the bare heads' pops before the add) by analogy; before round 9: the read, seven clocks no act names under the cycle, F with the AND on the clock before E (F5-push-test_m_aw-k2-pE-w0)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bi                                      ; (qprobe round 9, Q25) B: TEST's bus-idle third word (waits while a fetch's pin cycle runs)
    rl=x bi                                 ; (qprobe round 9) Y: the request word (the read due four clocks after it, posted three words later)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=AND ax=OPR ay=RA wf e ro   ; D N: F: the datum and the register; AND, flags (W) (0044); E (TEST writes nothing); N
routine test_m16 diff=m00:-2,d8:-1 op=85 mod=mem ea=bare paths=m00,d8 book="TEST mem,reg" width=word why="OPEN: book error where the routine is shorter (silicon's measured shape below): (qprobe round 9, Q25) TEST [BW],AW is `P . B Y DN .` (the qprobe testm runs, 24 / 24 in the model): TEST r,r's bus-idle third word, then a load: the add (the ModR/M byte released by the loader), a word with no act, B (bus-idle: waits while a fetch's pin cycle runs), Y (the request word: the read due four clocks after it, posted three words later), two words with no act, the read's post (Y + 3), D N (F: AND, flags; E); measured: the word form at [BW]; the byte form and the displacement modes (the bare heads' pops before the add) by analogy; before round 9: the read, seven clocks no act names under the cycle, F with the AND on the clock before E (F5-push-test_m_aw-k2-pE-w0)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bi                                      ; (qprobe round 9, Q25) B: TEST's bus-idle third word (waits while a fetch's pin cycle runs)
    rl=x bi                                 ; (qprobe round 9) Y: the request word (the read due four clocks after it, posted three words later)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=AND ax=OPR ay=RA wf e ro   ; D N: F: the datum and the register; AND, flags (W) (0044); E (TEST writes nothing); N
; XCH mem,reg (V20 XCHG_RM 0048-004A: M -> tmpa, R -> tmpb; tmpa -> R [-06-]; tmpb -> M)
routine xch_m diff=m00:+2,d8:+2,d16:+1,dir:+2 op=86,87 mod=mem ea=q book="XCH mem,reg" why="OPEN: silicon longer than the book (measured; the extra words OPEN): (qprobe round 9, Q25) XCH [BW],AW is `P Y . . D . Z G N .` (the qprobe xchm runs, 24 / 24 in the model): the read as a load (the measured heads, ea=q: the request word on word 2), the read's post (Y + 3), D (F: the register into the write datum, the datum into the register, 0048-0049), two words with no act, Z (the write's post: the write four clocks after the datum word, ADD [BW],r's two later), E with N (G N: a bus-idle word, it waits while a fetch's pin cycle runs: the posted write wins the bus on the first clock no fetch runs, so N is released on the write's first clock; an on-chip store holds it to the write's end: RAMEN); measured: the word form at [BW]; the byte form and the other EA modes by analogy (the heads); before round 9: the read, F, three clocks no act names, the write's post, E held (F5-push-xch_m_aw-k2-pE-w0)"
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG d1=OPRW s1=RA wr=REG ws=OPR    ; D: F: the register into the write datum (0048), the datum into the register (0049)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bi ee                                   ; (qprobe round 22, spec 18 B, Q102) B Z: the word in front of the write's post is bus-idle (XCH [BW],r `P Y . . D . BZ G N .`, [d16],r `P Y . PP2 D . BZ G N .`; the other modes by the heads); ee (WO46): the early end on a bus-idle word (RAMEN 0: this word is E, keeping its wait; the post word the dispatch)
    bus=MEMW                                ; Z: post the write (004A tmpb -> M: four clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock; an on-chip store holds it to the write's end (RAMEN)

; ---- stores (V20 MOV_RM 004C-004D, the store direction: R -> tmpa, tmpa -> M; the operand
; pre-read suppressed, pla_3 MODRM_STORE)
; (WO46, the core README "WO46") MOV mem,reg carries the measured heads' words itself (eaq0 / eaq8 / eaq16 /
; eaq16x, word for word: the same clocks, pops and releases at RAMEN 1) instead of calling them, so that the head's
; last word can carry the early end (ee): with RAMEN 0 it is the E word and the post word the dispatch (the heads
; are shared with the loads, whose end does not move). st carries the mod 00 cells but the direct address
; (st_mdir) and the book's row at [BW]; st_d8, st_d16, st_d16x, st_mdir the other modes
routine st diff=2 op=88,89 mod=m00 rm=0-5,7 book="MOV mem,reg" why="OPEN: (WO46) the head's words in the routine (eaq0's: word 1 with no act, the ModR/M byte released by the loader); beyond the book: a named act, the request word (Y) and the post on words of their own (the qprobe sbw, sd8, sdir runs); beyond the book by two at EA 3 and one at mod 10 in the book check's machine (E held to the write's end: the on-chip timing, the post and E on words of their own); OPEN: (qprobe round 6) MOV mem,r is `P Y . N`, `P Y . P N`, `P Y . PP N` (the qprobe sbw, sd8, sdir runs; model_m.py S_*): the measured heads (ea=q), the register's read with the post on word 5 (Y + 3), E, the boundary with N (the model's last word) on the write's last clock (rule 7, E_PEND); book error where the routine is shorter, silicon longer than the book where it is longer; (WO46, the RAMEN design study, f5_ws / f5_wt / f5_wu / f5_wv) with RAMEN 0 the end rides on the head's last word (E) and the post word (the dispatch): S' on the write's first clock"
    open                                    ; OPEN: (qprobe round 6) word 1, the ModR/M byte released (mra) (eaq0's)
    rl=x bi                                 ; Y: the request word
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    ee                                      ; ee (WO46): the early end: with RAMEN 0 this word is E (the next opcode popped and released), the post word the dispatch
st_p: ra=REG d1=OPRW s1=RA bus=MEMW         ; the register into the write datum (004C); post the write (004D); with RAMEN 0 the dispatch word
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock (RAMEN 1; with RAMEN 0 not reached)
routine st_d8 op=88,89 mod=m01 why="(WO46) MOV mem,reg with d8: eaq8's words (`P Y . P N`: the qprobe sd8 runs), then st's post; the early end on the head's last word (RAMEN 0)"
    pop=dl                                  ; the ModR/M byte released (mra); pop the displacement byte
    rl=x bi                                 ; Y: the request word
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    rl=1 ee jmp=st_p                        ; the displacement released; ee (WO46): the early end
routine st_d16 op=88,89 mod=m10 rm=4-7 why="(WO46) MOV mem,reg with one register + d16: eaq16's words (`P Y . PP N`), then st's post; the early end on the head's last word (RAMEN 0)"
    pop=dl                                  ; the ModR/M byte released (mra); pop the displacement's low byte
    pop=dh rl=x bi                          ; Y: the request word; pop its high byte
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    rl=2 ee jmp=st_p                        ; both displacement bytes released; ee (WO46): the early end
routine st_d16x op=88,89 mod=m10 rm=0-3 why="(WO46) MOV mem,reg with base + index + d16: eaq16x's words (qprobe round 10, Q18: the request word on word 3), then st's post; the early end on the head's last word (RAMEN 0)"
    pop=dl                                  ; the ModR/M byte released (mra); pop the displacement's low byte
    pop=dh                                  ; pop its high byte
    rl=x bi                                 ; Y: the request word (the third word)
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    rl=2 ee jmp=st_p                        ; both displacement bytes released; ee (WO46): the early end
routine st_mdir op=88,89 mod=m00 rm=6 why="(WO46) MOV [d16],reg by ModR/M: eaq16's words (`P Y . PP N`: the qprobe sdir runs), then st's post; the early end on the head's last word (RAMEN 0)"
    pop=dl                                  ; the ModR/M byte released (mra); pop the direct address's low byte
    pop=dh rl=x bi                          ; Y: the request word; pop its high byte
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    rl=2 ee jmp=st_p                        ; both address bytes released; ee (WO46): the early end

; MOV mem,imm (C6 / C7 /0): the immediate popped after the EA (the V20's routine pops it after
; the loader's EA), into the write datum, the post
routine st_imm8 diff=m00:+2,d16:+3 op=C6 mod=mem paths=m00,d16 reg=0,1,2,3,4,5,6,7 ea=bare book="MOV mem,imm" width=byte why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 11, Q33) MOV mem8,imm8 is `P . V . . . KPN .` (the qprobe w-* / stib runs): the add (P), the immediate's pop (released at K), V (the late request word: the write due four clocks after it), two words with no act, the immediate into the write datum with the write's post, E: K P N (the immediate released, the next opcode); the displacement modes by analogy (the bare heads); A2's unarmed write (the chained fetch first while the datum is not taken) not built"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P); the reservation
    pop=il                                  ; pop the immediate byte (released on E)
    rl=x bi alt                             ; (qprobe round 11, Q33) V: the late request word (the write due four clocks after it)
    open call=w1                            ; OPEN: (qprobe round 11) two words with no act (the call and the shared delay's 1)
    d1=OPRW s1=IMM bus=MEMWD                ; (qprobe round 12, spec 7 A2) the immediate into the write datum; post the write (V + 3), not armed (MEMWD: it competes from K on)
    d1=OPRW s1=IMM e ro rl=1                ; E: K P N: the immediate into the write datum (the write armed: K), the immediate and the next opcode released (the write's first clock); held until the write's end (RAMEN)

; (WO45) MOV byte [m+d8],imm8 (C6 mod 01): the routine pops its own displacement, as the word form's
; st_imm16_d8 (C7 mod 01): no EA head, the d8 form as long as the m00 form
routine st_imm8_d8 op=C6 mod=m01 reg=0,1,2,3,4,5,6,7 width=byte why="OPEN: silicon longer than the book (measured, the extra words OPEN): (WO45, the wstore3 set f5_wu_i_r1 b8, 8 of 8 windows at four leads and both alignments) MOV byte [IX+d8],imm8 writes on S + 6 as MOV byte [IX],imm8 does (the d8 head's word cost a clock: the write on S + 7), and a fetch the displacement's release allows starts on S + 3 (al 1: f1D0 at S + 3, the write back to back behind it on S + 6; the head released the byte on S, the fetch started there): the word form's d8 shape (st_imm16_d8, qprobe rounds 14-16: the displacement popped by the routine on its first word and released on S + 3, the m00 form's length) on the byte routine's words: the displacement's pop (the ModR/M byte released by the loader: P), the add, V on S + 2 as in the m00 form (the write due four clocks after it), the displacement's release with the immediate's pop on S + 3, a word with no act, the unarmed post, E: K P N"
    pop=dl                                  ; pop the displacement byte (the ModR/M byte released by the loader: P)
    ea=BI ra=BASE rb=INDEX                  ; the EA's add; the reservation
    rl=x bi alt                             ; V: the late request word (the write due four clocks after it), S + 2 as the m00 form's
    pop=il rl=1                             ; P: the displacement released (S + 3); pop the immediate byte (released on E)
    open                                    ; OPEN: a word with no act (the m00 form's second word behind V)
    d1=OPRW s1=IMM bus=MEMWD                ; the immediate into the write datum; post the write (V + 3), not armed (MEMWD: it competes from K on)
    d1=OPRW s1=IMM e ro rl=1                ; E: K P N: the immediate into the write datum (the write armed: K), the immediate and the next opcode released (the write's first clock); held until the write's end (RAMEN)

; (WO42) MOV byte [d16],imm8 (C6 06): the ModR/M direct store's sequence (st through eaq16)
routine st_imm8_dir op=C6 mod=m00 rm=6 reg=0,1,2,3,4,5,6,7 width=byte why="(WO42, the pace2 set f5_pj, 102 windows at 0 to 2 waits, two sessions) MOV byte [d16],imm8 is MOV [d16],reg by ModR/M (st through eaq16, `P Y . PP N`) cycle for cycle up to its write: the direct address's two pops, Y on the second, the address, both address bytes released on S + 3 (a fetch starts there or is chained behind one running from S), the immediate into the write datum with the write's post on S + 4 (the write due on S + 6 at the earliest, behind that fetch), E with the immediate's and the next opcode's release on the write's first clock (silicon: a fetch follows the write back to back); before: the m00 routine behind the ead head (the address popped at once, V late), 2 or 3 clocks late at no waits"
    pop=dl                                  ; the ModR/M byte released (mra); pop the direct address's low byte
    pop=dh rl=x bi                          ; Y: the request word (the write due four clocks after it); pop its high byte
    ea=DISP                                 ; the address register <- the direct address
    pop=il rl=2                             ; PP: both address bytes released (S + 3); pop the immediate byte (released on E)
    d1=OPRW s1=IMM bus=MEMW                 ; the immediate into the write datum; post the write (S + 4)
    e ro bi rl=1                            ; E: G K N: the immediate and the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); held until the write's end (RAMEN)

routine st_imm16z diff=m00:3 op=C7 mod=mem paths=m00 reg=0,1,2,3,4,5,6,7 ea=bare book="MOV mem,imm" width=word why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 9, Q25, item C) MOV word [BW],imm16 and [BW+IX],imm16 are `P . . BY . . . PPN .` (the qprobe rw-movi / stibi runs; model_m.py STIM): the add (the ModR/M byte released by the loader), two words with no act, BY (bus-idle: waits while a fetch's pin cycle runs; it is the request word too: the write due four clocks after it), the immediate's two pops, the datum with the post (Y + 3), E with the immediate's two bytes and the next opcode released (PPN, on the write's first clock: the post's grant); the immediate's pops before their release (the boundary waited for three bytes behind C7: m3); the modes without a displacement only (mod 00 but the direct address): the displacement modes and the byte form are not read (st_imm16, st_imm8), so C7's entry depends on the whole ModR/M byte (a whole opcode of the split second-level decode)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P); the reservation
    open                                    ; OPEN: (qprobe round 9) a word with no act
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bi                                      ; (qprobe round 9) BY: bus-idle (waits while a fetch's pin cycle runs, its last clock included: so never on a fetch's last clock, where a request word's REQ_PRI would act); the write due four clocks after it
c7_i: pop=il                                  ; pop the immediate's low byte (released on E)
    pop=ih                                  ; pop its high byte (released on E)
    d1=OPRW s1=IMM bus=MEMWD                ; (qprobe round 12, spec 7 A2) the immediate into the write datum; post the write (Y + 3), not armed (MEMWD: it competes from K on)
    d1=OPRW s1=IMM e ro rl=2                ; E: K P P2 N: the immediate into the write datum (the write armed: K), its two bytes and the next opcode released (the write's first clock); held until the write's end (RAMEN)

; MOV mem16,sreg / MOV sreg,mem16 (V20 MOV_SREG 0050: R -> M [-06-] [E])
routine st_sr op=8C mod=mem ea=bare book="MOV mem16,sreg" diff=m00:+2,d8:+3,d16:+3,dir:+4 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 14, spec 10 B) MOV mem,sreg is `P . V . G N .` (the qprobe movms runs, [BW]; the other modes behind the bare heads): the add (P), a word, V (the late request word), the register into the datum, a word, the post (V + 3), E G N; the add, the segment register's read with the post, E held to the write's end: the book's EA + 6"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 14) a word with no act
    rl=x bi alt                             ; (qprobe round 14) V: the late request word (the write due four clocks after it)
    rb=SREG wid=WORD d1=OPRW s1=RB          ; the segment register into the write datum
    ee                                      ; ee (WO46): the early end: with RAMEN 0 this word is E, the word after it the dispatch 
    bus=MEMW wid=WORD                       ; post the write (V + 3: a word)
    e ro bi                                 ; E: G N (bus-idle); an on-chip store holds it to the write's end (RAMEN)

routine ld_sr op=8E mod=mem ea=q book="MOV sreg,mem16" diff=m00:-1,d8:-1,d16:-2,dir:-1 why="OPEN: book error where the measured routine is shorter than the book: (qprobe round 14, spec 10 B) MOV sreg,mem is `P Y . DN . .` with MOV sreg's lead of two (the qprobe movsm runs, [BW]): the heads (ea=q), the read (Y + 3), D N (the segment register from the datum, the next opcode released), a word, E; OPEN: book error of one: the book's EA + 9 against silicon's MOV DS1,[BW] 11 (a6, docs/v35s-mechanisms/classes.md LOAD_SEG) less the dispatch's fetch stall its method puts under the marker: 10 at mod 00 with the head's book error; the add, the post, the cycle, F: the segment register from the datum on the E word; two book clocks with no act before the post"
    bus=MEMR wid=WORD                       ; post the read (Y + 3: a word)
    f wr=SREG wid=WORD ws=OPR ro            ; D N: F: the segment register <- the datum (RAM and the segment flop); the next opcode released
    e nb                                    ; E; (F3) nb: no interrupt or single step at the next instruction's start (f3_step)

; LDS / LES (V20 LES 00F8-00FA: OPR -> R, SIGMA -> tmpb, ALU INC2 [F]; SIGMA -> IND, MEMR;
; OPR -> ES [FE]): the offset word, the address + 2, the segment word
routine les op=C4 mod=mem ea=q book="MOV DS0/DS1,reg16,memptr32" diff=m00:0,d8:0,d16:-1,dir:0 why="OPEN: book error where the measured routine is shorter than the book: (qprobe round 14, spec 10 B) LDS / LES r,mem is `P Y . D . U . D . . N .` (the qprobe lds / les runs, [BW]; the other modes by the measured heads): the heads (ea=q), the offset's read (Y + 3), D, a word, U (the segment's read posted), a word, D, two words, E with N; OPEN: the add, the offset's read, the address + 2 under the cycle, F: the register and the address register (00F8), the segment's read (00F9), F: DS1 on the E word (00FA): the book's EA + 17 with six book clocks with no act before the first post"
    bus=MEMR wid=WORD                       ; post the offset's read (Y + 3: a word)
    alu=INC2 ax=ADDR                        ; the address + 2 into SIGMA; the reservation (the second read)
    f wr=REG wid=WORD ws=OPR d1=ADDR s1=SIG ; D: F: the register <- the offset; the address register <- the address + 2
    open call=w1                            ; OPEN: (qprobe round 14) two words with no act (the call and the shared delay's 1: the model's U is the post's word less one)
    bus=MEMR wid=WORD                       ; U: post the segment's read
    open                                    ; OPEN: (qprobe round 14) a word with no act
    f wr=DS1 wid=WORD ws=OPR              ; D: F: DS1 <- the segment
    open call=w1                            ; OPEN: (qprobe round 14) two words with no act (the call and the shared delay's 1)
    e ro                                    ; E; N

routine lds op=C5 mod=mem ea=q book="MOV DS0/DS1,reg16,memptr32" diff=m00:0,d8:0,d16:-1,dir:0 why="OPEN: book error where the measured routine is shorter than the book: (qprobe round 14, spec 10 B) LDS / LES r,mem is `P Y . D . U . D . . N .` (the qprobe lds / les runs, [BW]; the other modes by the measured heads): the heads (ea=q), the offset's read (Y + 3), D, a word, U (the segment's read posted), a word, D, two words, E with N; OPEN: LES's routine with DS0 (V20 LDS 00FC-00FE): the book's EA + 17 with six book clocks with no act before the first post"
    bus=MEMR wid=WORD                       ; post the offset's read (Y + 3: a word)
    alu=INC2 ax=ADDR                        ; the address + 2 into SIGMA; the reservation (the second read)
    f wr=REG wid=WORD ws=OPR d1=ADDR s1=SIG ; D: F: the register <- the offset; the address register <- the address + 2
    open call=w1                            ; OPEN: (qprobe round 14) two words with no act (the call and the shared delay's 1: the model's U is the post's word less one)
    bus=MEMR wid=WORD                       ; U: post the segment's read
    open                                    ; OPEN: (qprobe round 14) a word with no act
    f wr=DS0 wid=WORD ws=OPR              ; D: F: DS0 <- the segment
    open call=w1                            ; OPEN: (qprobe round 14) two words with no act (the call and the shared delay's 1)
    e ro                                    ; E; N

; LDEA (V20 LEA 0054-0055: the EA, then SIGMA -> R after the E row)
routine ldea op=8D mod=mem paths=m00 book="LDEA" diff=1 why="OPEN: silicon longer than the book (measured, the extra word OPEN): (qprobe round 16, spec 12 C2; round 17, Q68) LEA without a displacement ([reg], [base+index]) is `P . . BN .` (the qprobe ld-lea and QPr17a bw / bwix / bpiy / ix runs; model_m.py LEA, LEAX): the add, a word with no act, the register from the address register on a bus-idle E word; the book's EA + 2 + 1; (qprobe round 17) the displacement modes are cells of their own (ldea_d8 / ldea_d16 / ldea_d16x / ldea_dir)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    open                                    ; OPEN: (qprobe round 16, spec 12 C2) a word with no act
    wr=REG wid=WORD ws=ADDR e bi            ; the register <- the address (0055 SIGMA -> R); E: (qprobe round 16) B N: bus-idle

; (qprobe round 17, spec 13 B, Q68) LEA with a displacement: five words in every mode, the
; displacement bytes released on the bus-idle E word with the next opcode (`P . . BNP .`,
; `P . . BNPP2 .`), [base+index+d16] one word more (`P . . . BNPP2 .`); cells of their own (mod=m01 /
; m10 / m00 rm=6: no EA head), the routine popping its own displacement
routine ldea_d8 op=8D mod=m01 why="OPEN: (qprobe round 17, Q68) LEA r,[.. + d8] is `P . . BNP .` (QPr17a bwd8 / bpd8 / bwixd8 / ixd8, 192 / 192 in the model, LEA_D8 / LEAX_D8): the displacement's pop, the add, a word with no act, the register from the address register on the bus-idle E word that releases the displacement and the next opcode"
    pop=dl                                  ; pop the displacement byte (the ModR/M byte released by the loader: P)
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    open                                    ; OPEN: (qprobe round 17) a word with no act
    wr=REG wid=WORD ws=ADDR e bi ro rl=1    ; the register <- the address; E: B N P: bus-idle, the next opcode and the displacement released

routine ldea_d16 op=8D mod=m10 rm=4-7 why="OPEN: (qprobe round 17, Q68) LEA r,[one register + d16] is `P . . BNPP2 .` (QPr17a bwd16 / bpd16, 96 / 96 in the model, LEA_D16): the displacement's two pops, the add, the register from the address register on the bus-idle E word that releases the displacement and the next opcode"
    pop=dl                                  ; pop the displacement's low byte (the ModR/M byte released by the loader: P)
    pop=dh                                  ; pop its high byte
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    wr=REG wid=WORD ws=ADDR e strict ro rl=2  ; (qprobe round 20, spec 16 A1 / Q88 / Q94) strict: the release of a word-wide operand also waits on the clock a chained fetch starts; the register <- the address; E: B N P P2: bus-idle, the next opcode and both displacement bytes released

routine ldea_d16x op=8D mod=m10 rm=0-3 why="OPEN: (qprobe round 17, Q68) LEA r,[base + index + d16] is `P . . . BNPP2 .` (QPr17a bwixd16, 48 / 48 in the model, LEAX_D16; the other pairs by analogy: a guess): one word more than the one-register form, as MOV r,[BW+IX+d16] (round 8, L_A2X); the word's place in front of the add by analogy with eaq16x"
    pop=dl                                  ; pop the displacement's low byte (the ModR/M byte released by the loader: P)
    pop=dh                                  ; pop its high byte
    open                                    ; OPEN: (qprobe round 17) a word with no act (two registers and a d16)
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    wr=REG wid=WORD ws=ADDR e strict ro rl=2  ; (qprobe round 20, spec 16 A1 / Q94, inferred: the rule stated on the word) strict; the register <- the address; E: B N P P2: bus-idle, the next opcode and both displacement bytes released

routine ldea_dir op=8D mod=m00 rm=6 why="OPEN: (qprobe round 17, Q68) LEA r,[d16] is `P . . BNPP2 .` (QPr17a dir, 48 / 48 in the model, LEA_DIR): the direct address's two pops, the address register from it, the register from the address register on the bus-idle E word that releases the address and the next opcode"
    pop=dl                                  ; pop the direct address's low byte (the ModR/M byte released by the loader: P)
    pop=dh                                  ; pop its high byte
    ea=DISP                                 ; the EA into the address register
    wr=REG wid=WORD ws=ADDR e strict ro rl=2  ; (qprobe round 20, spec 16 A1 / Q88 / Q94) strict: the release of a word-wide operand also waits on the clock a chained fetch starts; the register <- the address; E: B N P P2: bus-idle, the next opcode and both address bytes released

; ---- the group 1 memory forms (V20 GRP1 003C-0040: Q -> tmpbL, Q -> tmpbH, tmpb -> tmpa; ALU
; OPC; M -> tmpb; SIGMA -> M [-06-]): the immediate popped after the EA, then the read (silicon:
; the one-byte immediate's read a clock before the two-byte one's, v35s-chains.md F19), F with
; the group's op, the write's post, E held
routine grp1_mw8 diff=m00:+4 op=80,82,83 mod=mem reg=0-6 ea=bare paths=m00 book="ADD mem,imm" why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 10, Q29) ADD [BW],imm8 is `P . V DPZ G N .` (the qprobe addi8 runs; [BW+d8] `P . V P DPZ G N .` and [d16] `P . V PP2 DPZ G N .` read but their displacement after V needs a head the dispatch may not name: the bare heads' pops before the add, V one or two words late); the add (the ModR/M byte released by the loader: P), the immediate's pop (released at the datum), V (the late request word: a fetch's last clock is its earliest; the read due four clocks after it), two words with no act, the read's post, F with the group's op (D P), the write's post two clocks after the datum (Z), E bus-idle on the write's first clock (G N); the other operations of the group and the modes by analogy"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    pop=il                                  ; pop the immediate byte (released on the datum word)
    rl=x bi alt                             ; (qprobe round 10, A4) V: the late request word (waits while a fetch runs then, not on its last clock; no REQ_PRI): the read due four clocks after it
    open call=w1                            ; OPEN: (qprobe round 10) two words with no act (the call and the shared delay's 1)
g8w_p: bus=MEMR                                ; post the read (V + 3)
    f ee alu=GRP ax=OPR ay=IMM wf rl=1         ; D P: F: the datum and the immediate; the group's op, flags (W); the immediate released ; ee (WO46): the early end (RAMEN 0: this word is E, the next word the dispatch)
    d1=OPRW s1=SIG bus=MEMW                 ; Z: the result into the write datum; post the write (two clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock (bus-idle); an on-chip store holds it to the write's end (RAMEN)

routine grp1_mw diff=m00:+2 op=81 mod=mem reg=0-6 ea=bare paths=m00 bookv=15 book="ADD mem,imm" why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 10, Q29) ADD [BW],imm16 is `P . . BY DPP2Z G N .` (the qprobe addi16 runs): the add (P), two words with no act, BY (bus-idle; never on a fetch's last clock, so it is the request word too: the read due four clocks after it), the immediate's two pops (released at the datum), the read's post, F with the group's op (D P P2), the write's post (Z), E bus-idle (G N); the other operations and the displacement modes by analogy"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open call=w1                            ; OPEN: (qprobe round 10) two words with no act (the call and the shared delay's 1)
    bi                                      ; (qprobe round 10) BY: bus-idle (waits while a pin cycle started earlier runs); the read due four clocks after it
g16w_i: pop=il                                  ; pop the immediate's low byte (released on the datum word)
    pop=ih                                  ; pop its high byte (released on the datum word)
    bus=MEMR                                ; post the read (Y + 3)
    f ee alu=GRP ax=OPR ay=IMM wf rl=2         ; D P P2: F: the datum and the immediate; the group's op, flags (W); the immediate released ; ee (WO46): the early end (RAMEN 0: this word is E, the next word the dispatch)
    d1=OPRW s1=SIG bus=MEMW                 ; Z: the result into the write datum; post the write (two clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock (bus-idle); an on-chip store holds it to the write's end (RAMEN)

routine grp1_mcw8 diff=m00:+1 op=80,82,83 mod=mem reg=7 ea=bare paths=m00 book="CMP mem,imm" width=word why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 10, Q29) CMP [BW],imm8 is `P . V DP . BN .` (the qprobe cmpi8 runs): the add (P), the immediate's pop, V (the late request word), two words with no act, the read's post, F with CMP (D P), a word with no act, E bus-idle (B N, the commit word two after the immediate); the displacement modes by analogy (the bare heads)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    pop=il                                  ; pop the immediate byte (released on the datum word)
    rl=x bi alt                             ; (qprobe round 10, A4) V: the late request word (waits while a fetch runs then, not on its last clock; no REQ_PRI): the read due four clocks after it
    open call=w1                            ; OPEN: (qprobe round 10) two words with no act (the call and the shared delay's 1)
g8c_p: bus=MEMR                                ; post the read (V + 3)
    f ee alu=GRP ax=OPR ay=IMM wf rl=1         ; D P: F: the datum and the immediate; CMP, flags (W); the immediate released ; ee (WO46): the early end (RAMEN 0: this word is E, the next word the dispatch)
    open                                    ; OPEN: (qprobe round 10) a word with no act
    e bi ro                                 ; E (CMP writes nothing): B N: bus-idle; the next opcode released

routine grp1_mcw diff=m00:2 op=81 mod=mem reg=7 ea=bare paths=m00 book="CMP mem,imm" width=word why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 13, Q43) CMP [BW],imm16 is `P . . BY DPP2 . BN .` (the qprobe cmpi16 runs, 24 / 24): ADD [BW],imm16's head, D with CMP and the immediate's release, a word, the E word bus-idle; [BW+d8] `P . . BYP DPP2 . BN .` (24 / 24: the displacement released on Y; behind the bare head it is released at its pop)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open call=w1                            ; OPEN: (qprobe round 13, Q43) two words with no act (the call and the shared delay's 1)
    bi                                      ; (qprobe round 13, Q43) BY: bus-idle; the read due four clocks after it
g16c_i: pop=il                                  ; pop the immediate's low byte (released on the datum word)
    pop=ih                                  ; pop its high byte
    bus=MEMR                                ; post the read (Y + 3)
    f ee alu=GRP ax=OPR ay=IMM wf rl=2         ; D P P2: F: the datum and the immediate; CMP, flags (W); the immediate released ; ee (WO46): the early end (RAMEN 0: this word is E, the next word the dispatch)
    open                                    ; OPEN: (qprobe round 13, Q43) a word with no act
    e bi ro                                 ; E (CMP writes nothing): B N

