; TEST mem,imm (F6 / F7 /0, /1 its alias; not in the book's table)
routine test_mib op=F6 mod=mem reg=0-1 why="TEST mem8,imm8 (not in the book's table): the add, the immediate's pop, the read, F with the AND, E"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate byte
    bus=MEMR                                ; post the read
    f alu=AND ax=OPR ay=IMM wf              ; F: the datum AND the immediate, flags (W)
    e                                       ; E (TEST writes nothing)

routine test_miw op=F7 mod=mem reg=0-1 why="TEST mem16,imm16 (not in the book's table): as the byte form with the second immediate byte"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate's low byte
    pop=ih                                  ; pop its high byte
    bus=MEMR                                ; post the read
    f alu=AND ax=OPR ay=IMM wf              ; F: the datum AND the immediate, flags (W)
    e                                       ; E (TEST writes nothing)

; ---- multiply and divide, memory operand: the read, F into the register form's operand, its
; loop (loop.uasm: the one-bit-a-word loops, the finish, the writes) through a jump to the
; loop's label (the acts after the operand are the register form's)
routine mulu_m16 diff=m00:+5,d8:+5,d16:+5,dir:+5 op=F7 mod=mem reg=4 book="MULU mem16" why="OPEN: the add, the read, AW into tmpa, F with the multiplier's load, OPEN clocks, the register form's loop, finish and writes (loop.uasm mu16_l) (F5-push-mulu_m-k2-pE-w0: P:read at S+5, S-to-S 40: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    ra=AW wid=WORD d1=TA s1=RA              ; AW into tmpa (0179)
    f alu=MULI ax=TA ay=OPR cnt=BITS        ; F: the multiplier (the datum) loaded; the counter <- 16 (017B)
    open                                    ; OPEN: a clock of the model's with no act (MULU mem16)
    open jmp=mu16_l                         ; OPEN: a clock of the model's with no act (MULU mem16); to the register form's loop

routine mulu_m8 diff=m00:+1,d8:+1,d16:+1,dir:+1 op=F6 mod=mem reg=4 book="MULU mem8" width=byte why="OPEN: as the word form into the byte loop (loop.uasm mu8_l): the add, the read, AL into tmpa, F with the load, the register form's loop and its tail (the book's clocks with no act after the loop and its clock silicon longer than the book, F14-g-push-mulu_aw-pO-w0 for the word form): one over the book's EA + 27, the eleven OPEN words moved behind the loop (MX3 part 2)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    ra=AW wid=WORD d1=TA s1=RA              ; AL (AW) into tmpa
    f alu=MULI ax=TA ay=OPR cnt=BITS       jmp=mu8_l  ; F: the multiplier (the datum) loaded; the counter <- 8

routine mul_m16 op=F7 mod=mem reg=5 why="no book value (a range, EA + 42-51): the natural shape, the read, F with the magnitudes' load, the register form's loop (loop.uasm mi16_l)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    ra=AW wid=WORD d1=TA s1=RA              ; AW into tmpa
    f alu=MULI ax=TA ay=OPR cnt=BITS jmp=mi16_l     ; F: the magnitudes loaded (the datum the multiplier); the counter <- 16; to the loop

routine mul_m8 op=F6 mod=mem reg=5 why="no book value (a range, EA + 34-43): the natural shape (loop.uasm mi8_l)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    ra=AW wid=WORD d1=TA s1=RA              ; AL into tmpa
    f alu=MULI ax=TA ay=OPR cnt=BITS jmp=mi8_l      ; F: the magnitudes loaded; the counter <- 8; to the loop

routine divu_m16 diff=m00:+1,d8:+1,d16:+1,dir:+1 op=F7 mod=mem reg=6 book="DIVU mem16" why="OPEN: silicon longer than the book by one: the register form's tail with its two clocks (F16-l-push-divu_ix-pE-w0), the pre-check's jump and fifteen OPEN words moved behind the loop (MX3 part 2); the add, the read, DW into tmpc under the cycle, F with the dividend's and the divisor's load and the pre-check, the divide error's test, the register form's loop, finish and writes (loop.uasm dv16_l, by a jump): the book's EA + 43 with fifteen book clocks with no act before the loop"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    rb=DW wid=WORD d1=TC s1=RB              ; DW (the dividend's high half) into tmpc
    f ra=AW wid=WORD alu=DIVI ax=RA ay=OPR cnt=BITS jmp=dv16_l ; F: the dividend DW:AW, the divisor (the datum), the pre-check; the counter <- 16

routine divu_m8 diff=m00:+2,d8:+2,d16:+2,dir:+2 op=F6 mod=mem reg=6 book="DIVU mem8" width=byte why="OPEN: silicon longer than the book by two: the register form's tail with its two clocks (F16-l-push-divu_ix-pE-w0 for the word form), the pre-check's jump and sixteen OPEN words moved behind the loop (MX3 part 2); the add, the read, F with the dividend's and the divisor's load and the pre-check, the divide error's test, the register form's loop (loop.uasm dv8_l): the book's EA + 34 with sixteen book clocks with no act before the loop"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f ra=AW wid=WORD alu=DIVI ax=RA ay=OPR cnt=BITS jmp=dv8_l ; F: the dividend AW, the divisor (the datum), the pre-check; the counter <- 8

routine div_m16 op=F7 mod=mem reg=7 why="no book value (a range, EA + 57-67): the natural shape (loop.uasm di16_l)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    rb=DW wid=WORD d1=TC s1=RB              ; DW into tmpc
    f ra=AW wid=WORD alu=DIVI ax=RA ay=OPR cnt=BITS jmp=di16_l ; F: the magnitudes, the pre-check; the counter <- 16

routine div_m8 op=F6 mod=mem reg=7 why="no book value (a range, EA + 49-59): the natural shape (loop.uasm di8_l)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f ra=AW wid=WORD alu=DIVI ax=RA ay=OPR cnt=BITS jmp=di8_l ; F: the magnitudes, the pre-check; the counter <- 8

; ---- the memory shifts (mechanisms 3.4; docs/v35s-eu-timing.md: the operand read once and
; written once, the loop on a temporary, two words a count as the register form): the read,
; F into the shifter, the loop, the write's post with the flags, E held
routine shm_1 diff=m00:+1,d8:+1,d16:+1,dir:+1 op=D0,D1 mod=mem book="SHL mem,1" why="OPEN: the add, the read, F with the shifter's load, five clocks no act names, the one step, the write's post with the flags (the write eight clocks after the datum), E held (F5-push-shl_m1-k2-pE-w0: P:read at S+5, the write eight clocks after the datum, S-to-S 21: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f alu=SHI ax=OPR resv                   ; F: the shifter loaded from the datum with CY; the reservation
    open call=w4                            ; OPEN: 5 clocks: a clock of the model's with no act (SHL mem,1) (the call and the shared delay's 4)
    alu=SH1 ax=SIG                          ; the one step
    d1=OPRW s1=SIG alu=SHF ax=SIG wf bus=MEMW   ; the result into the write datum; the shift's flags (W); post the write
    e                                       ; E: held until the write's end (RAMEN)

routine shm_cl op=D2,D3 mod=mem book="SHL mem,CL" n=4 why="OPEN: the add, the read, CL into the counter under the cycle, F with the shifter's load, the zero test, the two-word iteration, the write's post with the flags (the count 0: the datum written back, no flags), E held: the book's EA + 19 + 2n with seven book clocks with no act before the zero test"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    rb=CW cnt=RB                            ; CL into the loop counter
    f alu=SHI ax=OPR resv                   ; F: the shifter loaded from the datum with CY; the reservation
    open call=w6                            ; OPEN: 7 clocks: a book clock with no act (SHL mem,CL EA + 19 + 2n) (the call and the shared delay's 6)
    jc=CNTZ:shmc_z                          ; a zero count skips the loop (SHIFT 0228 JMP Z)
shmc_l: alu=SH1 ax=SIG                      ; one shift step of the group's operation
    loop=shmc_l                             ; the counter step (the iteration's second word)
    d1=OPRW s1=SIG alu=SHF ax=SIG wf bus=MEMW   ; the result into the write datum; the shift's flags (W); post the write
    e wb                                    ; E: held until the write's end (RAMEN)
shmc_z: e wb                                ; (F5b: silicon, the fuzz's first differences: f5a_011 SHR SS:[BP+IX+96h], CL with CL 0) the count 0: no write (the flags kept); E

routine shm_imm op=C0,C1 mod=mem bookx="EA+15+2n" n=4 why="OPEN: the add, the read, the count's pop and its load under the cycle, F with the shifter's load, the zero test, the two-word iteration, the write's post with the flags, E held: the book's EA + 15 + 2n (its ROL mem,imm8 note) with three book clocks with no act before the zero test"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    pop=il                                  ; pop the count (V20 028C Q -> tmpaL)
    cnt=IL                                  ; the count into the loop counter
    f alu=SHI ax=OPR resv                   ; F: the shifter loaded from the datum with CY; the reservation
    open call=w2                            ; OPEN: 3 clocks: a book clock with no act (SHL mem,imm8 EA + 15 + 2n) (the call and the shared delay's 2)
    jc=CNTZ:shmi_z                          ; a zero count skips the loop
shmi_l: alu=SH1 ax=SIG                      ; one shift step
    loop=shmi_l                             ; the counter step
    d1=OPRW s1=SIG alu=SHF ax=SIG wf bus=MEMW   ; the result into the write datum; the shift's flags (W); post the write
    e wb                                    ; E: held until the write's end (RAMEN)
shmi_z: e wb                                ; (F5b: silicon, the fuzz's first differences: f5a_011 SHR SS:[BP+IX+96h], CL with CL 0) the count 0: no write (the flags kept); E

; ---- the stack's memory forms
; PUSH mem16 (FF /6; V20 FF_PUSH 01CC-01CE): the read, SP - 2 under the cycle, F: the datum
; into the write datum, the write at SS:SP, E held
routine push_m diff=m00:-1,d8:-1,d16:-1,dir:-1 op=FF mod=mem reg=6 book="PUSH mem16" why="OPEN: the add, the read, SP - 2 and the address under the cycle, F: the datum into the write datum, four clocks no act names, the write's post at SS:SP (six clocks after the datum), E held (F5-push-push_m-k2-pE-w0: P:read at S+5, the write six clocks after the datum, S-to-S 19: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR wid=WORD                       ; post the read (a word)
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG    ; SP <- SP - 2; the address register <- it
    f d1=OPRW s1=OPR resv                   ; F: the datum into the write datum; the reservation
    open call=w3                            ; OPEN: 4 clocks: a clock of the model's with no act (PUSH mem16) (the call and the shared delay's 3)
    bus=MEMW seg=SS wid=WORD                ; post the write at SS:SP
    e                                       ; E: held until the write's end (RAMEN)

; POP mem16 (8F /0; V20 POP_RM 0058-005B: the EA kept, SP -> IND, MEMR SS; SIGMA -> SP; [F];
; SIGMA -> IND [-06-])
routine pop_m op=8F mod=mem reg=0,1,2,3,4,5,6,7 book="POP mem16" why="OPEN: the add, the EA into tmpc and SP into the address register with the stack read's post (0058-0059), SP + 2 and its write (005A), F: the datum into the write datum and the EA back into the address register, the write's post (005B), E held to its end: the book's EA + 14 with three book clocks with no act before the write's post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    rb=SP wid=WORD d1=TC s1=ADDR d2=ADDR s2=RB bus=MEMR seg=SS  ; the EA into tmpc (0058); SP into the address register; post the read at SS:SP (0059)
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    wr=SP wid=WORD ws=SIG resv              ; SP <- SP + 2 (005A); the reservation (the write follows)
    f d1=OPRW s1=OPR d2=ADDR s2=TC          ; F: the datum into the write datum; the address register <- the EA (005A)
    open call=w2                            ; OPEN: 3 clocks: a book clock with no act (POP mem16 EA + 14) (the call and the shared delay's 2)
    bus=MEMW wid=WORD                       ; post the write at the EA (the default segment) (005B [-06-])
    e                                       ; E: held until the write's end (RAMEN)
