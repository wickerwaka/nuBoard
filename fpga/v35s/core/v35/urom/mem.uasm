    pop=dh                                  ; pop its high byte
    ea=DISP bi rl=0 jmp=tmi16_y                 ; (rl=0: the routine names its releases, the d16 cell's) B: the bus-idle third word; the EA into the address register; then the d16 cell's words

; ---- multiply and divide, memory operand: the read, F into the register form's operand, its
; loop (loop.uasm: the one-bit-a-word loops, the finish, the writes) through a jump to the
; loop's label (the acts after the operand are the register form's)
routine mulu_m16 op=F7 mod=mem reg=4 ea=bare book="MULU mem16" diff=m00:3,d8:4,d16:4,dir:5 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 13, Q42) MULU / MUL / DIVU / DIV on memory are `P . B Y D` in front and the register form's word count in total (the read replaces five of its words; with the datum wait the + 4 clocks of Q39; the qprobe mm runs): the add, a word, the bus-idle word, Y, the read, F with the unit's load, the loop, the register form's tail from its finish (its count, sign steps and exit unchanged)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 13, Q42) a word with no act
