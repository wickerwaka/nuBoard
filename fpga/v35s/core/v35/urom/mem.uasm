    open                                    ; OPEN: (qprobe round 13, Q42) a word with no act
    bi                                      ; (qprobe round 13, Q42) B: the bus-idle third word
    rl=x bi ra=AW wid=WORD d1=TA s1=RA      ; (qprobe round 13, Q42) Y: the request word (the read posted three words later); AW into tmpa
    open call=w1                            ; OPEN: (qprobe round 13, Q42) two words with no act (the call and the shared delay's 1)
    bus=MEMR                                ; post the read (Y + 3)
    f alu=MULI ax=TA ay=OPR cnt=BITS ; D: F: the datum loaded into the unit; the counter <- the bits
mulu_m16_l: alu=MULS loop=mulu_m16_l                ; one step; the counter step
    open call=w6                           ; OPEN: (qprobe round 13, Q42) words with no act (the register form's delay two words shorter: the read replaces five of its words)
    jmp=mu16_f                              ; the register form's finish

