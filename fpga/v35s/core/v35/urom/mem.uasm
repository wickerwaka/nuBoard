    bus=MEMR                                ; post the read (Y + 3)
    f alu=NOT ax=OPR                  ; D: F: the operation on the datum
    d1=OPRW s1=SIG bus=MEMW                 ; Z: the result into the write datum; post the write (two clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock; an on-chip store holds it to the write's end (RAMEN)

routine neg_m op=F6,F7 mod=mem reg=3 ea=bare diff=m00:+2,d8:+3,d16:+3,dir:+4 book="NEG mem" why="OPEN: (qprobe round 8, Q19 / Q20) INC word [BW] is `P . . B Y . . DZ N` (NEG by analogy with INC; the byte form, the other unary ops and EA modes by analogy, the displacement's pops in the bare heads before it): the add (the ModR/M byte released by the loader), two words with no act, B (the group's bus-idle fourth word: waits while a fetch's pin cycle runs), Y (the request word: the read due four clocks after it, posted three words later), two words with no act, the read's post, D (F: the operation on the datum), Z (the write's post on the word after the datum word: the write two clocks after it), E (an on-chip store holds it to the write's end: RAMEN), N on the boundary word; beyond the book in the book check's machine (E held to the write's end: the on-chip timing; the bare heads' pops at d8, d16 and the direct address); before round 8: the add, the read's post (S+4), F, the write's post, E held (F5-push-inc_m-k2-pE-w0)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    open                                    ; OPEN: (qprobe round 8) a word with no act
    open                                    ; OPEN: (qprobe round 8) a word with no act
    bi                                      ; (qprobe round 8, Q20) B: the group's bus-idle word (waits while a fetch's pin cycle runs)
    rl=x bi                                 ; (qprobe round 8) Y: the request word (the read due four clocks after it, posted three words later)
    open                                    ; OPEN: (qprobe round 8) a word with no act
    open                                    ; OPEN: (qprobe round 8) a word with no act
    bus=MEMR                                ; post the read (Y + 3)
    f alu=NEG ax=OPR wf               ; D: F: the operation on the datum
    d1=OPRW s1=SIG bus=MEMW                 ; Z: the result into the write datum; post the write (two clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock; an on-chip store holds it to the write's end (RAMEN)

; TEST mem,imm (F6 / F7 /0, /1 its alias; not in the book's table)
routine test_mib op=F6 mod=mem reg=0-1 ea=bare why="OPEN: (qprobe round 10) TEST mem8,imm8 by analogy with TEST [BW],imm16 (Q29: `P . B . . Y DPP2 . BN .`) with one immediate byte: `P . B . . Y DP . BN .` (not measured; kept while it loses no corpus run)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 10) a word with no act
    bi call=w2                              ; (qprobe round 10) B: the bus-idle third word; OPEN: two words with no act (the call and the shared delay's 2)
    rl=x bi                                 ; (qprobe round 10) Y: the request word (the read due four clocks after it, posted three words later)
    pop=il                                  ; pop the immediate byte (released on the datum word)
    open                                    ; OPEN: (qprobe round 10) a word with no act
    bus=MEMR                                ; post the read (Y + 3)
    f d1=TB s1=OPR rl=1                     ; D P: F: the datum into tmpb; the immediate released
    alu=AND ax=TB ay=IMM wf                 ; the datum AND the immediate, flags (W)
    e bi ro                                 ; E (TEST writes nothing): B N: bus-idle; the next opcode released

routine test_miw op=F7 mod=mem reg=0-1 ea=bare why="OPEN: (qprobe round 10, Q29) TEST [BW],imm16 is `P . B . . Y DPP2 . BN .` (the qprobe testi runs): the add (P), a word with no act, B (the bus-idle third word), two words with no act, Y (the request word: the read due four clocks after it), the immediate's two pops (released at the datum), the read's post, F with the datum into tmpb (D P P2), the AND, E bus-idle (B N); the displacement modes by analogy (the bare heads)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 10) a word with no act
    bi call=w2                              ; (qprobe round 10) B: the bus-idle third word; OPEN: two words with no act (the call and the shared delay's 2)
    rl=x bi                                 ; (qprobe round 10) Y: the request word (the read due four clocks after it, posted three words later)
    pop=il                                  ; pop the immediate's low byte (released on the datum word)
    pop=ih                                  ; pop its high byte (released on the datum word)
    bus=MEMR                                ; post the read (Y + 3)
    f d1=TB s1=OPR rl=2                     ; D P P2: F: the datum into tmpb; the immediate released
    alu=AND ax=TB ay=IMM wf                 ; the datum AND the immediate, flags (W)
    e bi ro                                 ; E (TEST writes nothing): B N: bus-idle; the next opcode released

; ---- multiply and divide, memory operand: the read, F into the register form's operand, its
; loop (loop.uasm: the one-bit-a-word loops, the finish, the writes) through a jump to the
; loop's label (the acts after the operand are the register form's)
routine mulu_m16 op=F7 mod=mem reg=4 ea=bare book="MULU mem16" diff=m00:3,d8:4,d16:4,dir:5 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 13, Q42) MULU / MUL / DIVU / DIV on memory are `P . B Y D` in front and the register form's word count in total (the read replaces five of its words; with the datum wait the + 4 clocks of Q39; the qprobe mm runs): the add, a word, the bus-idle word, Y, the read, F with the unit's load, the loop, the register form's tail from its finish (its count, sign steps and exit unchanged)"
