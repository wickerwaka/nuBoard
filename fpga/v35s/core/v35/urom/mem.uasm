; TEST mem,imm (F6 / F7 /0, /1 its alias; not in the book's table)
routine test_mib op=F6 mod=mem reg=0-1 ea=bare why="OPEN: (qprobe round 10) TEST mem8,imm8 by analogy with TEST [BW],imm16 (Q29: `P . B . . Y DPP2 . BN .`) with one immediate byte: `P . B . . Y DP . BN .` (not measured; kept while it loses no corpus run)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 10) a word with no act
    bi call=w2                              ; (qprobe round 10) B: the bus-idle third word; OPEN: two words with no act (the call and the shared delay's 2)
    rl=x bi                                 ; (qprobe round 10) Y: the request word (the read due four clocks after it, posted three words later)
    pop=il                                  ; pop the immediate byte (released on the datum word)
    open                                    ; OPEN: (qprobe round 10) a word with no act
    bus=MEMR                                ; post the read (Y + 3)
    f d1=TB s1=OPR rl=1                     ; D P: F: the datum into tmpb; the immediate released
    alu=AND ax=TB ay=IMM wf                 ; the datum AND the immediate, flags (W)
    e bi ro                                 ; E (TEST writes nothing): B N: bus-idle; the next opcode released

routine test_miw op=F7 mod=mem reg=0-1 ea=bare paths=m00 why="OPEN: (qprobe round 10, Q29) TEST [BW],imm16 is `P . B . . Y DPP2 . BN .` (the qprobe testi runs): the add (P), a word with no act, B (the bus-idle third word), two words with no act, Y (the request word: the read due four clocks after it), the immediate's two pops (released at the datum), the read's post, F with the datum into tmpb (D P P2), the AND, E bus-idle (B N); the displacement modes by analogy (the bare heads)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 10) a word with no act
    bi call=w2                              ; (qprobe round 10) B: the bus-idle third word; OPEN: two words with no act (the call and the shared delay's 2)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B Y: the request word is bus-idle (`P . B . . BY DPP2 . BN .`; the other placement `P . B S . Y` scores the same: the first taken): the read posted three words later
tmi_i: pop=il                                  ; pop the immediate's low byte (released on the datum word)
    pop=ih                                  ; pop its high byte (released on the datum word)
    bus=MEMR                                ; post the read (Y + 3)
    f d1=TB s1=OPR rl=2                     ; D P P2: F: the datum into tmpb; the immediate released
    alu=AND ax=TB ay=IMM wf                 ; the datum AND the immediate, flags (W)
    e bi ro                                 ; E (TEST writes nothing): B N: bus-idle; the next opcode released

; (qprobe round 20, spec 16 B, Q90) TEST with a displacement as cells of their own: the head is TEST
; [BW],AW's (`P . B`), the routine pops its own displacement and releases it where silicon does
routine test_m16_d16 op=85 mod=m10 why="OPEN: (qprobe round 20, spec 16 B, Q90) TEST [BW+d16],AW is `P . B Y . PP2 DN .` (QPr20a testbwd16, 42 / 42 in the model); the two-register modes by analogy: the routine pops its own displacement (no EA head) and releases it two words after the request word"
    pop=dl                                  ; pop the displacement's low byte (the ModR/M byte released by the loader: P)
    pop=dh                                  ; pop its high byte
    ea=BI ra=BASE rb=INDEX bi               ; B: TEST's bus-idle third word; the EA into the address register
tm16_y: rl=x bi                             ; Y: the request word (the read due four clocks after it, posted three words later)
    open                                    ; OPEN: a word with no act
    rl=2                                    ; P P2: the displacement released
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=AND ax=OPR ay=RA wf e ro   ; D N: F: the datum and the register; AND, flags (W); E (TEST writes nothing); N

routine test_m16_dir op=85 mod=m00 rm=6 why="OPEN: (qprobe round 20, spec 16 B, Q90) TEST [d16],AW is `P . B Y . PP2 DN .` (QPr20a f-testd / fl-testd, 42 / 42 in the model): the routine pops the direct address (no EA head) and releases it two words after the request word"
