routine div_m16 op=F7 mod=mem reg=7 why="no book value (a range, EA + 57-67): the natural shape (loop.uasm di16_l)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    rb=DW wid=WORD d1=TC s1=RB              ; DW into tmpc
    f ra=AW wid=WORD alu=DIVI ax=RA ay=OPR cnt=BITS ; F: the magnitudes, the pre-check; the counter <- 16
    jc=DTRAP:di16_t                         ; the pre-check failed
    jmp=di16_l                              ; to the register form's loop

routine div_m8 op=F6 mod=mem reg=7 why="no book value (a range, EA + 49-59): the natural shape (loop.uasm di8_l)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f ra=AW wid=WORD alu=DIVI ax=RA ay=OPR cnt=BITS ; F: the magnitudes, the pre-check; the counter <- 8
    jc=DTRAP:di8_t                          ; the pre-check failed
    jmp=di8_l                               ; to the register form's loop

; ---- the memory shifts (mechanisms 3.4; docs/v35s-eu-timing.md: the operand read once and
; written once, the loop on a temporary, two words a count as the register form): the read,
; F into the shifter, the loop, the write's post with the flags, E held
routine shm_1 op=D0,D1 mod=mem book="SHL mem,1" why="OPEN: the add, the read, F with the shifter's load, the one step, the write's post with the flags, E held to its end: the book's EA + 16 with four book clocks with no act before the step"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f alu=SHI ax=OPR resv                   ; F: the shifter loaded from the datum with CY; the reservation (the write follows)
    open                                    ; OPEN: a book clock with no act (SHL mem,1 EA + 16)
    open                                    ; OPEN: a book clock with no act (SHL mem,1 EA + 16)
    open                                    ; OPEN: a book clock with no act (SHL mem,1 EA + 16)
    open                                    ; OPEN: a book clock with no act (SHL mem,1 EA + 16)
    alu=SH1 ax=SIG                          ; the one step (0116's R row, COUNT 1)
    d1=OPRW s1=SIG alu=SHF ax=SIG wf bus=MEMW   ; the result into the write datum; the shift's flags (W); post the write
    e                                       ; E: held until the write's end (RAMEN)

routine shm_cl op=D2,D3 mod=mem book="SHL mem,CL" n=4 why="OPEN: the add, the read, CL into the counter under the cycle, F with the shifter's load, the zero test, the two-word iteration, the write's post with the flags (the count 0: the datum written back, no flags), E held: the book's EA + 19 + 2n with seven book clocks with no act before the zero test"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    rb=CW cnt=RB                            ; CL into the loop counter
    f alu=SHI ax=OPR resv                   ; F: the shifter loaded from the datum with CY; the reservation
    open                                    ; OPEN: a book clock with no act (SHL mem,CL EA + 19 + 2n)
    open                                    ; OPEN: a book clock with no act (SHL mem,CL EA + 19 + 2n)
    open                                    ; OPEN: a book clock with no act (SHL mem,CL EA + 19 + 2n)
    open                                    ; OPEN: a book clock with no act (SHL mem,CL EA + 19 + 2n)
    open                                    ; OPEN: a book clock with no act (SHL mem,CL EA + 19 + 2n)
    open                                    ; OPEN: a book clock with no act (SHL mem,CL EA + 19 + 2n)
    open                                    ; OPEN: a book clock with no act (SHL mem,CL EA + 19 + 2n)
    jc=CNTZ:shmc_z                          ; a zero count skips the loop (SHIFT 0228 JMP Z)
shmc_l: alu=SH1 ax=SIG                      ; one shift step of the group's operation
    loop=shmc_l                             ; the counter step (the iteration's second word)
    d1=OPRW s1=SIG alu=SHF ax=SIG wf bus=MEMW   ; the result into the write datum; the shift's flags (W); post the write
    e                                       ; E: held until the write's end (RAMEN)
shmc_z: d1=OPRW s1=SIG bus=MEMW             ; the count 0: the datum written back unchanged (the flags kept); post the write
    e                                       ; E: held until the write's end (RAMEN)

routine shm_imm op=C0,C1 mod=mem bookx="EA+15+2n" n=4 why="OPEN: the add, the read, the count's pop and its load under the cycle, F with the shifter's load, the zero test, the two-word iteration, the write's post with the flags, E held: the book's EA + 15 + 2n (its ROL mem,imm8 note) with three book clocks with no act before the zero test"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    pop=il                                  ; pop the count (V20 028C Q -> tmpaL)
    cnt=IL                                  ; the count into the loop counter
    f alu=SHI ax=OPR resv                   ; F: the shifter loaded from the datum with CY; the reservation
    open                                    ; OPEN: a book clock with no act (SHL mem,imm8 EA + 15 + 2n)
    open                                    ; OPEN: a book clock with no act (SHL mem,imm8 EA + 15 + 2n)
    open                                    ; OPEN: a book clock with no act (SHL mem,imm8 EA + 15 + 2n)
    jc=CNTZ:shmi_z                          ; a zero count skips the loop
shmi_l: alu=SH1 ax=SIG                      ; one shift step
    loop=shmi_l                             ; the counter step
    d1=OPRW s1=SIG alu=SHF ax=SIG wf bus=MEMW   ; the result into the write datum; the shift's flags (W); post the write
    e                                       ; E: held until the write's end (RAMEN)
shmi_z: d1=OPRW s1=SIG bus=MEMW             ; the count 0: the datum written back unchanged; post the write
    e                                       ; E: held until the write's end (RAMEN)

; ---- the stack's memory forms
; PUSH mem16 (FF /6; V20 FF_PUSH 01CC-01CE): the read, SP - 2 under the cycle, F: the datum
; into the write datum, the write at SS:SP, E held
routine push_m op=FF mod=mem reg=6 book="PUSH mem16" why="OPEN: the add, the read, SP - 2 and the address register under the cycle, F: the datum into the write datum, the write's post at SS:SP, E held to its end: the book's EA + 16 with five book clocks with no act before the write's post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR wid=WORD                       ; post the read (a word)
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG    ; SP <- SP - 2; the address register <- it
    f d1=OPRW s1=OPR resv                   ; F: the datum into the write datum; the reservation
    open                                    ; OPEN: a book clock with no act (PUSH mem16 EA + 16)
    open                                    ; OPEN: a book clock with no act (PUSH mem16 EA + 16)
    open                                    ; OPEN: a book clock with no act (PUSH mem16 EA + 16)
    open                                    ; OPEN: a book clock with no act (PUSH mem16 EA + 16)
    open                                    ; OPEN: a book clock with no act (PUSH mem16 EA + 16)
    bus=MEMW seg=SS wid=WORD                ; post the write at SS:SP
    e                                       ; E: held until the write's end (RAMEN)

; POP mem16 (8F /0; V20 POP_RM 0058-005B: the EA kept, SP -> IND, MEMR SS; SIGMA -> SP; [F];
; SIGMA -> IND [-06-])
routine pop_m op=8F mod=mem reg=0 book="POP mem16" why="OPEN: the add, the EA into tmpc and SP into the address register with the stack read's post (0058-0059), SP + 2 and its write (005A), F: the datum into the write datum and the EA back into the address register, the write's post (005B), E held to its end: the book's EA + 14 with three book clocks with no act before the write's post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    rb=SP wid=WORD d1=TC s1=ADDR d2=ADDR s2=RB bus=MEMR seg=SS  ; the EA into tmpc (0058); SP into the address register; post the read at SS:SP (0059)
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    wr=SP wid=WORD ws=SIG resv              ; SP <- SP + 2 (005A); the reservation (the write follows)
    f d1=OPRW s1=OPR d2=ADDR s2=TC          ; F: the datum into the write datum; the address register <- the EA (005A)
    open                                    ; OPEN: a book clock with no act (POP mem16 EA + 14)
    open                                    ; OPEN: a book clock with no act (POP mem16 EA + 14)
    open                                    ; OPEN: a book clock with no act (POP mem16 EA + 14)
    bus=MEMW wid=WORD                       ; post the write at the EA (the default segment) (005B [-06-])
    e                                       ; E: held until the write's end (RAMEN)
