    open                                    ; OPEN: a book clock with no act (DIVU mem16 EA + 43)
    open                                    ; OPEN: a book clock with no act (DIVU mem16 EA + 43)
    open jmp=dv16_l                         ; OPEN: a book clock with no act (DIVU mem16 EA + 43); to the register form's loop

