; ---- the unary group's memory forms (V20 0170-0175: M -> tmpb; the op; SIGMA -> M [-06-])
routine inc_m diff=m00:-2,d8:-2,d16:-2,dir:-2 op=FE,FF mod=mem reg=0 book="INC mem (word)" why="OPEN: the add, the read, F with the operation, the write's post (the write two clocks after the datum), E held to its end (F5-push-inc_m-k2-pE-w0: P:read at S+5, the write two clocks after the datum, E at the write's end: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f alu=INC ax=OPR wf resv     ; F: the operation on the datum (W where the form writes flags); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine dec_m diff=m00:-2,d8:-2,d16:-2,dir:-2 op=FE,FF mod=mem reg=1 book="DEC mem (word)" why="OPEN: the add, the read, F with the operation, the write's post (the write two clocks after the datum), E held to its end (F5-push-inc_m-k2-pE-w0: P:read at S+5, the write two clocks after the datum, E at the write's end: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f alu=DEC ax=OPR wf resv     ; F: the operation on the datum (W where the form writes flags); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine not_m diff=m00:-2,d8:-2,d16:-2,dir:-2 op=F6,F7 mod=mem reg=2 book="NOT mem" why="OPEN: the add, the read, F with the operation, the write's post (the write two clocks after the datum), E held to its end (F5-push-inc_m-k2-pE-w0: P:read at S+5, the write two clocks after the datum, E at the write's end: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f alu=NOT ax=OPR resv        ; F: the operation on the datum (W where the form writes flags); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine neg_m diff=m00:-2,d8:-2,d16:-2,dir:-2 op=F6,F7 mod=mem reg=3 book="NEG mem" why="OPEN: the add, the read, F with the operation, the write's post (the write two clocks after the datum), E held to its end (F5-push-inc_m-k2-pE-w0: P:read at S+5, the write two clocks after the datum, E at the write's end: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f alu=NEG ax=OPR wf resv     ; F: the operation on the datum (W where the form writes flags); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
