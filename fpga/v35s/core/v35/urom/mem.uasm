; MX1 the memory forms (docs/v35s-mechanisms.md sections 3.3, 3.5, 3.6). A ModR/M memory
; routine (mod=mem) is entered from its EA head (ea.uasm: the displacement's pops and, ea=book,
; the book's EA clock) with its first word the EA's add: base (port A) + index (port B) + the
; displacement into the address register (the default segment: a prefix's, else SS for a BP
; mode, else DS0). The add uses both RAM read ports, and the request's address is the segment
; + the address register as a register (the add's 3-input sum into a request address in one
; tick is too long a chain: README "MX1"), so a request is posted on a word after the add.
; A load posts the read and the F word takes the datum (the odd word's pair is the bus unit's);
; a store moves the datum into OPRW and posts the write, its E held to the cycle's end with
; RAMEN = 1 (the hold); a read-modify-write posts the read, F, the ALU, the write's post, E
; held. The reservation rises on the add (the routine knows it will post; the displacement is
; popped). The shape follows the V20 routine (V20UC.TXT) where one exists, never its counts.
; Every length is the data book's formula at each path's EA (m00 3, d8 3, d16 4, dir 3) plus
; the declared difference; an OPEN word is a book clock no act names.

; ---- loads (V20 MOV_RM 004C-004D, the load direction: M -> tmpa, tmpa -> R)
routine ld op=8A,8B mod=mem book="MOV reg,mem" why="the add, the post, the cycle, F: the datum into tmpa (004C), the register from tmpa on the E word (004D): the book's EA + 7 on every path but mod 00's EA book error (the head)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add into the address register; the reservation
    bus=MEMR                                ; post the read (the default segment)
    f d1=TA s1=OPR                          ; F: the datum into tmpa (004C M -> tmpa)
    wr=REG ws=TA e                          ; the register <- tmpa (004D tmpa -> R); E

; ---- load + ALU (V20 ALU_RM 0000-0001: M -> tmpb, R -> tmpa; ALU OPC; SIGMA -> R)
routine ld_alu op=02,03,0A,0B,12,13,1A,1B,22,23,2A,2B,32,33 mod=mem book="ADD reg,mem" why="the add, the post, the cycle, F with the register's read and the block's ALU op (0000), the write on the E word (0001): the book's EA + 7"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f ra=REG alu=GRP ax=RA ay=OPR wf        ; F: the register and the datum; the block's ALU op, flags (W) (0000)
    wr=REG ws=SIG e                         ; the register <- SIGMA (0001); E

routine cmp_rm op=3A,3B mod=mem book="CMP reg,mem" why="ADD reg,mem's routine, its write suppressed (V20 ALU_RM for CMP): the book's EA + 7"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f ra=REG alu=GRP ax=RA ay=OPR wf        ; F: the register and the datum; CMP, flags (W) (0000)
    e                                       ; E: the write-back word, its write suppressed (CMP: 0001 with no write)

; ---- read-modify-write (V20 ALU_RM with the memory destination: SIGMA -> M [-06-])
routine rmw op=00,01,08,09,10,11,18,19,20,21,28,29,30,31 mod=mem ea=bare book="ADD mem,reg" diff=m00:-1,dir:+1 why="the add, the read's post, F with the ALU (0000), the write's post with the result (0001), E held to the write's end (RAMEN): the read and the write 5 clocks apart (mechanisms 3.6, measured); its acts fill the book's EA clocks (ea=bare). mod 00: book error of one, silicon's ADD [BW],DW 13 (a6, docs/v35s-mechanisms/classes.md RMW) less the dispatch's fetch stall its method puts under the marker: 12; the direct form +1: the two pops the book's EA 3 does not resolve"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f ra=REG alu=GRP ax=OPR ay=RA wf resv   ; F: the datum and the register; the ALU op, flags (W) (0000); the reservation (the write follows)
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write (0001 SIGMA -> M)
    e                                       ; E: held until the write's end (RAMEN)

routine cmp_mr op=38,39 mod=mem book="CMP mem,reg" why="the read, F with the ALU, E (no write: CMP): the book's EA + 7"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f ra=REG alu=GRP ax=OPR ay=RA wf        ; F: the datum and the register; CMP, flags (W)
    e                                       ; E: the write-back word, its write suppressed (CMP)

; TEST mem,reg (V20 TEST_RM 0044-0045: M -> tmpa, R -> tmpb; AND; SIGMA -> NULL)
routine test_m8 op=84 mod=mem book="TEST mem,reg" width=byte why="OPEN: the read, F with the AND, E; five book clocks with no act before the post (the book's EA + 12 for the byte form)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    open                                    ; OPEN: a book clock with no act (TEST mem8,reg8 EA + 12)
    open                                    ; OPEN: a book clock with no act (TEST mem8,reg8 EA + 12)
    open                                    ; OPEN: a book clock with no act (TEST mem8,reg8 EA + 12)
    open                                    ; OPEN: a book clock with no act (TEST mem8,reg8 EA + 12)
    open                                    ; OPEN: a book clock with no act (TEST mem8,reg8 EA + 12)
    bus=MEMR                                ; post the read
    f ra=REG alu=AND ax=OPR ay=RA wf        ; F: the datum and the register; AND, flags (W) (0044)
    e                                       ; E (TEST writes nothing: 0045 SIGMA -> NULL)

routine test_m16 op=85 mod=mem book="TEST mem,reg" width=word diff=-1 why="OPEN: book error of one: the book's EA + 11 against silicon's TEST [BW],DW 13 (a6, docs/v35s-mechanisms/classes.md LOAD_ALU; F5 13) less the dispatch's fetch stall its method puts under the marker: 12 at mod 00 with the head's book error; the read, F with the AND, E; three book clocks with no act before the post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    open                                    ; OPEN: a book clock with no act (TEST mem16,reg16 EA + 11)
    open                                    ; OPEN: a book clock with no act (TEST mem16,reg16 EA + 11)
    open                                    ; OPEN: a book clock with no act (TEST mem16,reg16 EA + 11)
    bus=MEMR                                ; post the read
    f ra=REG alu=AND ax=OPR ay=RA wf        ; F: the datum and the register; AND, flags (W) (0044)
    e                                       ; E (TEST writes nothing)

; XCH mem,reg (V20 XCHG_RM 0048-004A: M -> tmpa, R -> tmpb; tmpa -> R [-06-]; tmpb -> M)
routine xch_m op=86,87 mod=mem book="XCH mem,reg" why="OPEN: the read, F: the register into the write datum and the datum into the register (0048-0049), the write's post (004A), E held to the write's end: the book's EA + 12 with one book clock with no act before the write's post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f ra=REG d1=OPRW s1=RA wr=REG ws=OPR resv   ; F: the register into the write datum (0048 R -> tmpb), the datum into the register (0049 tmpa -> R); the reservation
    open                                    ; OPEN: a book clock with no act (XCH mem,reg EA + 12)
    bus=MEMW                                ; post the write (004A tmpb -> M)
    e                                       ; E: held until the write's end (RAMEN)

; ---- stores (V20 MOV_RM 004C-004D, the store direction: R -> tmpa, tmpa -> M; the operand
; pre-read suppressed, pla_3 MODRM_STORE)
routine st op=88,89 mod=mem ea=bare book="MOV mem,reg" diff=m00:-1,dir:+1 why="the add, the register's read (both RAM read ports are the add's: the datum's read a word later) with the post, E held to the write's end (RAMEN): its acts fill the book's EA clocks (ea=bare). mod 00: book error of one, silicon's MOV [BW],DW 8 (a6, docs/v35s-mechanisms/classes.md STORE) less the dispatch's fetch stall its method puts under the marker: 7; the direct form +1: the two pops the book's EA 3 does not resolve"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    ra=REG d1=OPRW s1=RA bus=MEMW           ; the register into the write datum (004C R -> tmpa); post the write (004D tmpa -> M)
    e                                       ; E: held until the write's end (RAMEN)

; MOV mem,imm (C6 / C7 /0): the immediate popped after the EA (the V20's routine pops it after
; the loader's EA), into the write datum, the post
routine st_imm8 op=C6 mod=mem reg=0 ea=bare book="MOV mem,imm" width=byte diff=m00:-1,dir:+1 why="the add, the immediate's pop, the datum with the post, E held to the write's end: its acts fill the book's EA clocks (ea=bare). A book error of one at mod 00: the book's EA + 6 for both widths against the byte form's write a clock before the word's on silicon (v35s-chains.md F19: C6 07 and 83 /7 one clock earlier than C7 07), the word's 10 (a6 MOV word [BW],0x1234) less the dispatch's fetch stall 9: the byte 8; the direct form +1: the two pops the book's EA 3 does not resolve"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate byte
    d1=OPRW s1=IMM bus=MEMW                 ; the immediate into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine st_imm16 op=C7 mod=mem reg=0 ea=bare book="MOV mem,imm" width=word diff=d8:+1,d16:+1,dir:+2 why="the add, the immediate's two pops, the datum with the post, E held to the write's end: the book's EA + 6 at mod 00 (silicon's 10: a6 MOV word [BW],0x1234); the displacement's pops the book's EA does not resolve: d8 +1, d16 +1, the direct form +2 (no OPEN word: ea=bare)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate's low byte
    pop=ih                                  ; pop its high byte
    d1=OPRW s1=IMM bus=MEMW                 ; the immediate into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

; MOV mem16,sreg / MOV sreg,mem16 (V20 MOV_SREG 0050: R -> M [-06-] [E])
routine st_sr op=8C mod=mem book="MOV mem16,sreg" why="the add, the segment register's read with the post, E held to the write's end: the book's EA + 6"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    rb=SREG wid=WORD d1=OPRW s1=RB bus=MEMW ; the segment register into the write datum; post the write (a word)
    e                                       ; E: held until the write's end (RAMEN)

routine ld_sr op=8E mod=mem book="MOV sreg,mem16" diff=-1 why="OPEN: book error of one: the book's EA + 9 against silicon's MOV DS1,[BW] 11 (a6, docs/v35s-mechanisms/classes.md LOAD_SEG) less the dispatch's fetch stall its method puts under the marker: 10 at mod 00 with the head's book error; the add, the post, the cycle, F: the segment register from the datum on the E word; two book clocks with no act before the post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    open                                    ; OPEN: a book clock with no act (MOV sreg,mem16 EA + 9)
    open                                    ; OPEN: a book clock with no act (MOV sreg,mem16 EA + 9)
    bus=MEMR wid=WORD                       ; post the read (a word)
    f wr=SREG wid=WORD ws=OPR e             ; F: the segment register <- the datum (RAM and the segment flop); E

; LDS / LES (V20 LES 00F8-00FA: OPR -> R, SIGMA -> tmpb, ALU INC2 [F]; SIGMA -> IND, MEMR;
; OPR -> ES [FE]): the offset word, the address + 2, the segment word
routine les op=C4 mod=mem book="MOV DS0/DS1,reg16,memptr32" why="OPEN: the add, the offset's read, the address + 2 under the cycle, F: the register and the address register (00F8), the segment's read (00F9), F: DS1 on the E word (00FA): the book's EA + 17 with six book clocks with no act before the first post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    open                                    ; OPEN: a book clock with no act (LES EA + 17)
    open                                    ; OPEN: a book clock with no act (LES EA + 17)
    open                                    ; OPEN: a book clock with no act (LES EA + 17)
    open                                    ; OPEN: a book clock with no act (LES EA + 17)
    open                                    ; OPEN: a book clock with no act (LES EA + 17)
    open                                    ; OPEN: a book clock with no act (LES EA + 17)
    bus=MEMR wid=WORD                       ; post the offset's read (a word)
    alu=INC2 ax=ADDR resv                   ; the address + 2 into SIGMA (00F8 ALU INC2); the reservation (the second read)
    f wr=REG wid=WORD ws=OPR d1=ADDR s1=SIG ; F: the register <- the offset (00F8 OPR -> R); the address register <- the address + 2
    bus=MEMR wid=WORD                       ; post the segment's read (00F9 SIGMA -> IND; MEMR)
    f wr=DS1 wid=WORD ws=OPR e              ; F: DS1 <- the segment (00FA OPR -> ES); E

routine lds op=C5 mod=mem book="MOV DS0/DS1,reg16,memptr32" why="OPEN: LES's routine with DS0 (V20 LDS 00FC-00FE): the book's EA + 17 with six book clocks with no act before the first post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    open                                    ; OPEN: a book clock with no act (LDS EA + 17)
    open                                    ; OPEN: a book clock with no act (LDS EA + 17)
    open                                    ; OPEN: a book clock with no act (LDS EA + 17)
    open                                    ; OPEN: a book clock with no act (LDS EA + 17)
    open                                    ; OPEN: a book clock with no act (LDS EA + 17)
    open                                    ; OPEN: a book clock with no act (LDS EA + 17)
    bus=MEMR wid=WORD                       ; post the offset's read (a word)
    alu=INC2 ax=ADDR resv                   ; the address + 2 into SIGMA; the reservation (the second read)
    f wr=REG wid=WORD ws=OPR d1=ADDR s1=SIG ; F: the register <- the offset; the address register <- the address + 2
    bus=MEMR wid=WORD                       ; post the segment's read
    f wr=DS0 wid=WORD ws=OPR e              ; F: DS0 <- the segment; E

; LDEA (V20 LEA 0054-0055: the EA, then SIGMA -> R after the E row)
routine ldea op=8D mod=mem book="LDEA" why="the add, the register from the address register on the E word: the book's EA + 2 on every path but mod 00's EA book error (the head)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    wr=REG wid=WORD ws=ADDR e               ; the register <- the address (0055 SIGMA -> R); E

; ---- the group 1 memory forms (V20 GRP1 003C-0040: Q -> tmpbL, Q -> tmpbH, tmpb -> tmpa; ALU
; OPC; M -> tmpb; SIGMA -> M [-06-]): the immediate popped after the EA, then the read (silicon:
; the one-byte immediate's read a clock before the two-byte one's, v35s-chains.md F19), F with
; the group's op, the write's post, E held
routine grp1_mb op=80,82 mod=mem reg=0-6 ea=bare book="ADD mem,imm" bookv=14 diff=m00:-1,dir:+1 why="the add, the immediate's pop, the read's post, F with the group's op, the write's post, E held to its end: the book's mem8,imm8 EA + 11 (its note), its acts filling the book's EA clocks (ea=bare). mod 00: book error of one, the byte form as the word (v35s-chains.md F38: every operation and width as ADD), silicon's ADD word [BW],imm8 13 at even (a6) less the dispatch's fetch stall its method puts under the marker; the direct form +1: the two pops the book's EA 3 does not resolve"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate byte (003C Q -> tmpbL)
    bus=MEMR                                ; post the read
    f alu=GRP ax=OPR ay=IMM wf resv         ; F: the datum and the immediate; the group's ALU op, flags (W) (003E-003F); the reservation (the write follows)
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write (0040 SIGMA -> M)
    e                                       ; E: held until the write's end (RAMEN)

routine grp1_mw8 op=83 mod=mem reg=0-6 ea=bare book="ADD mem,imm" diff=m00:+1,d8:+2,d16:+2,dir:+3 why="the add, the immediate's pop, the read's post, F with the group's op (the immediate sign-extended), the write's post, E held: the book's mem16,imm8 EA + 9: the read posted after the immediate's pop (silicon: v35s-chains.md F19, the one-byte immediate's read a clock before the two-byte one's: the pop precedes the read) is one clock past the book at mod 00 (+1, a named act); the displacement's pops the book's EA does not resolve: d8 +2, d16 +2, the direct form +3 (no OPEN word: ea=bare)"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate byte (003C Q -> tmpbL)
    bus=MEMR                                ; post the read
    f alu=GRP ax=OPR ay=IMM wf resv         ; F: the datum and the immediate (sign-extended); the group's ALU op, flags (W); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine grp1_mw op=81 mod=mem reg=0-6 ea=bare book="ADD mem,imm" bookv=15 diff=m00:-1,dir:+1 why="the add, the immediate's two pops, the read's post, F with the group's op, the write's post, E held: the book's mem16,imm16 EA + 12 (its note), its acts filling the book's EA clocks (ea=bare). mod 00: book error of one, silicon's ADD [BW],imm16 15 (v35s-chains.md F5) less the dispatch's fetch stall its method puts under the marker: 14; the direct form +1: the two pops the book's EA 3 does not resolve"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate's low byte (003C)
    pop=ih                                  ; pop its high byte (003D)
    bus=MEMR                                ; post the read
    f alu=GRP ax=OPR ay=IMM wf resv         ; F: the datum and the immediate; the group's ALU op, flags (W); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine grp1_mcb op=80,82 mod=mem reg=7 book="CMP mem,imm" width=byte why="the add, the immediate's pop, the read, F with CMP, E (no write): the book's mem8,imm8 EA + 8"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate byte
    bus=MEMR                                ; post the read
    f alu=GRP ax=OPR ay=IMM wf              ; F: the datum and the immediate; CMP, flags (W)
    e                                       ; E: the write-back word, its write suppressed (CMP)

routine grp1_mcw8 op=83 mod=mem reg=7 book="CMP mem,imm" width=word why="OPEN: the add, the immediate's pop, the read, F with CMP, E: the book's mem16 EA + 9 with one book clock with no act before the post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate byte (sign-extended)
    open                                    ; OPEN: a book clock with no act (CMP mem16,imm8 EA + 9)
    bus=MEMR                                ; post the read
    f alu=GRP ax=OPR ay=IMM wf              ; F: the datum and the immediate; CMP, flags (W)
    e                                       ; E: the write-back word, its write suppressed (CMP)

routine grp1_mcw op=81 mod=mem reg=7 book="CMP mem,imm" width=word why="the add, the immediate's two pops, the read, F with CMP, E: the book's mem16 EA + 9"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate's low byte
    pop=ih                                  ; pop its high byte
    bus=MEMR                                ; post the read
    f alu=GRP ax=OPR ay=IMM wf              ; F: the datum and the immediate; CMP, flags (W)
    e                                       ; E: the write-back word, its write suppressed (CMP)

; ---- the unary group's memory forms (V20 0170-0175: M -> tmpb; the op; SIGMA -> M [-06-])
routine inc_m op=FE,FF mod=mem reg=0 book="INC mem (word)" why="OPEN: the add, the read, F with +1, the write's post, E held to its end: the book's EA + 13 with two book clocks with no act between the datum and the write's post"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f alu=INC ax=OPR wf resv                ; F: the datum + 1, flags but CY (W); the reservation (the write follows)
    open                                    ; OPEN: a book clock with no act (INC mem EA + 13)
    open                                    ; OPEN: a book clock with no act (INC mem EA + 13)
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine dec_m op=FE,FF mod=mem reg=1 book="DEC mem (word)" why="OPEN: INC's routine with -1: the book's EA + 13 with two book clocks with no act"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f alu=DEC ax=OPR wf resv                ; F: the datum - 1, flags but CY (W); the reservation
    open                                    ; OPEN: a book clock with no act (DEC mem EA + 13)
    open                                    ; OPEN: a book clock with no act (DEC mem EA + 13)
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine not_m op=F6,F7 mod=mem reg=2 book="NOT mem" why="OPEN: INC's routine with the complement (no flags): the book's EA + 13 with two book clocks with no act"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f alu=NOT ax=OPR resv                   ; F: the datum's complement (no flags); the reservation
    open                                    ; OPEN: a book clock with no act (NOT mem EA + 13)
    open                                    ; OPEN: a book clock with no act (NOT mem EA + 13)
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

routine neg_m op=F6,F7 mod=mem reg=3 book="NEG mem" why="OPEN: INC's routine with 0 - the datum: the book's EA + 13 with two book clocks with no act"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    f alu=NEG ax=OPR wf resv                ; F: 0 - the datum, flags (W); the reservation
    open                                    ; OPEN: a book clock with no act (NEG mem EA + 13)
    open                                    ; OPEN: a book clock with no act (NEG mem EA + 13)
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)

; TEST mem,imm (F6 / F7 /0, /1 its alias; not in the book's table)
routine test_mib op=F6 mod=mem reg=0-1 why="TEST mem8,imm8 (not in the book's table): the add, the immediate's pop, the read, F with the AND, E"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate byte
    bus=MEMR                                ; post the read
    f alu=AND ax=OPR ay=IMM wf              ; F: the datum AND the immediate, flags (W)
    e                                       ; E (TEST writes nothing)

routine test_miw op=F7 mod=mem reg=0-1 why="TEST mem16,imm16 (not in the book's table): as the byte form with the second immediate byte"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    pop=il                                  ; pop the immediate's low byte
    pop=ih                                  ; pop its high byte
    bus=MEMR                                ; post the read
    f alu=AND ax=OPR ay=IMM wf              ; F: the datum AND the immediate, flags (W)
    e                                       ; E (TEST writes nothing)

; ---- multiply and divide, memory operand: the read, F into the register form's operand, its
; loop (loop.uasm: the one-bit-a-word loops, the finish, the writes) through a jump to the
; loop's label (the acts after the operand are the register form's)
routine mulu_m16 op=F7 mod=mem reg=4 book="MULU mem16" why="OPEN: the add, the read, AW into tmpa under the cycle, F with the multiplier's load (the datum), the register form's loop, finish and writes (loop.uasm mu16_l, by a jump): the book's EA + 33 with eight book clocks with no act before the loop"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    ra=AW wid=WORD d1=TA s1=RA              ; AW into tmpa (0179)
    f alu=MULI ax=TA ay=OPR cnt=BITS        ; F: the multiplier (the datum) loaded; the counter <- 16 (017B)
    open                                    ; OPEN: a book clock with no act (MULU mem16 EA + 33)
    open                                    ; OPEN: a book clock with no act (MULU mem16 EA + 33)
    open                                    ; OPEN: a book clock with no act (MULU mem16 EA + 33)
    open                                    ; OPEN: a book clock with no act (MULU mem16 EA + 33)
    open                                    ; OPEN: a book clock with no act (MULU mem16 EA + 33)
    open                                    ; OPEN: a book clock with no act (MULU mem16 EA + 33)
    open                                    ; OPEN: a book clock with no act (MULU mem16 EA + 33)
    open jmp=mu16_l                         ; OPEN: a book clock with no act (MULU mem16 EA + 33); to the register form's loop

routine mulu_m8 op=F6 mod=mem reg=4 book="MULU mem8" width=byte why="OPEN: as the word form into the byte loop (loop.uasm mu8_l): the book's EA + 27 with eleven book clocks with no act before the loop"
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read
    ra=AW wid=WORD d1=TA s1=RA              ; AL (AW) into tmpa
    f alu=MULI ax=TA ay=OPR cnt=BITS        ; F: the multiplier (the datum) loaded; the counter <- 8
    open                                    ; OPEN: a book clock with no act (MULU mem8 EA + 27)
    open                                    ; OPEN: a book clock with no act (MULU mem8 EA + 27)
    open                                    ; OPEN: a book clock with no act (MULU mem8 EA + 27)
