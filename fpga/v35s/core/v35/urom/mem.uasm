; MX1 the memory forms (docs/v35s-mechanisms.md sections 3.3, 3.5, 3.6). A ModR/M memory
; routine (mod=mem) is entered from its EA head (ea.uasm: the displacement's pops and, ea=book,
; the book's EA clock) with its first word the EA's add: base (port A) + index (port B) + the
; displacement into the address register (the default segment: a prefix's, else SS for a BP
; mode, else DS0). The add uses both RAM read ports, and the request's address is the segment
; + the address register as a register (the add's 3-input sum into a request address in one
; tick is too long a chain: README "MX1"), so a request is posted on a word after the add.
; A load posts the read and the F word takes the datum (the odd word's pair is the bus unit's);
; a store moves the datum into OPRW and posts the write, its E held to the cycle's end with
; RAMEN = 1 (the hold); a read-modify-write posts the read, F, the ALU, the write's post, E
; held. The reservation rises on the add (the routine knows it will post; the displacement is
; popped). The shape follows the V20 routine (V20UC.TXT) where one exists, never its counts.
; Every length is the data book's formula at each path's EA (m00 3, d8 3, d16 4, dir 3) plus
; the declared difference; an OPEN word is a book clock no act names.

; ---- loads (V20 MOV_RM 004C-004D, the load direction: M -> tmpa, tmpa -> R)
routine ld diff=d16:-1 op=8A,8B mod=mem ea=q book="MOV reg,mem" why="book error of one at mod 10 (the book's EA 4; the qprobe ld16 runs: MOV AW,[BW+d16] in the four words of every mode); OPEN: (qprobe round 6) MOV r,mem is `P Y . DN .`, `P Y . P DN .`, `P Y . PP DN .` (the qprobe lbw, lbi, ld8, ld16, ldir runs; model_m.py L_*): the measured heads (ea=q, ea.uasm: the ModR/M byte released on word 1, the request word Y on word 2, the add on word 3, the displacement released on word 4), the read's post on word 5 (Y + 3), D: F with the register's write and N, the boundary; book error where the routine is shorter, silicon longer than the book where it is longer"
    bus=MEMR                                ; post the read (Y + 3: granted on Y + 4, or later)
    f wr=REG ws=OPR e ro                    ; D: F: the register <- the datum (004C-004D); E; N
; ---- load + ALU (V20 ALU_RM 0000-0001: M -> tmpb, R -> tmpa; ALU OPC; SIGMA -> R)
routine ld_alu op=02,03,0A,0B,12,13,1A,1B,22,23,2A,2B,32,33 mod=mem ea=q book="ADD reg,mem" diff=d16:-1 why="(qprobe round 8, Q19) ADD AW,[BW] is the load, `P Y . DN .` (the qprobe rw-addm runs, 12 / 12 in the model): the measured heads (ea=q: the request word on word 2, the add, the displacement released on word 4), the read's post (Y + 3), D N (F: the register and the datum, the block's ALU op, flags, E), the write after it; the other ALU ops and EA modes by analogy (measured: ADD AW,[BW]); book error of one at mod 10 (the heads' EA, as MOV r,mem); before round 8: the add, the post, five clocks no act names, F, the write on the E word (F5-push-add_aw_m-k2-pE-w0)"
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=GRP ax=RA ay=OPR wf e      ; D: F: the register and the datum; the block's ALU op, flags (W) (0000); E; N
    wr=REG ws=SIG                           ; post-E: the register <- SIGMA (0001)
routine cmp_rm op=3A,3B mod=mem ea=q book="CMP reg,mem" diff=d16:-1 why="(qprobe round 8, Q19) CMP AW,[BW] is the load, `P Y . DN .` (the qprobe rw-cmpm runs, 12 / 12 in the model): the measured heads (ea=q), the read's post (Y + 3), D N (F: CMP, flags, E); the byte form and the other EA modes by analogy; book error of one at mod 10 (the heads' EA); before round 8: ADD reg,mem's routine with its write suppressed (F5-push-cmp_aw_m-k2-pE-w0)"
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=GRP ax=RA ay=OPR wf e      ; D: F: the register and the datum; CMP, flags (W); E; N

; ---- read-modify-write (V20 ALU_RM with the memory destination: SIGMA -> M [-06-])
routine rmw diff=m00:+2,d8:+2,d16:+1,dir:+2 op=01 mod=mem ea=q book="ADD mem,reg" why="OPEN: silicon longer than the book (measured, the qprobe shapes below; the extra words OPEN): (qprobe round 8, Q19) ADD [BW],AW is `P Y . . DZ N` and ADD [BW+d8],AW `P Y . P DZ N` (the qprobe rw-add / rw-add8 / rmw runs): the read as a load (the measured heads, ea=q: the request word on word 2), D (F: the datum and the register, the ALU op, flags), the write's post on the word after it (Z: the write two clocks after the datum word: the address is already the bus unit's, the second request skips the two clocks a first one spends handing it over), E (an on-chip store holds it to the write's end: RAMEN), N on the boundary word (the model's: released when the dispatch executes, on the write's last clock: rule 7, E_PEND). Measured: [BW] and [BW+d8] with a register source (op 01); the other EA modes by analogy (Q18's rule: the heads; they share the routine); the byte form and the other ALU ops keep the round-6 routine (rmw_b); beyond the book in the book check's machine (E held to the write's end: the on-chip timing; the heads' request word); before round 8: the add, the read's post (S+4), F, the write's post, E held (F5-push-add_m_aw-k2-pE-w0)"
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=GRP ax=OPR ay=RA wf        ; D: F: the datum and the register; the ALU op, flags (W) (0000)
    d1=OPRW s1=SIG bus=MEMW                 ; Z: the result into the write datum; post the write (0001 SIGMA -> M: the write two clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock; an on-chip store holds it to the write's end (RAMEN)

routine rmw_b diff=m00:+1,d8:+1,d16:+1,dir:+1 op=00,08,09,10,11,18,19,20,21,28,29,30,31 mod=mem book="ADD mem,reg" why="(qprobe round 8: the round-6 routine kept for the byte form and the other ALU ops; the measured ADD [mem],AW shape is rmw's, op 01 only: by analogy these lost corpus runs) OPEN: the add, the read's post, F with the ALU (0000), the write's post (0001: the write two clocks after the datum), E held to its end (RAMEN) (F5-push-add_m_aw-k2-pE-w0: S 95, P:read 100, the write 105, S-to-S 13: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (S+3 at mod 00); the reservation
    bus=MEMR                                ; post the read (S+4: it issues at S+5 on a free bus, the model's P:read)
    f ra=REG alu=GRP ax=OPR ay=RA wf        ; F: the datum and the register; the ALU op, flags (W) (0000); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write (0001 SIGMA -> M)
    e                                       ; E: held until the write's end (RAMEN)

routine cmp_mr op=38,39 mod=mem ea=q book="CMP mem,reg" diff=m00:+2,d8:+2,d16:+1,dir:+2 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 15, spec 11 B) CMP mem,reg is `P Y . D . N .` (the qprobe cmpmr / cmpmr8 runs, 48 / 48 in the model): the measured heads (ea=q), the read (Y + 3), D (F with CMP), a word, E with N; OPEN: the read, five clocks no act names under the cycle, F with CMP on the clock before E (no write) (as F5-push-cmp_aw_m-k2-pE-w0: S-to-S 11: the frozen model's read, write, takes and next S); book error where the routine is shorter, silicon longer than the book where it is longer (the frozen model exact on the run)"
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=GRP ax=OPR ay=RA wf        ; D: F: the datum and the register; CMP, flags (W)
    open                                    ; OPEN: (qprobe round 15) a word with no act
    e ro                                    ; E: the write suppressed (CMP); N
; TEST mem,reg (V20 TEST_RM 0044-0045: M -> tmpa, R -> tmpb; AND; SIGMA -> NULL)
routine test_m8 diff=m00:-3,d8:-2,d16:-2,dir:-1 op=84 mod=mem ea=bare book="TEST mem,reg" width=byte why="OPEN: book error where the routine is shorter (silicon's measured shape below): (qprobe round 9, Q25) TEST [BW],AW is `P . B Y DN .` (the qprobe testm runs, 24 / 24 in the model): TEST r,r's bus-idle third word, then a load: the add (the ModR/M byte released by the loader), a word with no act, B (bus-idle: waits while a fetch's pin cycle runs), Y (the request word: the read due four clocks after it, posted three words later), two words with no act, the read's post (Y + 3), D N (F: AND, flags; E); measured: the word form at [BW]; the byte form and the displacement modes (the bare heads' pops before the add) by analogy; before round 9: the read, seven clocks no act names under the cycle, F with the AND on the clock before E (F5-push-test_m_aw-k2-pE-w0)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bi                                      ; (qprobe round 9, Q25) B: TEST's bus-idle third word (waits while a fetch's pin cycle runs)
    rl=x bi                                 ; (qprobe round 9) Y: the request word (the read due four clocks after it, posted three words later)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=AND ax=OPR ay=RA wf e ro   ; D N: F: the datum and the register; AND, flags (W) (0044); E (TEST writes nothing); N
routine test_m16 diff=m00:-2,d8:-1,d16:-1 op=85 mod=mem ea=bare book="TEST mem,reg" width=word why="OPEN: book error where the routine is shorter (silicon's measured shape below): (qprobe round 9, Q25) TEST [BW],AW is `P . B Y DN .` (the qprobe testm runs, 24 / 24 in the model): TEST r,r's bus-idle third word, then a load: the add (the ModR/M byte released by the loader), a word with no act, B (bus-idle: waits while a fetch's pin cycle runs), Y (the request word: the read due four clocks after it, posted three words later), two words with no act, the read's post (Y + 3), D N (F: AND, flags; E); measured: the word form at [BW]; the byte form and the displacement modes (the bare heads' pops before the add) by analogy; before round 9: the read, seven clocks no act names under the cycle, F with the AND on the clock before E (F5-push-test_m_aw-k2-pE-w0)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bi                                      ; (qprobe round 9, Q25) B: TEST's bus-idle third word (waits while a fetch's pin cycle runs)
    rl=x bi                                 ; (qprobe round 9) Y: the request word (the read due four clocks after it, posted three words later)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG alu=AND ax=OPR ay=RA wf e ro   ; D N: F: the datum and the register; AND, flags (W) (0044); E (TEST writes nothing); N
; XCH mem,reg (V20 XCHG_RM 0048-004A: M -> tmpa, R -> tmpb; tmpa -> R [-06-]; tmpb -> M)
routine xch_m diff=m00:+2,d8:+2,d16:+1,dir:+2 op=86,87 mod=mem ea=q book="XCH mem,reg" why="OPEN: silicon longer than the book (measured; the extra words OPEN): (qprobe round 9, Q25) XCH [BW],AW is `P Y . . D . Z G N .` (the qprobe xchm runs, 24 / 24 in the model): the read as a load (the measured heads, ea=q: the request word on word 2), the read's post (Y + 3), D (F: the register into the write datum, the datum into the register, 0048-0049), two words with no act, Z (the write's post: the write four clocks after the datum word, ADD [BW],r's two later), E with N (G N: a bus-idle word, it waits while a fetch's pin cycle runs: the posted write wins the bus on the first clock no fetch runs, so N is released on the write's first clock; an on-chip store holds it to the write's end: RAMEN); measured: the word form at [BW]; the byte form and the other EA modes by analogy (the heads); before round 9: the read, F, three clocks no act names, the write's post, E held (F5-push-xch_m_aw-k2-pE-w0)"
    bus=MEMR                                ; post the read (Y + 3)
    f ra=REG d1=OPRW s1=RA wr=REG ws=OPR    ; D: F: the register into the write datum (0048), the datum into the register (0049)
    open                                    ; OPEN: (qprobe round 9) a word with no act
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bus=MEMW                                ; Z: post the write (004A tmpb -> M: four clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock; an on-chip store holds it to the write's end (RAMEN)

; ---- stores (V20 MOV_RM 004C-004D, the store direction: R -> tmpa, tmpa -> M; the operand
; pre-read suppressed, pla_3 MODRM_STORE)
routine st diff=m00:+2,d8:+2,d16:+1,dir:+2 op=88,89 mod=mem ea=q book="MOV mem,reg" why="beyond the book: a named act, the request word (Y) and the post on words of their own (the qprobe sbw, sd8, sdir runs); beyond the book by two at EA 3 and one at mod 10 in the book check's machine (E held to the write's end: the on-chip timing, the post and E on words of their own); OPEN: (qprobe round 6) MOV mem,r is `P Y . N`, `P Y . P N`, `P Y . PP N` (the qprobe sbw, sd8, sdir runs; model_m.py S_*): the measured heads (ea=q), the register's read with the post on word 5 (Y + 3), E, the boundary with N (the model's last word) on the write's last clock (rule 7, E_PEND); book error where the routine is shorter, silicon longer than the book where it is longer"
    ra=REG d1=OPRW s1=RA bus=MEMW           ; the register into the write datum (004C); post the write (004D)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock; an on-chip store holds it to the write's end (RAMEN)

; MOV mem,imm (C6 / C7 /0): the immediate popped after the EA (the V20's routine pops it after
; the loader's EA), into the write datum, the post
routine st_imm8 diff=m00:+2,dir:+4,d8:+3,d16:+3 op=C6 mod=mem reg=0,1,2,3,4,5,6,7 ea=bare book="MOV mem,imm" width=byte why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 11, Q33) MOV mem8,imm8 is `P . V . . . KPN .` (the qprobe w-* / stib runs): the add (P), the immediate's pop (released at K), V (the late request word: the write due four clocks after it), two words with no act, the immediate into the write datum with the write's post, E: K P N (the immediate released, the next opcode); the displacement modes by analogy (the bare heads); A2's unarmed write (the chained fetch first while the datum is not taken) not built"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P); the reservation
    pop=il                                  ; pop the immediate byte (released on E)
    rl=x bi alt                             ; (qprobe round 11, Q33) V: the late request word (the write due four clocks after it)
    open call=w1                            ; OPEN: (qprobe round 11) two words with no act (the call and the shared delay's 1)
    d1=OPRW s1=IMM bus=MEMWD                ; (qprobe round 12, spec 7 A2) the immediate into the write datum; post the write (V + 3), not armed (MEMWD: it competes from K on)
    d1=OPRW s1=IMM e ro rl=1                ; E: K P N: the immediate into the write datum (the write armed: K), the immediate and the next opcode released (the write's first clock); held until the write's end (RAMEN)

routine st_imm16z diff=m00:3 op=C7 mod=mem paths=m00 reg=0,1,2,3,4,5,6,7 ea=bare book="MOV mem,imm" width=word why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 9, Q25, item C) MOV word [BW],imm16 and [BW+IX],imm16 are `P . . BY . . . PPN .` (the qprobe rw-movi / stibi runs; model_m.py STIM): the add (the ModR/M byte released by the loader), two words with no act, BY (bus-idle: waits while a fetch's pin cycle runs; it is the request word too: the write due four clocks after it), the immediate's two pops, the datum with the post (Y + 3), E with the immediate's two bytes and the next opcode released (PPN, on the write's first clock: the post's grant); the immediate's pops before their release (the boundary waited for three bytes behind C7: m3); the modes without a displacement only (mod 00 but the direct address): the displacement modes and the byte form are not read (st_imm16, st_imm8), so C7's entry depends on the whole ModR/M byte (a whole opcode of the split second-level decode)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P); the reservation
    open                                    ; OPEN: (qprobe round 9) a word with no act
    open                                    ; OPEN: (qprobe round 9) a word with no act
    bi                                      ; (qprobe round 9) BY: bus-idle (waits while a fetch's pin cycle runs, its last clock included: so never on a fetch's last clock, where a request word's REQ_PRI would act); the write due four clocks after it
c7_i: pop=il                                  ; pop the immediate's low byte (released on E)
    pop=ih                                  ; pop its high byte (released on E)
    d1=OPRW s1=IMM bus=MEMWD                ; (qprobe round 12, spec 7 A2) the immediate into the write datum; post the write (Y + 3), not armed (MEMWD: it competes from K on)
    d1=OPRW s1=IMM e ro rl=2                ; E: K P P2 N: the immediate into the write datum (the write armed: K), its two bytes and the next opcode released (the write's first clock); held until the write's end (RAMEN)

; MOV mem16,sreg / MOV sreg,mem16 (V20 MOV_SREG 0050: R -> M [-06-] [E])
routine st_sr op=8C mod=mem ea=bare book="MOV mem16,sreg" diff=m00:+2,d8:+3,d16:+3,dir:+4 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 14, spec 10 B) MOV mem,sreg is `P . V . G N .` (the qprobe movms runs, [BW]; the other modes behind the bare heads): the add (P), a word, V (the late request word), the register into the datum, a word, the post (V + 3), E G N; the add, the segment register's read with the post, E held to the write's end: the book's EA + 6"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 14) a word with no act
    rl=x bi alt                             ; (qprobe round 14) V: the late request word (the write due four clocks after it)
    rb=SREG wid=WORD d1=OPRW s1=RB          ; the segment register into the write datum
    open                                    ; OPEN: (qprobe round 14) a word with no act
    bus=MEMW wid=WORD                       ; post the write (V + 3: a word)
    e ro bi                                 ; E: G N (bus-idle); an on-chip store holds it to the write's end (RAMEN)

routine ld_sr op=8E mod=mem ea=q book="MOV sreg,mem16" diff=m00:-1,d8:-1,d16:-2,dir:-1 why="OPEN: book error where the measured routine is shorter than the book: (qprobe round 14, spec 10 B) MOV sreg,mem is `P Y . DN . .` with MOV sreg's lead of two (the qprobe movsm runs, [BW]): the heads (ea=q), the read (Y + 3), D N (the segment register from the datum, the next opcode released), a word, E; OPEN: book error of one: the book's EA + 9 against silicon's MOV DS1,[BW] 11 (a6, docs/v35s-mechanisms/classes.md LOAD_SEG) less the dispatch's fetch stall its method puts under the marker: 10 at mod 00 with the head's book error; the add, the post, the cycle, F: the segment register from the datum on the E word; two book clocks with no act before the post"
    bus=MEMR wid=WORD                       ; post the read (Y + 3: a word)
    f wr=SREG wid=WORD ws=OPR ro            ; D N: F: the segment register <- the datum (RAM and the segment flop); the next opcode released
    e nb                                    ; E; (F3) nb: no interrupt or single step at the next instruction's start (f3_step)

; LDS / LES (V20 LES 00F8-00FA: OPR -> R, SIGMA -> tmpb, ALU INC2 [F]; SIGMA -> IND, MEMR;
