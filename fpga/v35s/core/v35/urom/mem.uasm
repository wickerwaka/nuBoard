; ---- the memory shifts (mechanisms 3.4; docs/v35s-eu-timing.md: the operand read once and
; written once, the loop on a temporary, two words a count as the register form): the read,
; F into the shifter, the loop, the write's post with the flags, E held
routine shm_1 diff=m00:+4,d8:+5,d16:+5,dir:+6 op=D0,D1 mod=mem ea=bare book="SHL mem,1" why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 11) SHL / SHR / ... [BW],1 is `P . B Y D . . . . . Z G N .` (the qprobe shlm1 runs): the add (P), a word with no act, B (the bus-idle third word), Y (the request word), two words with no act, the read's post, F with the shifter's load (D), the step, the result into the write datum with the flags, four words with no act, the write's post (Z: six words after the datum), E bus-idle (G N); the displacement modes by analogy (the bare heads)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 11) a word with no act
    bi                                      ; (qprobe round 11) B: the bus-idle third word
    rl=x bi                                 ; (qprobe round 11) Y: the request word (the read due four clocks after it, posted three words later)
    open call=w1                            ; OPEN: (qprobe round 11) two words with no act (the call and the shared delay's 1)
    bus=MEMR                                ; post the read (Y + 3)
    f alu=SHI ax=OPR                        ; D: F: the shifter loaded from the datum with CY
    alu=SH1 ax=SIG                          ; the one step
    d1=OPRW s1=SIG alu=SHF ax=SIG wf        ; the result into the write datum; the shift's flags (W)
    open call=w3                            ; OPEN: (qprobe round 11) four words with no act (the call and the shared delay's 3)
    bus=MEMW                                ; Z: post the write (the datum + 7)
    e ro bi                                 ; E: (Q23) G N: the next opcode released on the write cycle's first clock (bus-idle); an on-chip store holds it to the write's end (RAMEN)

routine shm_cl op=D2,D3 mod=mem ea=bare book="SHL mem,CL" n=4 diff=m00:+3,d8:+4,d16:+4,dir:+5 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 14, Q46, spec 10 B) SHL mem,CL is `P . . B . . . Y D`, 3 + 2n words, `Z G N .` (the qprobe shmcl / shmbcl / shmcl1 / shmcl8 runs, [BW]; the other modes by the mode rules behind the bare heads): the add (P), two words with no act, B (the bus-idle fourth word), three words, Y (the request word: the read posted three words later), D (F with the shifter's load), two words and the zero test, the two-word iteration, Z (the write's post with the flags), G N; the add, the read, CL into the counter under the cycle, F with the shifter's load, the zero test, the two-word iteration, the write's post with the flags (the count 0: the datum written back, no flags), E held: the book's EA + 19 + 2n with seven book clocks with no act before the zero test"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P)
    open call=w1                            ; OPEN: (qprobe round 14) two words with no act (the call and the shared delay's 1)
    bi                                      ; (qprobe round 14) B: the bus-idle fourth word
    open call=w2                            ; OPEN: (qprobe round 14) three words with no act (the call and the shared delay's 2)
    rl=x bi                                 ; (qprobe round 14) Y: the request word (the read posted three words later)
    rb=CW cnt=RB                            ; CL into the loop counter
    open                                    ; OPEN: a word with no act
    bus=MEMR                                ; post the read (Y + 3)
    f alu=SHI ax=OPR                        ; D: F: the shifter loaded from the datum with CY
    open call=w2                            ; OPEN: (qprobe round 14) three words with no act (the call and the shared delay's 2: the model's Z is the post's word less one)
    jc=CNTZ:shmc_z                          ; a zero count skips the loop (SHIFT 0228 JMP Z): the third of the 3 + 2n words
shmc_l: alu=SH1 ax=SIG                      ; one shift step of the group's operation
    loop=shmc_l                             ; the counter step (the iteration's second word)
    d1=OPRW s1=SIG alu=SHF ax=SIG wf bus=MEMW   ; Z: the result into the write datum; the shift's flags (W); post the write
    e ro bi                                 ; E: G N: the next opcode released on the write cycle's first clock (bus-idle); an on-chip store holds it to the write's end (RAMEN)
shmc_z: e ro bi                             ; (F5b: silicon, the fuzz's first differences: f5a_011 SHR SS:[BP+IX+96h], CL with CL 0) the count 0: no write (the flags kept); E (bus-idle: not measured)

routine shm_imm op=C0,C1 mod=mem ea=bare bookx="EA+15+2n" n=4 diff=m00:+5,d8:+6,d16:+6,dir:+7 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 14, Q46, spec 10 B) SHL mem,imm8 is `P . V DP . B`, 4 + 2n words, `Z G N .` (the qprobe shmi / shmbi / shmi1 / shmi8 runs, [BW]; n the count and 1Fh; the other modes by the mode rules behind the bare heads): the add (P), the count's pop, V (the late request word), the read (V + 3), D P (F with the shifter's load; the count released), a word, B (bus-idle), three words and the zero test, the two-word iteration, Z (the write's post with the flags), G N; the add, the read, the count's pop and its load under the cycle, F with the shifter's load, the zero test, the two-word iteration, the write's post with the flags, E held: the book's EA + 15 + 2n (its ROL mem,imm8 note) with three book clocks with no act before the zero test"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P)
    pop=il                                  ; pop the count (V20 028C Q -> tmpaL; released on the datum word)
    rl=x bi alt                             ; (qprobe round 14) V: the late request word (the read due four clocks after it)
    open call=w1                            ; OPEN: (qprobe round 14) two words with no act (the call and the shared delay's 1)
    bus=MEMR                                ; post the read (V + 3)
    f alu=SHI ax=OPR rl=1                   ; D P: F: the shifter loaded from the datum with CY; the count released
    cnt=IL                                  ; the count into the loop counter
    bi                                      ; (qprobe round 14) B: bus-idle
    open call=w3                            ; OPEN: (qprobe round 14) four words with no act (the call and the shared delay's 3: the model's Z is the post's word less one, Z_LAT 2 against the RTL's post-to-grant 1)
    jc=CNTZ:shmi_z                          ; a zero count skips the loop: the fourth of the 4 + 2n words
shmi_l: alu=SH1 ax=SIG                      ; one shift step
    loop=shmi_l                             ; the counter step
    d1=OPRW s1=SIG alu=SHF ax=SIG wf bus=MEMW   ; Z: the result into the write datum; the shift's flags (W); post the write
    e ro bi                                 ; E: G N (bus-idle); an on-chip store holds it to the write's end (RAMEN)
shmi_z: e ro bi                             ; (F5b) the count 0: no write (the flags kept); E (bus-idle: not measured)

; ---- the stack's memory forms
; PUSH mem16 (FF /6; V20 FF_PUSH 01CC-01CE): the read, SP - 2 under the cycle, F: the datum
; into the write datum, the write at SS:SP, E held
routine push_m diff=m00:+2 op=FF mod=mem reg=6 paths=m00 ea=bare book="PUSH mem16" why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 10, Q30) PUSH [BW] is `P . B Y D . . . Z G N .` (the qprobe pushm runs; [BW+d8] `P . . B Y P D . . . Z G N .` the same words behind the bare head's pop, its displacement released early; [d16] `P . . B Y P P2 D . . . Z G N .` one word late): the add (P), a word with no act, B (the bus-idle third word), Y (the request word), SP - 2 under the wait, a word with no act, the read's post, F (D: the datum into the write datum), SP and the address register, three words with no act, the stack write's post (Z, four words after the datum), E bus-idle (G N)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    open                                    ; OPEN: (qprobe round 10) a word with no act
    bi                                      ; (qprobe round 10) B: the bus-idle third word
    rl=x bi                                 ; (qprobe round 10) Y: the request word (the read due four clocks after it, posted three words later)
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    open                                    ; OPEN: (qprobe round 10) a word with no act
    bus=MEMR wid=WORD                       ; post the read (Y + 3: a word)
    f d1=OPRW s1=OPR                        ; D: F: the datum into the write datum
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG    ; SP <- SP - 2; the address register <- it
    open call=w2                            ; OPEN: (qprobe round 10) three words with no act (the call and the shared delay's 2)
    bus=MEMW seg=SS wid=WORD                ; Z: post the write at SS:SP (four words after the datum)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock (bus-idle); an on-chip store holds it to the write's end (RAMEN)

; POP mem16 (8F /0; V20 POP_RM 0058-005B: the EA kept, SP -> IND, MEMR SS; SIGMA -> SP; [F];
; SIGMA -> IND [-06-])
routine push_m8 op=FF mod=m01 reg=6 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (spec 6 B3; round-14 build check item 1) PUSH [BW+d8] is `P . . B Y P D . . . Z G N .` (the qprobe pushm8 / pushmx runs): the routine pops its own displacement (no EA head: FF a whole opcode) and releases it on the word after the request word; the read (Y + 3), D, the push four words after the datum, G N"
    open                                    ; OPEN: a word with no act (the ModR/M byte released by the loader: P)
    pop=dl                                  ; pop the displacement's low byte (released after Y)
    open                                    ; OPEN: a word with no act
    bi                                      ; B: the bus-idle fourth word
    ea=BI ra=BASE rb=INDEX rl=x bi       ; Y: the request word (the read posted three words later); the EA into the address register
    rl=1                                    ; P: the displacement released
    open                                    ; OPEN: a word with no act
    bus=MEMR wid=WORD                       ; post the read (Y + 3)
    f d1=OPRW s1=OPR                        ; D: F: the datum into the write datum
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG    ; SP <- SP - 2; the address register <- it
    open call=w1                            ; OPEN: two words with no act (the call and the shared delay's 1)
    bus=MEMW seg=SS wid=WORD                ; Z: post the push at SS:SP
    e ro bi                                 ; E: G N; an on-chip store holds it to the write's end (RAMEN)

routine push_m16 op=FF mod=m10 reg=6 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (spec 6 B3; round-14 build check item 1) PUSH [BW+d16] is `P . . B Y P P2 D . . . Z G N . (by analogy with [d16])` (the qprobe pushm8 / pushmx runs): the routine pops its own displacement (no EA head: FF a whole opcode) and releases it on the word after the request word; the read (Y + 3), D, the push four words after the datum, G N"
    open                                    ; OPEN: a word with no act (the ModR/M byte released by the loader: P)
    pop=dl                                  ; pop the displacement's low byte (released after Y)
    pop=dh                                  ; pop the displacement's high byte (released after Y)
    bi                                      ; B: the bus-idle fourth word
    ea=BI ra=BASE rb=INDEX rl=x bi       ; Y: the request word (the read posted three words later); the EA into the address register
    rl=2                                    ; P: the displacement released
    open                                    ; OPEN: a word with no act
    bus=MEMR wid=WORD                       ; post the read (Y + 3)
    f d1=OPRW s1=OPR                        ; D: F: the datum into the write datum
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG    ; SP <- SP - 2; the address register <- it
    open call=w1                            ; OPEN: two words with no act (the call and the shared delay's 1)
    bus=MEMW seg=SS wid=WORD                ; Z: post the push at SS:SP
    e ro bi                                 ; E: G N; an on-chip store holds it to the write's end (RAMEN)

routine push_mdir op=FF mod=m00 rm=6 reg=6 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (spec 6 B3; round-14 build check item 1) PUSH [d16] is `P . . B Y P P2 D . . . Z G N .` (the qprobe pushm8 / pushmx runs): the routine pops its own displacement (no EA head: FF a whole opcode) and releases it on the word after the request word; the read (Y + 3), D, the push four words after the datum, G N"
    open                                    ; OPEN: a word with no act (the ModR/M byte released by the loader: P)
    pop=dl                                  ; pop the displacement's low byte (released after Y)
    pop=dh                                  ; pop the displacement's high byte (released after Y)
    bi                                      ; B: the bus-idle fourth word
    ea=DISP rl=x bi       ; Y: the request word (the read posted three words later); the EA into the address register
    rl=2                                    ; P: the displacement released
    open                                    ; OPEN: a word with no act
    bus=MEMR wid=WORD                       ; post the read (Y + 3)
    f d1=OPRW s1=OPR                        ; D: F: the datum into the write datum
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG    ; SP <- SP - 2; the address register <- it
    open call=w1                            ; OPEN: two words with no act (the call and the shared delay's 1)
    bus=MEMW seg=SS wid=WORD                ; Z: post the push at SS:SP
    e ro bi                                 ; E: G N; an on-chip store holds it to the write's end (RAMEN)

routine pop_m diff=m00:+2 op=8F mod=mem reg=0,1,2,3,4,5,6,7 ea=bare paths=m00 book="POP mem16" why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 10, Q30) POP [BW] is `P . Y D . . Z G N .` (the qprobe popm runs; the displacement modes, partly read, by analogy: the bare heads): the add (P), the EA into tmpc and SP into the address register, Y (the request word: the stack read due four clocks after it), SP + 2 and SP's write under the wait, the read's post at SS:SP, F (D: the datum into the write datum, the address register <- the EA), three words with no act, the write's post (Z, three words after the datum), E bus-idle (G N)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (the ModR/M byte released by the loader: P)
    rb=SP wid=WORD d1=TC s1=ADDR d2=ADDR s2=RB  ; the EA into tmpc (0058); SP into the address register
    rl=x bi                                 ; (qprobe round 10) Y: the request word (the read due four clocks after it, posted three words later)
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    wr=SP wid=WORD ws=SIG                   ; SP <- SP + 2 (005A)
    bus=MEMR seg=SS wid=WORD                ; post the read at SS:SP (Y + 3; 0059)
    f d1=OPRW s1=OPR d2=ADDR s2=TC          ; D: F: the datum into the write datum; the address register <- the EA (005A)
    open call=w2                            ; OPEN: (qprobe round 10) three words with no act (the call and the shared delay's 2)
    bus=MEMW wid=WORD                       ; Z: post the write at the EA (the default segment; 005B; three words after the datum)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock (bus-idle); an on-chip store holds it to the write's end (RAMEN)

; (qprobe round 11-12, Q33 / spec 7 B3) POP mem with a displacement takes the displacement on the write's request word (the
; qprobe w-popd* runs, 66 / 66 each): the routine pops its own displacement (its cells are not
; memory cells: no EA head; 8F a whole opcode of the split decode) and releases it on Z's word
routine pop_m8 op=8F mod=m01 reg=0,1,2,3,4,5,6,7 why="OPEN: (qprobe round 11-12, Q33 / spec 7 B3) POP [BW+d8] is `P . Y D . . PZ G N .`: SP's read (Y, D), the displacement popped early and released on the write's request word, the EA's add after the datum"
    rb=SP wid=WORD d1=ADDR s1=RB            ; SP into the address register (the ModR/M byte released by the loader: P)
    pop=dl                                  ; pop the displacement byte (released on Z's word)
    rb=SP wid=WORD alu=INC2 ax=RB rl=x bi   ; Y: the request word (the read posted three words later); SP + 2
    wr=SP wid=WORD ws=SIG                   ; SP <- SP + 2
    open                                    ; OPEN: a word with no act
    bus=MEMR seg=SS wid=WORD                ; post the read at SS:SP (Y + 3)
    f d1=OPRW s1=OPR                        ; D: F: the datum into the write datum
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register (base + index + the displacement)
    open                                    ; OPEN: a word with no act
    rl=1                                    ; P (Z's word): the displacement released
    bus=MEMW wid=WORD                       ; Z: post the write at the EA (the default segment)
    e ro bi                                 ; E: G N; an on-chip store holds it to the write's end (RAMEN)

routine pop_m16 op=8F mod=m10 reg=0,1,2,3,4,5,6,7 why="OPEN: (qprobe round 11-12, Q33 / spec 7 B3) POP [BW+d16] is `P . Y D . . PP2Z G N .` (POP [d16]'s, by its two displacement bytes)"
    rb=SP wid=WORD d1=ADDR s1=RB            ; SP into the address register (the ModR/M byte released by the loader: P)
    pop=dl                                  ; pop the displacement's low byte
    rb=SP wid=WORD alu=INC2 ax=RB rl=x bi   ; Y: the request word (the read posted three words later); SP + 2
    pop=dh wr=SP wid=WORD ws=SIG            ; pop its high byte; SP <- SP + 2
    open                                    ; OPEN: a word with no act
    bus=MEMR seg=SS wid=WORD                ; post the read at SS:SP (Y + 3)
    f d1=OPRW s1=OPR                        ; D: F: the datum into the write datum
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    open                                    ; OPEN: a word with no act
    rl=2                                    ; P P2 (Z's word): the displacement released
    bus=MEMW wid=WORD                       ; Z: post the write at the EA (the default segment)
    e ro bi                                 ; E: G N; an on-chip store holds it to the write's end (RAMEN)

routine pop_md op=8F mod=m00 rm=6 reg=0,1,2,3,4,5,6,7 why="OPEN: (qprobe round 11-12, Q33 / spec 7 B3) POP [d16] is `P . Y D . . PP2Z G N .` (the qprobe w-popdir runs)"
    rb=SP wid=WORD d1=ADDR s1=RB            ; SP into the address register (the ModR/M byte released by the loader: P)
    pop=dl                                  ; pop the direct address's low byte
    rb=SP wid=WORD alu=INC2 ax=RB rl=x bi   ; Y: the request word (the read posted three words later); SP + 2
    pop=dh wr=SP wid=WORD ws=SIG            ; pop its high byte; SP <- SP + 2
    open                                    ; OPEN: a word with no act
    bus=MEMR seg=SS wid=WORD                ; post the read at SS:SP (Y + 3)
    f d1=OPRW s1=OPR                        ; D: F: the datum into the write datum
    ea=DISP                                 ; the address register <- the direct address
    open                                    ; OPEN: a word with no act
    rl=2                                    ; P P2 (Z's word): the direct address released
    bus=MEMW wid=WORD                       ; Z: post the write at the direct address (DS0 or the prefix's)
    e ro bi                                 ; E: G N; an on-chip store holds it to the write's end (RAMEN)
