    pop=dh                                  ; pop its high byte
    ea=DISP bi rl=0 jmp=tm16_y                  ; (rl=0: the routine names its releases, the d16 cell's) B: TEST's bus-idle third word; the EA into the address register; then the d16 cell's words

routine test_miw_d8 op=F7 mod=m01 reg=0-1 why="OPEN: (qprobe round 20, spec 16 B, Q90) TEST word [BW+d8],imm16 is `P . B . . BYP DPP2 . BN .` (QPr20a testi8, 42 / 42 in the model): TEST [BW],imm16's head, the request word on word 6 releasing the displacement (a reserving request, spec 13 A1)"
