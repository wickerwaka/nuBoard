; ---- the unary group's memory forms (V20 0170-0175: M -> tmpb; the op; SIGMA -> M [-06-])
routine inc_m op=FE,FF mod=mem reg=0 ea=bare paths=m00 diff=m00:+2 book="INC mem (word)" why="OPEN: (qprobe round 8, Q19 / Q20) INC word [BW] is `P . . B Y . . DZ N` (measured: INC word [BW], the qprobe rw-incm runs; the byte form, the other unary ops and EA modes by analogy, the displacement's pops in the bare heads before it): the add (the ModR/M byte released by the loader), two words with no act, B (the group's bus-idle fourth word: waits while a fetch's pin cycle runs), Y (the request word: the read due four clocks after it, posted three words later), two words with no act, the read's post, D (F: the operation on the datum), Z (the write's post on the word after the datum word: the write two clocks after it), E (an on-chip store holds it to the write's end: RAMEN), N on the boundary word; beyond the book in the book check's machine (E held to the write's end: the on-chip timing; the bare heads' pops at d8, d16 and the direct address); before round 8: the add, the read's post (S+4), F, the write's post, E held (F5-push-inc_m-k2-pE-w0)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register
    open                                    ; OPEN: (qprobe round 8) a word with no act
    open                                    ; OPEN: (qprobe round 8) a word with no act
    bi                                      ; (qprobe round 8, Q20) B: the group's bus-idle word (waits while a fetch's pin cycle runs)
    rl=x bi                                 ; (qprobe round 8) Y: the request word (the read due four clocks after it, posted three words later)
    open                                    ; OPEN: (qprobe round 8) a word with no act
    open                                    ; OPEN: (qprobe round 8) a word with no act
    bus=MEMR                                ; post the read (Y + 3)
incm_f: f ee alu=INC ax=OPR wf               ; D: F: the operation on the datum ; ee (WO46): the early end (RAMEN 0: this word is E, the next word the dispatch)
    d1=OPRW s1=SIG bus=MEMW                 ; Z: the result into the write datum; post the write (two clocks after the datum word)
    e ro bi                                 ; E: (qprobe round 9, Q23) G N: the next opcode released on the write cycle's first clock: a bus-idle word (it waits while a fetch's pin cycle runs, its last clock included); the write posted on the word before wins the bus on the first clock no fetch runs, so this word executes on that clock; an on-chip store holds it to the write's end (RAMEN)

