; MX0 loop routines, register forms ((MX0d) every length the data book's formula; OPEN a book
; clock no act names): the shifts (one step a word, the V35's iteration two words:
; mechanisms 3.4, classes.md SHIFT_CL / SHIFT_IMM) and the multiply / divide (one bit a word,
; V20 0178-017F / 0188-0193). The count is loaded by a word from CL (port B), the immediate or
; the operand's width; the zero count skips the loop (V20 SHIFT 0228 JMP Z).

; D2 / D3: SHL r,CL (V20 0118-011B, SHIFT 0228-022B). Measured 10 (n = 0), 12 + 2n (n >= 1)
routine shift_cl op=D2,D3 mod=reg book="SHL reg,CL" n=4 diff=1 why="OPEN: (qprobe rule 6) silicon's 12 + 2n, the book's 11 + 2n and the fourth word a B word of its own (it waits while a fetch cycle runs: the qprobe SHL AW,CL runs, CL = 31, 74 clocks, all exact); before qprobe: the book's 11 + 2n, 9 at n = 0; silicon's 12 + 2n (docs/v35s-eu-timing.md M5; F3-push-shl_cl4-k4-pE-w0 S-to-S 20, the frozen model exact) is the book's and the take sync's wait (MX1f: the ModR/M pop on E arms it, the read waits for the word the pop's room asked for, its delivery at E+3 on a fetch issued on E; F3-push-nop-k4-pE-w0 +112 S-to-S 74, the model's exec clocks from the delivery); the read, CL's count, the shifter's load from tmpb on a word of its own, the zero test, the two-word iteration, the write with the flags, E; the book's four clocks with no act (three on both paths, one on the loop's)"
    rb=RM d1=TB s1=RB                       ; the operand into tmpb (V20 0118 M -> tmpb)
    rb=CW cnt=RB                            ; CL into the loop counter (0119-011A)
    alu=SHI ax=TB                           ; the shifter loaded from tmpb with CY
    rl=x                                    ; (qprobe round 6, B) S: the fourth word waits while the bus unit's slot is taken
    open call=w2                            ; OPEN: 3 clocks: a book clock with no act (SHL reg,CL 11 + 2n) (the call and the shared delay's 2)
    jc=CNTZ:shcl_z                          ; a zero count skips the loop and the write (SHIFT 0228 JMP Z)
shcl_l: alu=SH1 ax=SIG                      ; one shift step of the group's operation (0229's R row)
    loop=shcl_l                             ; the counter step (the V35's second word of the iteration)
    open                                    ; OPEN: a book clock with no act (SHL reg,CL 11 + 2n)
    wr=RM ws=SIG alu=SHF ax=SIG wf          ; the result written; the shift's flags (W) (022A)
shcl_z: e ro                                ; E: pop the next opcode (022B); (qprobe round 6) N

; C0 / C1: SHL r,imm8 (V20 028C-028F): the count popped. Measured as the CL form
routine shift_imm op=C0,C1 mod=reg book="SHL reg,imm8" n=4 diff=2 why="silicon longer than the book (measured, the extra words OPEN): OPEN: (qprobe round 9, Q24) SHL / SHR / SAR r,imm8 is the CL form's routine, 12 + 2n words, with its own head (the qprobe shli1 / shli2 / shli4 / shli8 / shlbi4 / sari4 runs, 23 / 24 each in the model; model_m.py SHLI_AS_CL): the operand into tmpb (the ModR/M byte released by the loader on word 1), the shifter's load, a word with no act, the count byte popped and released on word 4, a word with no act, the count into the loop counter, S on word 7 (round 23, spec 18 A2: the commit word C) (the CL form's fourth-word wait: the bus unit's slot; three words after the routine's last queue byte, as the CL form's is three after its ModR/M byte), the zero test, the two-word iteration, a book clock with no act, the write with the flags, E with N; the book's 9 + 2n: silicon's 12 + 2n; before round 9: the count popped at S+3 after one OPEN word, 18 against silicon's 20 at n = 4 (F3-push-shl_imm4-k4-pE-w0)"
    rb=RM d1=TB s1=RB                       ; the operand into tmpb (028D) (the ModR/M byte released by the loader: P)
    alu=SHI ax=TB                           ; the shifter loaded with CY
    open                                    ; OPEN: (qprobe round 9) a word with no act
    pop=il rl=1 bi                          ; pop the count (V20 028C Q -> tmpaL) and release it (P, word 4); (qprobe round 20, spec 16 B, Q90) B: bus-idle (`P . . BP . S`, the count's release as OUT imm8's port byte)
    cnt=IL                                  ; the count into the loop counter (028E)
    bi alt                                  ; (qprobe round 23, spec 18 A2 / Q101b, model_m SHLI_ACT C) C: the sixth word is a commit word (it passes on the third-last clock of the chain's second fetch behind an EU cycle); before round 23 S (round 9, Q24; round 20, spec 16 B: the slot's wait); 11 + 2n words
    jc=CNTZ:shim_z                          ; a zero count skips the loop and the write
shim_l: alu=SH1 ax=SIG                      ; one shift step
    loop=shim_l                             ; the counter step
    open                                    ; OPEN: a book clock with no act (as the CL form's)
    wr=RM ws=SIG alu=SHF ax=SIG wf          ; the result written; the shift's flags (W)
shim_z: e ro                                ; E: pop the next opcode; (qprobe round 9) N

; D0 / D1: by one (V20 0114-0117). Measured 10
routine shift_1 op=D0,D1 mod=reg book="SHL reg,1" diff=1 why="OPEN: beyond the book: a named act, the iteration's second word (the V35's two-word iteration, mechanisms 3.4, as the CL form's loop word); silicon's 10 (F3-push-shl1-k4-pE-w0 S-to-S 10, the frozen model exact) against the routine's 9: one clock no act names and the book does not charge, open; the read, the load, (qprobe rule 6: `P . B . . . . N .`, the qprobe shl1 runs; qprobe round 10, Q26: `P . B . . B . N .`, the ib-shl1 runs) the B word, one book clock with no act, the step, the iteration's second word (B), the write, E"
    rb=RM d1=TB s1=RB                       ; the operand into tmpb (0115 M -> tmpb)
    alu=SHI ax=TB                           ; the shifter loaded with CY
    bi                                      ; (qprobe rule 5) the third word waits while a fetch cycle runs (SHL r,1 is `P . B . . . . N .`)
    open                                    ; OPEN: a book clock with no act (SHL reg,1 8)
    alu=SH1 ax=SIG                          ; the one step (0116's R row, COUNT 1)
    alu=NONE bi                             ; the iteration's second word (the two-word iteration: the CL form's loop word); (qprobe round 10, Q26) B: the second bus-idle word (SHL r,1 is `P . B . . B . N .`)
    wr=RM ws=SIG alu=SHF ax=SIG wf       ; the result written; the flags (W) (0117)
    e                                       ; E: pop the next opcode

; F7 /4: MULU r16 (V20 0178-017F, MULX). Measured 34, 26 for the byte form
routine mulu16 op=F7 mod=reg reg=4 book="MULU reg16" diff=1 why="OPEN: silicon longer than the book by one (F14-g-push-mulu_aw-pO-w0: the PUSH's write at +121 with no fetch under the loop, the frozen model exact; 33 at pO, 34 at pE w0 with the unit hold, F16-l-push-mulu_aw-pE-w0 +122, +3 a wait state); the reads on ports A and B, the unit's load, the loop at the entry's third clock (the unit hold: a step waits while a fetch is past its second clock, V35_MX3B_UH, README MX3 (part 2)), 16 steps, the book's ten clocks with no act after the loop, the finish, the two writes" measured="34"
    ra=AW rb=RM d1=TA s1=RA d2=TC s2=RB     ; AW into tmpa (0179), the multiplier into tmpc (0178): ports A and B
    alu=MULI ax=TA ay=TC cnt=BITS           ; the multiplier loaded; the counter <- 16 (017B)
mu16_b: bi                                  ; (qprobe round 11, Q36) B: the bus-idle third word (the loop's entry a word later; the delay after it a word shorter)
    open                                    ; OPEN: (qprobe round 22, spec 18 B, Q102) the fourth word with no act (moved from the delay after the loop)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: the second bus-idle word, the fifth (`P . B . B` + the rest; the loop's entry a word later)
mu16_l: alu=MULS loop=mu16_l                ; one multiply step (017C's R row); the counter step (the unit hold: a fetch's datum phase)
    open call=w7                           ; OPEN: 9 clocks (two moved in front of the loop: spec 18 B): a book clock with no act (MULU reg16 32) (the call and the shared delay's 8)
mu16_f: alu=MULF wf                             ; the product: low half to SIGMA, high to tmpc; CY V (W)
    wr=AW wid=WORD ws=SIG                   ; AW <- the low half (017E)
    wr=DW wid=WORD ws=TC e                  ; DW <- the high half (017F); E

routine mulu8 op=F6 mod=reg reg=4 book="MULU reg8" width=byte diff=1 why="OPEN: silicon longer than the book by one, as MULU reg16 (the a6 sweep's 26 against 34: the same two; F14-g-push-mulu_aw-pO-w0 for the word form); the reads on ports A and B, the unit's load, the loop at the entry's third clock (the unit hold: a step waits while a fetch is past its second clock, V35_MX3B_UH, README MX3 (part 2)), 8 steps, the book's eleven clocks with no act after the loop, the finish, the write" measured="26"
    ra=AW rb=RM d1=TA s1=RA d2=TC s2=RB     ; AL (AW) into tmpa, the multiplier into tmpc: ports A and B
    alu=MULI ax=TA ay=TC cnt=BITS           ; the multiplier loaded; the counter <- 8 (017A)
mu8_b: bi                                   ; (qprobe round 11, Q36) B: the bus-idle third word (the loop's entry a word later; the delay after it a word shorter)
    open                                    ; OPEN: (qprobe round 22, spec 18 B, Q102) the fourth word with no act (moved from the delay after the loop)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: the second bus-idle word, the fifth (`P . B . B` + the rest; the loop's entry a word later)
mu8_l: alu=MULS loop=mu8_l                  ; one multiply step; the counter step (the unit hold: a fetch's datum phase)
    open call=w8                           ; OPEN: 10 clocks (two moved in front of the loop: spec 18 B): a book clock with no act (MULU reg8 24) (the call and the shared delay's 9)
mu8_f: alu=MULF wf                             ; the 16-bit product into SIGMA; CY V (W)
    wr=AW wid=WORD ws=SIG e                 ; AW <- the product; E

; F6 / F7 /5: MUL (signed): the magnitudes into the unit (F1 the signs' difference), the
; unsigned loop, the finish; the product's negation when the signs differ (+8, +1 with the low
; half zero, +1 more with the high half zero too: docs/v35s-eu-timing.md Multiply), a jump on F1
; and on SIGMA's zero test
routine mul16 op=F7 mod=reg reg=5 book="MUL reg16" diff=4 why="OPEN: silicon longer than the book (39-48) by four (F33-out-mul_cw-ld-k1-pE-w0: 1234h x 001Fh, the signs equal, the frozen model exact; docs/v35s-eu-timing.md MUL r16 44 with the signs equal against MULU's 34); the reads on ports A and B, the unit's load, the loop at the entry's third clock (the unit hold: a step waits while a fetch is past its second clock, V35_MX3B_UH, README MX3 (part 2)), 16 steps, the book's seventeen clocks with no act, the finish; the negation (+8, +1, +1) on SGD (F1) and SIGMA's zero test"
    ra=AW rb=RM d1=TA s1=RA d2=TC s2=RB     ; AW into tmpa, the multiplier into tmpc: ports A and B
    alu=MULI ax=TA ay=TC cnt=BITS           ; the magnitudes loaded, F1 the signs' difference; the counter <- 16
mi16_b: bi                                  ; (qprobe round 11, Q36) B: the bus-idle third word (the loop's entry a word later; the delay after it a word shorter)
    open                                    ; OPEN: (qprobe round 22, spec 18 B, Q102) the fourth word with no act (moved from the delay after the loop)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: the second bus-idle word, the fifth (`P . B . B` + the rest; the loop's entry a word later)
mi16_l: alu=MULS loop=mi16_l                ; one multiply step; the counter step (the unit hold)
    open call=w17                           ; OPEN: 19 clocks (two moved in front of the loop: spec 18 B): a book clock with no act (MUL reg16 39-48) (the call and the shared delay's 18)
mi16_f: alu=MULF wf                             ; the product, negated when the signs differ; CY V S Z P AC (W)
    wr=AW wid=WORD ws=SIG jnc=SGD:mi16_e     ; AW <- the low half; the signs equal: to the end
    open call=w6                            ; OPEN: 7 clocks: the book's range: the product's negation (MUL reg16 39-48: +8 with the signs differing) (the call and the shared delay's 6)
    open alu=PASS ax=TC jc=SNZ:mi16_e       ; OPEN: the book's range: the negation's eighth clock; the low half not zero: to the end (SIGMA <- the high half)
    open jc=SNZ:mi16_e                      ; OPEN: the book's range: the low half zero (+1); the high half not zero: to the end
    open                                    ; OPEN: the book's range: the high half zero too (+1)
mi16_e: wr=DW wid=WORD ws=TC e              ; DW <- the high half; E

routine mul8 op=F6 mod=reg reg=5 book="MUL reg8" width=byte diff=5 why="OPEN: silicon longer than the book (31-40) by five (docs/v35s-eu-timing.md MUL r8 37 with the signs equal against MULU r8's 26; no corpus run); the reads on ports A and B, the unit's load, the loop at the entry's third clock (the unit hold: a step waits while a fetch is past its second clock, V35_MX3B_UH, README MX3 (part 2)), 8 steps, the book's eighteen clocks with no act, the finish; the negation (+8) on SGD (F1)"
    ra=AW rb=RM d1=TA s1=RA d2=TC s2=RB     ; AL (AW) into tmpa, the multiplier into tmpc: ports A and B
    alu=MULI ax=TA ay=TC cnt=BITS           ; the magnitudes loaded, F1 the signs' difference; the counter <- 8
mi8_b: bi                                   ; (qprobe round 11, Q36) B: the bus-idle third word (the loop's entry a word later; the delay after it a word shorter)
    open                                    ; OPEN: (qprobe round 22, spec 18 B, Q102) the fourth word with no act (moved from the delay after the loop)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: the second bus-idle word, the fifth (`P . B . B` + the rest; the loop's entry a word later)
mi8_l: alu=MULS loop=mi8_l                  ; one multiply step; the counter step (the unit hold)
    open call=w19                           ; OPEN: 21 clocks (two moved in front of the loop: spec 18 B): a book clock with no act (MUL reg8 31-40) (the call and the shared delay's 20)
mi8_f: alu=MULF wf jnc=SGD:mi8_e                ; the product, negated when the signs differ (W); the signs equal: to the end
    open call=w7                            ; OPEN: 8 clocks: the book's range: the product's negation (MUL reg8 31-40: +8 with the signs differing; the zero halves' clocks not built for the byte form) (the call and the shared delay's 7)
mi8_e: wr=AW wid=WORD ws=SIG e              ; AW <- the product; E

; F6 / F7 /6 /7: DIVU / DIV (V20 0188-0197): the pre-check, one restoring step a word, the
; finish; the divide error ends the instruction with the trap raised (BRK 0 is MX2's)
routine divu16 op=F7 mod=reg reg=6 book="DIVU reg16" diff=2 why="OPEN: silicon longer than the book by two (F16-l-push-divu_ix-pE-w0: the PUSH's write at +130, the frozen model exact; F33-out-divu_cw-ld-k1-pE-w0); the reads on ports A and B, the unit's load, the loop at the entry's third clock (the unit hold: a step waits while a fetch is past its second clock, V35_MX3B_UH, README MX3 (part 2)), 16 steps, the book's sixteen clocks with no act, the finish, the divide error's test (the pre-check's and the range's, one jump after the finish), the two writes" measured="42"
    ra=DW rb=RM wid=WORD d1=TC s1=RA d2=TB s2=RB    ; DW (the dividend's high half) into tmpc, the divisor into tmpb: ports A and B
    ra=AW wid=WORD alu=DIVI ax=RA ay=TB cnt=BITS    ; the dividend DW:AW, the pre-check; the counter <- 16
dv16_b: bi                                  ; (qprobe round 11, Q36) B: the bus-idle third word (the loop's entry a word later; the delay after it a word shorter)
    open                                    ; OPEN: (qprobe round 22, spec 18 B, Q102) the fourth word with no act (moved from the delay after the loop)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: the second bus-idle word, the fifth (`P . B . B` + the rest; the loop's entry a word later)
dv16_l: alu=DIVS loop=dv16_l                ; one restoring step; the counter step (the unit hold: a fetch's datum phase)
    open call=w14                           ; OPEN: 16 clocks (two moved in front of the loop: spec 18 B): a book clock with no act (DIVU reg16 39) (the call and the shared delay's 15)
dv16_f: alu=DIVF wf                             ; the quotient into SIGMA, the remainder into tmpc; the flags (W)
    jc=DTRAP:dv16_t                         ; the pre-check failed (or a signed quotient out of range): the divide error
    wr=AW wid=WORD ws=SIG                   ; AW <- the quotient
    wr=DW wid=WORD ws=TC e                  ; DW <- the remainder; E
dv16_t: jmp=dve                             ; (F3) the divide error: vector 0, the next instruction pushed (trap.uasm dve)

routine divu8 op=F6 mod=reg reg=6 book="DIVU reg8" width=byte diff=2 why="OPEN: silicon longer than the book by two, as DIVU reg16 (the a6 sweep's 34 against 42; F16-l-push-divu_ix-pE-w0 for the word form); the reads on ports A and B, the unit's load, the loop at the entry's third clock (the unit hold: a step waits while a fetch is past its second clock, V35_MX3B_UH, README MX3 (part 2)), 8 steps, the book's seventeen clocks with no act, the finish, the divide error's test, the write" measured="34"
    rb=RM d1=TB s1=RB                       ; the divisor into tmpb
    ra=AW wid=WORD alu=DIVI ax=RA ay=TB cnt=BITS    ; the dividend AW, the pre-check; the counter <- 8
dv8_b: bi                                   ; (qprobe round 11, Q36) B: the bus-idle third word (the loop's entry a word later; the delay after it a word shorter)
    open                                    ; OPEN: (qprobe round 22, spec 18 B, Q102) the fourth word with no act (moved from the delay after the loop)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: the second bus-idle word, the fifth (`P . B . B` + the rest; the loop's entry a word later)
dv8_l: alu=DIVS loop=dv8_l                  ; one restoring step; the counter step (the unit hold: a fetch's datum phase)
    open call=w15                           ; OPEN: 17 clocks (two moved in front of the loop: spec 18 B): a book clock with no act (DIVU reg8 31) (the call and the shared delay's 16)
dv8_f: alu=DIVF wf                             ; {remainder, quotient} into SIGMA; the flags (W)
    jc=DTRAP:dv8_t                          ; the pre-check failed (or a signed quotient out of range)
    wr=AW wid=WORD ws=SIG e                 ; AW <- {AH remainder, AL quotient}; E
dv8_t: jmp=dve                             ; (F3) the divide error: vector 0, the next instruction pushed (trap.uasm dve)

routine div16 op=F7 mod=reg reg=7 book="DIV reg16" diff=6 why="OPEN: silicon longer than the book (54-64) by six (F33-out-div_cw-ld-k1-pE-w0: 0000:1234h / 001Fh, positive, the frozen model exact; docs/v35s-eu-timing.md DIV r16 61 base against DIVU's 42); the reads on ports A and B, the unit's load, the loop at the entry's third clock (the unit hold: a step waits while a fetch is past its second clock, V35_MX3B_UH, README MX3 (part 2)), 16 steps, the book's thirty-one clocks with no act; the dividend's negation (+7) on DN, the quotient's (+2) on SGD (F1); the finish, the divide error's test, the writes"
    ra=DW rb=RM wid=WORD d1=TC s1=RA d2=TB s2=RB    ; DW into tmpc, the divisor into tmpb: ports A and B
    ra=AW wid=WORD alu=DIVI ax=RA ay=TB cnt=BITS    ; the magnitudes, the pre-check, F1 the quotient's sign, DN the dividend's; the counter <- 16
di16_b: bi                                  ; (qprobe round 11, Q36) B: the bus-idle third word (the loop's entry a word later; the delay after it a word shorter)
    open                                    ; OPEN: (qprobe round 22, spec 18 B, Q102) the fourth word with no act (moved from the delay after the loop)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: the second bus-idle word, the fifth (`P . B . B` + the rest; the loop's entry a word later)
di16_l: alu=DIVS loop=di16_l                ; one restoring step; the counter step (the unit hold)
    open call=w21                           ; OPEN: 23 clocks (two moved in front of the loop: spec 18 B): a book clock with no act (DIV reg16 54-64) (the call and the shared delay's 22)
    open call=w9                            ; OPEN: 10 clocks: a book clock with no act (DIV reg16 54-64) (the call and the shared delay's 9)
di16_n: open jnc=DN:di16_q                     ; OPEN: silicon longer than the book (F33-out-div_cw-ld-k1-pE-w0); a positive dividend: on
    open call=w6                            ; OPEN: 7 clocks: the book's range: the dividend's negation (DIV: +7 with a negative dividend, docs/v35s-eu-timing.md Divide) (the call and the shared delay's 6)
di16_q: open jnc=SGD:di16_f                ; OPEN: silicon longer than the book (F33-out-div_cw-ld-k1-pE-w0); the quotient positive: on
    open                                    ; OPEN: the book's range: the quotient's negation (DIV: +2 with the quotient negative)
    open                                    ; OPEN: the book's range: the quotient's negation (DIV: +2 with the quotient negative)
di16_f: alu=DIVF wf                         ; the signs applied; the quotient's range checked (W)
    jc=DTRAP:di16_t                         ; the pre-check failed or out of range: the divide error
    wr=AW wid=WORD ws=SIG                   ; AW <- the quotient
    wr=DW wid=WORD ws=TC e                  ; DW <- the remainder; E
di16_t: jmp=dve                             ; (F3) the divide error: vector 0, the next instruction pushed (trap.uasm dve)

routine div8 op=F6 mod=reg reg=7 book="DIV reg8" width=byte diff=6 why="OPEN: silicon longer than the book (46-56) by six, as DIV reg16 (docs/v35s-eu-timing.md DIV r8 53 base against DIVU r8's 34; no corpus run); the reads on ports A and B, the unit's load, the loop at the entry's third clock (the unit hold: a step waits while a fetch is past its second clock, V35_MX3B_UH, README MX3 (part 2)), 8 steps, the book's thirty-two clocks with no act; the negations on DN and SGD (F1); the finish, the test, the write"
    rb=RM d1=TB s1=RB                       ; the divisor into tmpb
    ra=AW wid=WORD alu=DIVI ax=RA ay=TB cnt=BITS    ; the magnitudes, the pre-check, F1 the quotient's sign, DN the dividend's; the counter <- 8
di8_b: bi                                   ; (qprobe round 11, Q36) B: the bus-idle third word (the loop's entry a word later; the delay after it a word shorter)
    open                                    ; OPEN: (qprobe round 22, spec 18 B, Q102) the fourth word with no act (moved from the delay after the loop)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: the second bus-idle word, the fifth (`P . B . B` + the rest; the loop's entry a word later)
di8_l: alu=DIVS loop=di8_l                ; one restoring step; the counter step (the unit hold)
    open call=w21                           ; OPEN: 23 clocks (two moved in front of the loop: spec 18 B): a book clock with no act (DIV reg8 46-56) (the call and the shared delay's 22)
    open call=w10                           ; OPEN: 11 clocks: a book clock with no act (DIV reg8 46-56) (the call and the shared delay's 10)
di8_n: open jnc=DN:di8_q                     ; OPEN: silicon longer than the book (docs/v35s-eu-timing.md DIV r8 53); a positive dividend: on
    open call=w6                            ; OPEN: 7 clocks: the book's range: the dividend's negation (DIV: +7 with a negative dividend, docs/v35s-eu-timing.md Divide) (the call and the shared delay's 6)
di8_q: open jnc=SGD:di8_f                ; OPEN: silicon longer than the book (docs/v35s-eu-timing.md DIV r8 53); the quotient positive: on
    open                                    ; OPEN: the book's range: the quotient's negation (DIV: +2 with the quotient negative)
    open                                    ; OPEN: the book's range: the quotient's negation (DIV: +2 with the quotient negative)
di8_f: alu=DIVF wf                         ; the signs applied; the quotient's range checked (W)
    jc=DTRAP:di8_t                         ; the pre-check failed or out of range: the divide error
    wr=AW wid=WORD ws=SIG e                 ; AW <- {AH remainder, AL quotient}; E
di8_t: jmp=dve                             ; (F3) the divide error: vector 0, the next instruction pushed (trap.uasm dve)

; ---- (MX3b) the adjusts and the converts: straight routines on AW, the converts through the
; multiply / divide loops (V20 AAM / AAD: the divide and the multiply by the byte loop). The
; adjust's operation is the decode's op3 (ADJ4A 0, ADJ4S 1, ADJBA 2, ADJBS 3).

routine adj4 op=27,2F book="ADJ4A" diff=1 why="OPEN: silicon longer than the book (measured, the extra word OPEN): (qprobe round 15, spec 11 B) ADJ4A is `. . . . . . . . N .` (ten words; the qprobe adj4a runs; ADJ4S by analogy: a guess, not measured); the book's 9: the read and the adjust (W), the write on E with the write-back's hold (the model's wb 2); six book clocks with no act (F33-out-adj4a-k1-pE-w0: the fetch after it 3 late, the OUT's port 1 early: open, README MX3 (part 2))"
    ra=AW wid=WORD alu=ADJ ax=RA wf         ; read AW; the adjust of AL by AC, CY and the digits (W)
    open call=w1                            ; OPEN: 2 clocks with no act (the call and the shared delay's 1)
    bi                                      ; (qprobe round 22, spec 18 B, Q102) B: ADJ4's bus-idle fourth word (`. . . B . . . . N .`)
    open call=w3                            ; OPEN: 4 clocks with no act (ADJ4A: the book's 9 + 1, measured) (the call and the shared delay's 3)
    wr=AW wid=WORD ws=SIG e                 ; AW <- SIGMA; E

; 37 / 3F: ADJBA / ADJBS (AAA / AAS)
routine adjb op=37,3F book="ADJBA" why="OPEN: the book's 17: the read and the adjust (W), the write on E; fourteen book clocks with no act (F33-out-adjba-k1-pE-w0: the fetch after it 1 late, the OUT's write 4 early: open, README MX3 (part 2))"
    ra=AW wid=WORD alu=ADJ ax=RA wf         ; read AW; the adjust of AL and AH (W)
    open call=w13                           ; OPEN: 14 clocks: a book clock with no act (ADJBA 17) (the call and the shared delay's 13)
    wr=AW wid=WORD ws=SIG e                 ; AW <- SIGMA; E

; D4 ib: CVTBD (AAM): AL divided by the byte, eight restoring steps (the byte divide's loop)
routine cvtbd op=D4 book="CVTBD" width=byte diff=2 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 17, Q70, spec 13 B) CVTBD is `. . . P . B . . . . . . . . . . . . . N .` (QPr15a cvtbd, QPr17d: 63 / 66 in the model): three words with no act, the divisor's pop and release on the fourth, AL read into the divide's state, a bus-idle sixth word, four words with no act, eight steps, the finish (W), E with the next opcode on the twentieth; was: silicon longer than the book by one (F33-out-cvtbd-k1-pE-w0)"
    open call=w1                            ; OPEN: (qprobe round 17) two words with no act (the call and the shared delay's 1)
    open                                    ; OPEN: (qprobe round 17) a word with no act
    pop=il bi                               ; pop the divisor byte and release it (the fourth word); (qprobe round 20, spec 16 B, Q90) B: bus-idle (`. . . BP . B`: the operand's release as OUT imm8's port byte)
    ra=AW wid=WORD alu=CVBI ax=RA ay=IMM8 cnt=BITS  ; AL the dividend, the byte the divisor; the counter <- 8
    bi                                      ; (qprobe round 17) B: the bus-idle sixth word
    open call=w3                            ; OPEN: (qprobe round 17) four words with no act (the call and the shared delay's 3)
cvb_l: alu=DIVS loop=cvb_l                  ; one restoring step; the counter step
    ra=AW wid=WORD alu=CVBF ax=RA wf        ; {quotient, remainder} (a zero divisor: AH FFh, AL kept); S Z P of AL (W)
    wr=AW wid=WORD ws=SIG e                 ; AW <- SIGMA; E (the twentieth word): N

; D5 ib: CVTDB (AAD): AH times the immediate by the byte multiply's loop, plus AL (F5: silicon
; multiplies by the byte, f5x; the V20 suite's ten was the core's until F5)
routine cvtdb op=D5 book="CVTDB" width=byte diff=-1 why="book error of one: (qprobe round 21, spec 17 B, Q98) CVTDB is `. . . BP C` + 12 words + `N .` (19 words; the qprobe cvtdb runs, QPr21f: 63 / 66 in the model): two words, the pop, the byte released on a bus-idle fourth word with the set-up, the commit word C, three words, the eight steps, the finish, E (N) on the eighteenth; OPEN: the book's 20: the immediate's latency, its pop, AH read into the multiply's state, eight steps, the finish with AL's add (W), the write on E; six book clocks with no act"
    open call=w1                            ; OPEN: (qprobe round 21) two words with no act (the call and the shared delay's 1)
    pop=il                                  ; pop the multiplier byte (its release is the fourth word's)
    ra=AW wid=WORD alu=CVDI ax=RA ay=IMM8 cnt=BITS bi rl=1  ; (qprobe round 21) B P: bus-idle, the byte released; AH and the byte into the multiply's state; the counter <- 8
    bi alt                                  ; (qprobe round 21) C: the fifth word (the commit word's wait: it waits one clock when the byte's release starts a fetch)
    open call=w2                            ; OPEN: (qprobe round 21) three words with no act (the call and the shared delay's 2)
cvd_l: alu=MULS loop=cvd_l                  ; one multiply step; the counter step
    ra=AW wid=WORD alu=CVDF ax=RA wf        ; AL + the product's low byte, AH zero; the add's flags (W)
    wr=AW wid=WORD ws=SIG e ro              ; AW <- SIGMA; E; N (the eighteenth word)

; ---- (MX3b) 69 / 6B: MUL r16,r/m16,imm16 / imm8 (signed, the decode's op3 5): the immediate's
; pops, the operand and the immediate into the unit (F1 the signs' difference), 16 steps, the
; finish, the low half into the ModR/M reg register; the negation path as MUL r16's
routine mulimm_rw op=69 mod=reg why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 12, Q39) MUL r16,r16,imm16 (69, register) is 41 words, + 8 for a negative product (the qprobe mi16 runs; qprobe round 13, Q44): the immediate released on word 4, bus-idle words two and four words after it, the 16-bit signed routine's loop, the next opcode on the next-to-last word"
    open call=w1                            ; OPEN: (qprobe round 12, Q39) two words with no act (the ModR/M byte released by the loader on the first) (the call and the shared delay's 1)
    pop=il                                  ; the immediate's low byte (released on word 4)
    pop=ih                                  ; its high byte
    rl=2                                    ; (qprobe round 12, Q39) P P2: the immediate released (word 4)
    rb=RM alu=MULI ax=RB ay=IMM cnt=BITS jmp=mir_s ; the operand and the immediate, magnitudes, F1; the counter <- 16
mir_s: bi                                   ; (qprobe round 13, Q44) B: a bus-idle word two words after the immediate's release
    open                                    ; OPEN: (qprobe round 13) a word with no act
    bi                                      ; (qprobe round 13, Q44) B: a bus-idle word four words after the immediate's release
mir_l: alu=MULS loop=mir_l                  ; one multiply step; the counter step (the unit hold)
    open call=w11                           ; OPEN: (qprobe round 13) twelve words with no act (the call and the shared delay's 11)
mir_f: alu=MULF wf                          ; the product, negated when the signs differ (W)
    wr=REG wid=WORD ws=SIG jnc=SGD:mir_e     ; the register <- the low half; the signs equal: to the end
    open call=w6                            ; OPEN: 7 clocks: the product's negation (+8 with the signs differing) (the call and the shared delay's 6)
    open alu=PASS ax=TC jc=SNZ:mir_e        ; OPEN: the negation's eighth clock; the low half not zero: to the end
    open jc=SNZ:mir_e                       ; OPEN: the book's range: the low half zero (+1); the high half not zero: to the end
    open                                    ; OPEN: the book's range: the high half zero too (+1)
mir_e: e ro                                 ; E (N: the next-to-last word)

routine mulimm_rb op=6B mod=reg why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 12, Q39) MUL r16,r16,imm8 (6B, register) is 40 words, + 8 for a negative product (the qprobe mi8 runs; qprobe round 13, Q44): the immediate released on word 3, bus-idle words two and four words after it, 69's loop and tail"
    open call=w1                            ; OPEN: (qprobe round 12, Q39) two words with no act (the call and the shared delay's 1)
    pop=il                                  ; the immediate byte (released on word 3)
    rl=1                                    ; (qprobe round 12, Q39) P: the immediate released (word 3)
    rb=RM alu=MULI ax=RB ay=IMM cnt=BITS jmp=mir_s  ; the operand and the immediate (sign-extended), magnitudes, F1; the counter <- 16; the slot word and the loop

routine mulimm_mw op=69 mod=mem ea=bare why="OPEN: (qprobe round 14, spec 10 B) MUL r16,mem,imm16 is `P . . BY DPP2 . B . B`, 39 words in all, N on word 38 (the qprobe mi16m runs, [BW]; the sign term, + 8 words when the signs differ, as on the register form: not exercised on memory); no book value: the add, the read, the immediate's pops under the cycle, F with the magnitudes' load, the register form's loop and tail (mir_l)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P)
    open call=w1                            ; OPEN: (qprobe round 14) two words with no act (the call and the shared delay's 1)
    bi                                      ; (qprobe round 14) BY: bus-idle (the read due four clocks after it)
    pop=il                                  ; the immediate's low byte (released on the datum word)
    pop=ih                                  ; its high byte
    bus=MEMR                                ; post the read (BY + 3)
    f alu=MULI ax=OPR ay=IMM cnt=BITS rl=2  ; D P P2: F: the datum and the immediate, magnitudes, F1; the counter <- 16; the immediate released
    open                                    ; OPEN: a word with no act
mim_s: bi                                   ; (qprobe round 14) B: a bus-idle word two words after the datum word
    open                                    ; OPEN: a word with no act
    bi                                      ; (qprobe round 14) B: a bus-idle word four words after the datum word
mim_l: alu=MULS loop=mim_l                  ; one multiply step; the counter step (the unit hold)
    open call=w8                            ; OPEN: (qprobe round 14) nine words with no act (the call and the shared delay's 8)
    open jmp=mir_f                          ; OPEN: a word with no act (the memory forms' wait two words shorter than the register form's: measured); the register form's finish

routine mulimm_mb op=6B mod=mem ea=bare why="OPEN: (qprobe round 14, spec 10 B) MUL r16,mem,imm8 is `P . V DP . B . B`, 38 words in all, N on word 37 (the qprobe mi8m runs, [BW]; the sign term as on the register form, not exercised on memory); no book value: as 69 with one immediate byte"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add (the ModR/M byte released by the loader: P)
    pop=il                                  ; the immediate byte (released on the datum word)
    rl=x bi alt                             ; (qprobe round 14) V: the late request word (the read due four clocks after it)
    open call=w1                            ; OPEN: two words with no act (the call and the shared delay's 1)
    bus=MEMR                                ; post the read (V + 3)
    f alu=MULI ax=OPR ay=IMM cnt=BITS rl=1  ; D P: F: the datum and the immediate, magnitudes, F1; the counter <- 16; the immediate released
    open jmp=mim_s                          ; OPEN: a word with no act; 69's memory words from the first bus-idle word
