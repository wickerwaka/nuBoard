rou_q: bus=MEMR seg=DSP                     ; q: post the element's read (issued q + 1: c22 first)
    ra=DW wid=WORD d1=ADDR s1=RA            ; q + 1: the port DW into the address register
    ra=IX wid=WORD alu=STEP ax=RA           ; q + 2: SIGMA = IX + the width
    wr=IX ws=SIG wid=WORD                   ; q + 3: IX stepped
    f d1=OPRW s1=OPR                        ; q + 4: F: the datum into the write datum (the W clocks)
    ra=CW wid=WORD alu=DEC ax=RA            ; q + 5: SIGMA = CW - 1
    wr=CW ws=SIG wid=WORD                   ; q + 6: CW written
    jnc=SNZ:rou_l                           ; q + 7: CW = 0: the last element's path
    bus=IOW                                 ; q + 8: post the I/O write (issued q + 9)
    ra=IX wid=WORD d1=ADDR s1=RA tki=intr   ; q + 9: the next source's address; (F5e) the take point (the element's I/O write posted: the entry's first post waits for its end)
    open call=w2                            ; OPEN: q + 10 .. q + 12, the element's clocks with no act
    open jmp=rou_q                          ; OPEN: q + 13; the next element at q + 14
rou_l: open                                 ; OPEN: q + 8, the exit path's clock before the last I/O write (F24-out-r-rep-outm-w-n2-pE-w0: the last write 9 after its read, the others 8)
    bus=IOW jmp=xb9                         ; q + 9: post the last I/O write (issued q + 10); q + 10 .. q + 18 OPEN, E at q + 19 (wb)

routine rep_cmpbk op=A6,A7 page=rep bookx="2+16+(23+2W)n" n=4 diff=11 why="OPEN: silicon longer than the book: silicon's 32 + 18n + the overrun (F24-out-r-repe-cmpbk-w-n2-pE-w0: the destination read first, issued at c20, the source's 9 (+ W) after it, the next element's 9 (+ W) after that; the next element's two reads posted before the tests take effect (the overrun); E 18 (+ W) after the overrun's source read on the condition's exit, 19 on the count's, and the wb; n = 0 17): the element 18 + 2W, five short of the book's 23 + 2W (silicon's), the fixed part and the overrun longer (OPEN)"
    ra=CW rb=IY wid=WORD alu=PASS ax=RA d1=ADDR s1=RB ; c2: the REP prefix's word: SIGMA = CW (the count's test); the element's first address IY (the setup's first word: each waits out a memory wait state, MX1g's BW law)
    rb=IY wid=WORD d1=ADDR s1=RB jnc=SNZ:rz_m ; c3: CW = 0: no element; the address again (the setup's second word)
    rb=IY wid=WORD d1=ADDR s1=RB            ; c4: the address again (the setup's third word)
    rb=IY wid=WORD d1=ADDR s1=RB            ; c5: the address again (the setup's fourth word)
    rb=IY wid=WORD d1=ADDR s1=RB call=w12   ; c6: the address again (the setup's fifth word); c7 .. c18 OPEN, the fixed part's clocks with no act
    bus=MEMR seg=DS1                        ; c19: post the first destination read (issued c20)
    ra=IX wid=WORD d1=ADDR s1=RA call=w2    ; c20: the source's address IX; c21 c22 OPEN
    f d1=TB s1=OPR                          ; c23: F: the destination's datum into tmpb
    open call=w3                            ; OPEN: c24 .. c27, the element's clocks with no act
    bus=MEMR seg=DSP                        ; c28: post the first source read (issued c29)
