rou_y: ra=IX wid=WORD d1=ADDR s1=RA rl=x bi tki=rep_brk ; Y: the next element's request word, its address IX; (F5e) the take point (the previous element's I/O write posted)
rou_b: ra=IX wid=WORD alu=STEP ax=RA        ; Y + 1: SIGMA = IX + the width
    ra=CW wr=IX ws=SIG wid=WORD alu=DEC ax=RA ; Y + 2: IX stepped; SIGMA = CW - 1
