    ra=IY wr=IX ws=SIG wid=WORD d1=ADDR s1=RA ; q + 15: IX stepped; the next destination's address
    alu=GRP ax=TA ay=TB wf                  ; q + 16: the compare [IX] - [IY] (W)
    ra=CW wid=WORD alu=DEC ax=RA jmp=rcb_q  ; q + 17: SIGMA = CW - 1; the next element at q + 18

routine rep_cmpm op=AE,AF page=rep bookx="2+16+(16+2W)n" n=4 diff=5 why="OPEN: silicon longer than the book: silicon's (F24-out-r-repne-cmpm-w-n2-pE-w0): the first read issued at c21, the second 10 (+ W) after it, the rest 12 (+ W): the next element's read posted before the tests take effect (the overrun), then the two tests' words (the first element has none before it); E 18 (+ W) after the last read on the condition's exit, 19 on the count's, and the wb; n = 0 17: the element 12 + W against the book's 16 + 2W (silicon's), the fixed part longer (OPEN)"
    ra=CW rb=IY wid=WORD alu=PASS ax=RA d1=ADDR s1=RB ; c2: the REP prefix's word: SIGMA = CW (the count's test); the element's first address IY (the setup's first word: each waits out a memory wait state, MX1g's BW law)
    rb=IY wid=WORD d1=ADDR s1=RB jnc=SNZ:rz_m ; c3: CW = 0: no element; the address again (the setup's second word)
