routine rep_cmpbk op=A6,A7 page=rep bookx="2+16+(23+2W)n" n=4 diff=9 why="OPEN: silicon longer than the book: silicon's 32 + 18n + the overrun (F24-out-r-repe-cmpbk-w-n2-pE-w0: the destination read first, issued at c20, the source's 9 (+ W) after it, the next element's 9 (+ W) after that; the next element's two reads posted before the tests take effect (the overrun); E 18 (+ W) after the overrun's source read on the condition's exit, 19 on the count's, and the wb; n = 0 17): the element 18 + 2W, five short of the book's 23 + 2W (silicon's), the fixed part and the overrun longer (OPEN)"
    ra=CW rb=IY wid=WORD alu=PASS ax=RA d1=ADDR s1=RB ; c4 ((qprobe round 12, spec 7 A3): the prefix is rep_p, c2 c3): SIGMA = CW (the count's test); the element's first address IY
    jnc=SNZ:rz_io                           ; c5: CW = 0: no element ((work order 26) the address's load dropped here: c4 and c6 make the same load; L40 has no room for a register read, a payload and a target in one word)
    rb=IY wid=WORD d1=ADDR s1=RB            ; c6: the address again
    bi call=w12                             ; (qprobe round 18, Q80, spec 14 B2) c7: B, the head's bus-idle fourth word (silicon's head 13 words, the first read a word later than round 12's); c8 .. OPEN, the fixed part's clocks with no act
    bus=MEMR seg=DS1                        ; c20: post the first destination read (issued c21)
    ra=IX wid=WORD d1=ADDR s1=RA            ; c21: the source's address IX
    open call=w1                            ; OPEN: c22 c23 ((work order 26) the delay call takes its own first clock as a word: L40 has no room for a register read, a payload and a target in one word) (the call and the shared delay's 1)
    f d1=TB s1=OPR                          ; c24: F: the destination's datum into tmpb
    open call=w3                            ; OPEN: c25 .. c28, the element's clocks with no act
    bus=MEMR seg=DSP                        ; c29: post the first source read (issued c30)
    open                                    ; OPEN: c30, the tests' clock (no element before the first)
    open jmp=rcb_f                          ; OPEN: c31, the tests' clock; the element's rest at c32 (zz_late.uasm rcb_f: the first element's c32 has no take point)
rcb_q: bus=MEMR seg=DS1                     ; q: post the destination read (issued q + 1)
    ra=IX wr=CW ws=SIG wid=WORD d1=ADDR s1=RA ; q + 1: the source's address IX; CW written (the last element's decrement)
    open call=w1                            ; OPEN: q + 2 q + 3, the element's clocks with no act
    f d1=TB s1=OPR                          ; q + 4: F: the destination's datum into tmpb (the W clocks)
    open call=w3                            ; OPEN: q + 5 .. q + 8, the element's clocks with no act
    bus=MEMR seg=DSP                        ; q + 9: post the source read (issued q + 10)
    jnc=XC:sx_c                             ; q + 10: the last element's condition failed: the exit (this element's reads the overrun)
    jnc=SNZ:sx_w                            ; q + 11: CW = 0: the exit
rcb_t: ra=IY wid=WORD alu=STEP ax=RA tki=si_f ; q + 12: SIGMA = IY + the width; (F5e) the take point after the tests (the element's reads posted, the source's outstanding: si_f takes its datum first)
rcb_u: f d1=TA s1=OPR wr=IY ws=SIG wid=WORD ; q + 13: F: the source's datum into tmpa (the W clocks); IY stepped
    ra=IX wid=WORD alu=STEP ax=RA           ; q + 14: SIGMA = IX + the width
    ra=IY wr=IX ws=SIG wid=WORD d1=ADDR s1=RA ; q + 15: IX stepped; the next destination's address
    alu=GRP ax=TA ay=TB wf                  ; q + 16: the compare [IX] - [IY] (W)
    ra=CW wid=WORD alu=DEC ax=RA jmp=rcb_q  ; q + 17: SIGMA = CW - 1; the next element at q + 18

routine rep_cmpm op=AE,AF page=rep bookx="2+16+(16+2W)n" n=4 diff=3 why="OPEN: silicon longer than the book: silicon's (F24-out-r-repne-cmpm-w-n2-pE-w0): the first read issued at c21, the second 10 (+ W) after it, the rest 12 (+ W): the next element's read posted before the tests take effect (the overrun), then the two tests' words (the first element has none before it); E 18 (+ W) after the last read on the condition's exit, 19 on the count's, and the wb; n = 0 17: the element 12 + W against the book's 16 + 2W (silicon's), the fixed part longer (OPEN)"
    ra=CW rb=IY wid=WORD alu=PASS ax=RA d1=ADDR s1=RB ; c4 ((qprobe round 12, spec 7 A3): the prefix is rep_p, c2 c3): SIGMA = CW (the count's test); the element's first address IY
    jnc=SNZ:rz_io                           ; c5: CW = 0: no element ((work order 26) the address's load dropped here: c4 and c6 make the same load; L40)
    rb=IY wid=WORD d1=ADDR s1=RB            ; c6: the address again
    bi call=w13                             ; (qprobe round 18, Q80, spec 14 B2) c7: B, the head's bus-idle fourth word (silicon's head 14 words, the first read a word later than round 12's); c8 .. OPEN, the fixed part's clocks with no act
    bus=MEMR seg=DS1 jmp=rcm_f              ; c21: post the first read (issued c22); (F5e) zz_late.uasm rcm_f: the first element's b has no take point
rcm_q: bus=MEMR seg=DS1                     ; b + 9: post the next element's read (issued b + 10)
    jnc=XC:sx_c                             ; b + 10: the last element's condition failed: the exit (the read the overrun)
    jnc=SNZ:sx_w                            ; b + 11: CW = 0: the exit
rcm_b: ra=IY wid=WORD alu=STEP ax=RA tki=si_f ; b: SIGMA = IY + the width; (F5e) the take point after the tests (the element's read outstanding: si_f takes its datum first)
    f d1=TA s1=OPR wr=IY ws=SIG wid=WORD    ; (qprobe round 19, Q87, spec 15 A2) b + 1: F: the datum into tmpa, the iteration's second word (`Y D . . . .`: the words behind it serial with the read, 12 + W); IY stepped
    ra=AW alu=GRP ax=RA ay=TA wf            ; b + 2: the compare AW - [IY] (W)
    ra=IY wid=WORD d1=ADDR s1=RA            ; b + 3: the next address (IY as stepped)
    ra=CW wid=WORD alu=DEC ax=RA            ; b + 4: SIGMA = CW - 1
    wr=CW ws=SIG wid=WORD call=w2           ; b + 5: CW written; OPEN: b + 6, b + 7 (the call and the shared delay's 2)
    open jmp=rcm_q                          ; OPEN: b + 8; the next read at b + 9
; the first element (zz_late.uasm rcm_f, from the head's read: `Y D . .`, 10 + W)
rcm_u: wr=IY ws=SIG wid=WORD d1=ADDR s1=SIG ; b + 1: IY stepped; the next address
    open                                    ; OPEN: b + 2, a book clock with no act
    f d1=TA s1=OPR                          ; b + 3: F: the datum into tmpa (the W clocks)
    ra=AW alu=GRP ax=RA ay=TA wf            ; b + 4: the compare AW - [IY] (W)
    ra=CW wid=WORD alu=DEC ax=RA            ; b + 5: SIGMA = CW - 1
    wr=CW ws=SIG wid=WORD                   ; b + 6: CW written
    open                                    ; OPEN: b + 7, a book clock with no act
    open jmp=rcm_q                          ; OPEN: b + 8; the next read at b + 9
