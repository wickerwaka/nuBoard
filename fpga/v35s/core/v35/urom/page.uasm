    open                                    ; OPEN: a book clock with no act (CLR1 reg,imm 7)
    rb=RM alu=BIT ax=RB ay=IMM8 e           ; the register: CLR1; E (the E row's operation)
    wr=RM ws=SIG                            ; the register written on the word after E (its write port: MX3's WBR)

routine b1scl op=14,15,16,17 page=0f diff=r:-1,m00:+0,d8:+0,d16:+0,dir:+0 book="SET1 reg8,CL" bookm="SET1 mem8,CL" why="OPEN: the book's SET1 / NOT1 reg,CL 7 / mem,CL EA + 15, the book's clocks with no act OPEN; the memory paths one over the book's EA: the ModR/M byte's pop on a word of its own (the EAC word, a pop the book's EA does not count: the E word pops only the page's second byte), the frozen model exact on F32-push-test1_mw_cl-k1-pE-w0 and F32-push-set1_mw_cl-k1-pE-w0 (16 and 19 S-to-S at mod 00); book error: silicon's clocks are the routine's words and the take sync's wait (the ModR/M pop arms it: the register path's operation and the memory path's add wait for the fetch the pop's room asked for, MX1f / Correction 15; the book machine has no sync), F32-out-set1_rw_cl-k1-pE-w0 and F34-push-rbit-set1_rw_cl-l0-k1-pE-w0 (9 S-to-S each)"
