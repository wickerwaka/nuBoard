    f alu=BIT ax=OPR ay=IMM8 resv           ; F: CLR1 on the datum; the reservation
    open                                    ; OPEN: a book clock with no act (CLR1 mem,imm EA + 13)
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
