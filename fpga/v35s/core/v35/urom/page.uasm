routine b1sim op=1C,1D,1E,1F page=0f diff=r:0,m00:+0,d8:+0,d16:+0,dir:+0 book="SET1 reg8,imm3" bookm="SET1 mem8,imm3" why="OPEN: the book's SET1 / NOT1 reg,imm 6 / mem,imm EA + 12, the book's clocks with no act OPEN; the index popped after the read's issue; the memory paths one over the book's EA: the ModR/M byte's pop on a word of its own (the EAC word, a pop the book's EA does not count), the frozen model exact on F32-push-not1_mb_imm-k1-pE-w0 (16 S-to-S at mod 00); book error: silicon's clocks are the routine's words and the take sync's wait (MX1f / Correction 15: the book machine has no sync), F32-out-set1_rw_imm-k1-pE-w0 (9 S-to-S)"
    pop=modrm eac=b1sim_r                   ; pop the ModR/M byte (E + 2)
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR                                ; post the read (E + 7 with the take sync's wait at the add: issued at E + 8, the model's)
    open                                    ; OPEN: a book clock with no act (SET1 mem,imm EA + 12)
    pop=il resv                             ; pop the bit index (the clock after the read's issue: the model's take); the reservation (the write to come: a fetch the pop's room asks for waits unless the queue is low)
    f alu=BIT ax=OPR ay=IMM8 resv           ; F: SET1 / NOT1 on the datum; the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write
    e                                       ; E: held until the write's end (RAMEN)
b1sim_r: pop=il                             ; pop the bit index
    open                                    ; OPEN: a book clock with no act (SET1 reg,imm 6) (the take sync's wait first)
    open                                    ; OPEN: a book clock with no act (SET1 reg,imm 6)
    rb=RM alu=BIT ax=RB ay=IMM8 e           ; the register: SET1 / NOT1; E (the E row's operation)
    wr=RM ws=SIG                            ; the register written on the word after E (its write port: MX3's WBR)

; ---- the digit rotates ROL4 / ROR4 (0F 28 / 2A: op3 0 / 1) on a byte register or at [m]
; with AL (the data book's and the V35's: AL's high digit kept). The register path is the
; book's length after the take sync's wait (the EAC word's ModR/M pop arms it: F32-push-ror4_dl-
; k1-pE-w2, the model exact, waits to the back-to-back fetch's delivery at E + 9, w0 at E + 5);
; the memory path the book's (ROL4) and ROR4 four more, as the register forms (the model's
; read's end to the write's issue 11 and 15: F32-out-rol4_m-k1-pE-w0, F32-out-ror4_m-k1-pE-w0).
; The result's write-back runs past E on the register path (the model's wb 2: an OUT imm8
; after it waits, MX1f).
routine rol4 op=28 page=0f book="ROL4 reg8" bookm="ROL4 mem8" diff=r:0,m00:+1,d8:+1,d16:+1,dir:+1 why="OPEN: the book's ROL4 reg8 17 / mem8 EA + 20 with the take sync's wait (F32-out-rol4_dl-k1-pE-w0: 19 S-to-S, the model exact: the ModR/M pop at E + 2, the fetch it asked for delivered at E + 5; F32-push-rol4_m-k1-pE-w0: the read at E + 8, the write at the read's end + 11, the next start at the write's end); the book's clocks with no act OPEN"
    pop=modrm eac=r4l_r                     ; pop the ModR/M byte (E + 2): register mode to the register path; a memory mode calls its EA head
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add (the take sync's wait first); the reservation
    bus=MEMR wid=BYTE                       ; post the byte's read
    f ra=AW wid=BYTE alu=R4 ax=OPR ay=RA    ; F: the digit rotate of the datum with AL (SIGMA the byte, tmpc the new AL)
    wr=AW wid=BYTE ws=TC                    ; AL written
    open call=w7                            ; OPEN: 8 clocks: a book clock with no act (ROL4 mem8 EA + 20) (the call and the shared delay's 7)
    d1=OPRW s1=SIG bus=MEMW wid=BYTE        ; the byte into the write datum; post the write (the read's end + 10: issued at + 11)
    e                                       ; E: held until the write's end (RAMEN)
r4l_r: rb=RM ra=AW wid=BYTE alu=R4 ax=RB ay=RA ; the register and AL: the digit rotate (the take sync's wait first)
    wr=AW wid=BYTE ws=TC                    ; AL written
    wr=RM wid=BYTE ws=SIG                   ; the register written (F5b: after AL: with AL the operand, the operand's result stays, silicon f5r rot4al)
    open call=w10                           ; OPEN: 11 clocks: a book clock with no act (ROL4 reg8 17) (the call and the shared delay's 10)
    e wb                                    ; E: pop the next opcode; the write-back past E (the model's wb 2, MX1f)

routine ror4 op=2A page=0f book="ROR4 reg8" bookm="ROR4 mem8" diff=r:0,m00:-1,d8:-1,d16:-1,dir:-1 why="OPEN: the book's ROR4 reg8 21 with the take sync's wait (F32-push-ror4_dl-k1-pE-w0 / w2: 23 / 27 S-to-S, the model exact: the ModR/M pop at E + 2, the fetch it asked for delivered at E + 5 / E + 9); the memory path ROL4's and four clocks more, as the register forms (F32-out-ror4_m-k1-pE-w0: the write at the read's end + 15, the model exact), book error of two against the book's EA + 26; the book's clocks with no act OPEN"
    pop=modrm eac=r4r_r                     ; pop the ModR/M byte (E + 2)
    ea=BI ra=BASE rb=INDEX resv             ; the EA's add; the reservation
    bus=MEMR wid=BYTE                       ; post the byte's read
    f ra=AW wid=BYTE alu=R4 ax=OPR ay=RA    ; F: the digit rotate (SIGMA the byte, tmpc the new AL)
    wr=AW wid=BYTE ws=TC                    ; AL written
    open call=w11                           ; OPEN: 12 clocks: a book clock with no act (ROR4 mem8 EA + 26) (the call and the shared delay's 11)
    d1=OPRW s1=SIG bus=MEMW wid=BYTE        ; the byte into the write datum; post the write (the read's end + 14: issued at + 15)
    e                                       ; E: held until the write's end (RAMEN)
r4r_r: rb=RM ra=AW wid=BYTE alu=R4 ax=RB ay=RA ; the register and AL: the digit rotate (the take sync's wait first)
    wr=AW wid=BYTE ws=TC                    ; AL written
    wr=RM wid=BYTE ws=SIG                   ; the register written (F5b: after AL: with AL the operand, the operand's result stays, silicon f5r rot4al)
    open call=w14                           ; OPEN: 15 clocks: a book clock with no act (ROR4 reg8 21) (the call and the shared delay's 14)
    e wb                                    ; E: pop the next opcode; the write-back past E (the model's wb 2, MX1f)
