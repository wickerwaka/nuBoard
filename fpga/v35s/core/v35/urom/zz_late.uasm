; (F5b) Routines and bodies added after F5: this file sorts last, so its words follow every other
; routine's and no existing entry address moves (the generated decode tables' entries stay as
; they were; FPGA timing: README "F5b").

; (F5d) REP, then segment prefixes or BUSLOCK, then the opcode (silicon, f5r repsegstr: 220 cases,
; every string opcode under F3 / F2 / 65 / 64, one or two prefixes, BUSLOCK before or after one:
; the string repeats under the REP's condition with the override; batch 3's rep_nx ran it once).
; The E word pops the next opcode into the REP page (ea=REP: the loader keeps the REP byte in the
; opcode register and the popped byte in the ModR/M register, so the dispatch reads the REP
; page's cell: a string's REP routine, another prefix's cell again, or rep_nx for any other
; opcode). nb: no boundary inside the instruction (the REP's offset stays its start: pist)
routine rep_sx op=26,2E,36,3E page=rep why="(F5d) REP then a segment prefix: the prefix set from the cell's byte, the next opcode on the REP page (f5r repsegstr); function only"
    pfx e nb ea=REP                         ; the segment prefix <- the cell's byte's segment; E: the next opcode into the REP page

routine rep_lk op=F0 page=rep why="(F5d) REP then BUSLOCK: the lock pin not built; the next opcode on the REP page, a segment prefix in force kept (f5r repsegstr); function only"
    e nb ea=REP                             ; E: the next opcode into the REP page

; (F5e) an interrupt inside a REP string (silicon, validation/v35s/intr.py f5_si_ops / f5_si_edge /
; f5_si_long / f5_si_inv, both sessions): NMI and the maskable interrupt are taken at the end of
; an element after which the string goes on (the element's bus cycles, its index steps, CW's
; decrement and the exit tests done); an element that ends the string (CW 0, a compare's
; condition failed) is followed by the ordinary boundary (the next instruction's offset pushed).
; The PC pushed is the instruction's first prefix's (ist), so RETI re-enters the whole prefixed
; string with CW, IX, IY as they stand. The take point is a TKI word on an OPEN clock (or an act
; with no sequencing) of each REP loop after its tests: no clock when no interrupt is taken. The
; single step is not taken there (one trap per string); the BCD strings, the shifts and PREPARE
; are not interrupted (f5_si_long). (qprobe round 11) The non-compare REP loops carry their take
; point on the next element's request word (str.uasm).
; the compares' first element enters the element's rest without a take point (silicon takes
; after the first element, never before it: f5_repint, f5_si_ops)
routine si_first why="(F5e) REP CMPBK / CMPM: the first element's step word, the loop's own carries the take point; function only"
rcb_f: ra=IY wid=WORD alu=STEP ax=RA jmp=rcb_u ; c31: SIGMA = IY + the width (rcb_t's act); the element's rest
rcm_f: ra=IY wid=WORD alu=STEP ax=RA jmp=rcm_u ; b: SIGMA = IY + the width (rcm_b's act); the element's rest

; a compare's take: the next element's read posted before the tests (the overrun) is waited for
; and its datum dropped, then the interrupt entry (the element is read again after RETI)
routine si_cmp why="(F5e) a REP compare's take point: the overrun's datum dropped, then the entry; function only"
si_f: f jmp=intr_k                          ; F: the outstanding read's datum (discarded); the interrupt entry (WO39: the take point's)

; (F5g) D6 /r: CLR1 r/m8 with the bit number in the ModR/M reg field (silicon, validation/v35s/d6.py
; f5_d6 / f5_d6b, both sessions): the memory form reads the byte, clears bit reg and always
; writes the byte back (81h /1 writes 81h); the register form clears bit reg of the byte
; register rm; the flags and every other register unchanged; the length the opcode, the ModR/M
; byte and its displacement (no immediate). The decode: D6 a ModR/M opcode whose second level
; carries the reg field as op3 (uasm D6_BITREG, the groups' rule). The operation is CLR1's
; (b1cim / b1ccl: the byte's mask, the clear, the write) with the mask built from op3 by the
; existing vocabulary: VEC's {op3, 00} (the trap vector source: D6 has no immediate, len 0),
; two x4 steps (VEC4) and two doublings (ADD) put op3 at bits 10:8, BTM makes 1 << op3 (BTCLR's
; bit), BTC clears it (BTCLR's clear). No microword bit, no ALU or source value added.
routine d6clr_m op=D6 mod=mem why="(F5g) D6 /r memory: CLR1 mem8 by the reg field (d6.py f5_d6 / f5_d6b): function only, its clocks not fitted (silicon's not measured)"
    ea=BI ra=BASE rb=INDEX                  ; the EA's add into the address register; the reservation
    bus=MEMR                                ; post the byte's read
    wid=WORD alu=VEC4 ax=VEC                ; SIGMA <- 4 x {op3, 00}: the reg field at bits 6:4
    wid=WORD alu=VEC4 ax=SIG                ; SIGMA <- 4 x it: bits 8:6
    wid=WORD alu=ADD ax=SIG ay=SIG          ; x2: bits 9:7
    wid=WORD alu=ADD ax=SIG ay=SIG          ; x2: bits 10:8
    wid=WORD alu=BTM ax=SIG                 ; SIGMA <- 1 << the reg field (the mask)
    f alu=BTC ax=OPR ay=SIG                 ; F: the datum with the bit cleared (no flags); the reservation
    d1=OPRW s1=SIG bus=MEMW                 ; the result into the write datum; post the write (always: the bit already 0 too)
    e                                       ; E: held until the write's end (RAMEN)

routine d6clr_r op=D6 mod=reg why="(F5g) D6 /r register: CLR1 reg8 by the reg field (d6.py f5_d6b r*_CL / AH / BH / AL): function only, its clocks not fitted (silicon's not measured)"
    wid=WORD alu=VEC4 ax=VEC                ; SIGMA <- 4 x {op3, 00}: the reg field at bits 6:4
    wid=WORD alu=VEC4 ax=SIG                ; bits 8:6
    wid=WORD alu=ADD ax=SIG ay=SIG          ; bits 9:7
    wid=WORD alu=ADD ax=SIG ay=SIG          ; bits 10:8
    wid=WORD alu=BTM ax=SIG                 ; SIGMA <- 1 << the reg field (the mask)
    rb=RM alu=BTC ax=RB ay=SIG e            ; the byte register rm with the bit cleared (no flags); E (the E row's operation)
    wr=RM ws=SIG                            ; the register written on the word after E (its write port: MX3's WBR)

; (r24, model_m EXTX_BASE + 2 o + [n < 16]: the 82 corpus runs of EXT across a word with DL as the
; offset register, F32 / F34) EXT across a word, after the mask (bf.uasm ext_xm / ext_xm2): the
; end is 12 words for a full-word field and 13 for a narrower one. The counter is loaded with
; 15 - w (zero for a full-word field) and tested; the offset's step goes through tmpa and back
; to SIGMA, which the end (ext_t / ext_t2) writes to the offset register.
routine ext_xq_body why="OPEN: (r24) the [n < 16] word of EXT across a word (model_m EXTX_BASE + 2 o + [n < 16])"
ext_xq2: alu=BFK ax=TA d1=TA s1=SIG     ; tmpa <- the offset's step; SIGMA = 15 - width
    cnt=SIG alu=PASS ax=TA              ; the counter <- 15 - width (low four bits: 0 for a full-word field); SIGMA = the offset's step
    jc=CNTZ:ext_xf2                     ; a full-word field: the [n < 16] word skipped
    open                                ; OPEN: the [n < 16] word (a field narrower than the word)
ext_xf2: open call=w2                   ; OPEN: three words with no act (the call and the shared delay's 2)
    open jmp=ext_t2                     ; OPEN: a word with no act; the end
ext_xq: alu=BFK ax=TA d1=TA s1=SIG      ; (the imm4 form's copy) tmpa <- the offset's step; SIGMA = 15 - width
    cnt=SIG alu=PASS ax=TA              ; the counter <- 15 - width; SIGMA = the offset's step
    jc=CNTZ:ext_xf                      ; a full-word field: the [n < 16] word skipped
    open                                ; OPEN: the [n < 16] word
ext_xf: open call=w2                    ; OPEN: three words with no act (the call and the shared delay's 2)
    open jmp=ext_t                      ; OPEN: a word with no act; the end

; (r24, work order 20 B, Q115) ADJBA / ADJBS and EI: a bus-idle third word (`. . B` + 12 / 8 + `N .`,
; the lengths unchanged); the words behind the first two of each routine are here so that no entry
; address moves (loop.uasm adjb, reg.uasm flag_ei)
routine adjb_ei_tail why="OPEN: (r24) the tails of ADJBA / ADJBS and EI behind their bus-idle third word (model_m ADJB, EI)"
adjb_z: bi                              ; B: the bus-idle third word
    open call=w11                       ; OPEN: 12 clocks: book clocks with no act (ADJBA 17) (the call and the shared delay's 11)
    wr=AW wid=WORD ws=SIG e             ; AW <- SIGMA; E
ei_z: open call=w7                      ; OPEN: eight clocks with no act (the call and the shared delay's 7)
    e nb                                ; E ((WO35) IE was set on the first word); (F3) nb: no interrupt or single step at the next instruction's start (f3_step)

; (r25, work order 21 B4, Q121) the single string forms have the REP head's bus-idle word: MOVBK /
; CMPBK `. . . B . Y`, CMPM `. . . B . . Y`, INM `. . . . B X` (STM / LDM already `. . B`). The
; routine's second word calls one of these in place of the shared delay (no entry address moves)
routine str_b why="OPEN: words with no act around the bus-idle word: (r25, work order 21 B4, Q121) the single string forms' bus-idle word (model_m MOVS, CMPBK, SCAS, INM)"
sb3: open                               ; OPEN: a word with no act
    bi                                  ; B: the bus-idle fourth word (MOVBK, CMPBK)
    open ret                            ; OPEN: a word with no act; back to the request word
sb4: open                               ; OPEN: a word with no act
    bi                                  ; B: the bus-idle fourth word (CMPM)
    open                                ; OPEN: a word with no act
    open ret                            ; OPEN: a word with no act; back to the request word
sb5: open                               ; OPEN: a word with no act
    open                                ; OPEN: a word with no act
    bi ret                              ; B: the bus-idle fifth word (INM); back to the I/O request word

; (r25, work order 21 B5, Q122) ADJ4S (2F) is `. . B . . . . N .`, one word shorter than ADJ4A
; (27, loop.uasm adj4); the operation is the decode's op3 as before
routine adj4s op=2F book="ADJ4S" diff=0 why="OPEN: words with no act (measured): (r25, work order 21 B5, Q122) ADJ4S is `. . B . . . . N .` (nine words; QPr25d 66 runs, no data dependence; F33-out-adj4s-k2): the read and the adjust (W), a word with no act, the bus-idle third word, four words with no act, the write on E"
    ra=AW wid=WORD alu=ADJ ax=RA wf         ; read AW; the adjust of AL by AC, CY and the digits (W)
    open                                    ; OPEN: a clock with no act
    bi                                      ; B: ADJ4S's bus-idle third word
    open call=w3                            ; OPEN: 4 clocks with no act (the call and the shared delay's 3)
    wr=AW wid=WORD ws=SIG e                 ; AW <- SIGMA; E

; (WO23) the register paths' ends of ROL4 / ROR4 (urom/page.uasm rol4 / ror4, README "WO23"): the
; rotate's loop grew the two routines by ten words; their memory paths and register heads stay
; on their addresses and the rest is here, so no entry address moves
routine r4_tail why="OPEN: (WO23; qprobe round 12, Q38) the register paths' ends of ROL4 / ROR4: steps 2 to 4 of ROL4's rotate, the writes (inferred, not measured), the residual words with no act before E"
r4l_rt: alu=ROL12                           ; (WO23, inferred, not measured) ROL4: step 2 of 4
    alu=ROL12                               ; (WO23, inferred, not measured) step 3 of 4
    alu=ROL12                               ; (WO23, inferred, not measured) step 4 of 4: the digit rotated left
    wr=AW wid=BYTE ws=TC                    ; (WO23, inferred, not measured) AL written (its high digit kept, the operand's high digit in)
    wr=RM wid=BYTE ws=TB                    ; (WO23, inferred, not measured) the register written (F5b: after AL: with AL the operand, the operand's result stays, silicon f5r rot4al)
    open call=w2                            ; OPEN: (WO23; qprobe round 12, Q38) three words with no act (the call and the shared delay's 2)
    e ro                                    ; E: pop the next opcode (N: ten words after the commit word)
r4r_rt: open call=w1                        ; OPEN: (WO23; qprobe round 12, Q38) ROR4: the second and third words with no act (the call and the shared delay's 1)
    e ro                                    ; E: pop the next opcode (N: fourteen words after the commit word)

; (WO39) the interrupt entry from a string's take point (rep_brk, si_f): intr's words, but a DMA
; transfer taken here (between a REP string's elements) runs the routine as it was before the queue
; was kept (dmk: DAR written back after the write, the string refetched from its first prefix:
; MSPC, FLUSH, E): the take point is no dispatch, the opcode registers hold the string's own
; opcode and its elements' state, and validation/v35s/pfxtake.py f4q_svc d_str (silicon) keeps the
; string's segment prefix through that refetch
routine intr_k why="OPEN: silicon longer than the book (measured, the extra words OPEN): intr's; (WO39) the interrupt entry from a string's take point: intr's words; a DMA transfer resumes the string by its refetch (dmk); function only"
    d1=TC s1=PC ist alu=IVEC                ; tmpc <- the instruction's start; SIGMA <- 4 x the vector taken (or the kind); the acknowledge
    d1=TB s1=SIG jc=SGN:bsk_q               ; a bank-switch take, a macro service or a DMA transfer (tmpb <- the kind)
    d1=ADDR s1=ZERO jnc=SNZ:int_a           ; the INT take: the acknowledge cycles; the address register 0
    d1=ADDR s1=SIG                          ; the vector's address into the address register (intr's iv_c)
    open call=w4                            ; OPEN: (qprobe round 12) five words with no act (the call and the shared delay's 4)
    alu=IVEC jmp=iv_t                       ; (WO43) the acknowledge (intr's iv_c)
bsk_q: alu=INC2 ax=SIG wid=WORD            ; SIGMA <- the kind + 2 (0: a DMA transfer)
    jnc=SNZ:dmk                             ; the DMA transfer (the string refetched)
    alu=PASS ax=TB wid=WORD jmp=bsw_q       ; SIGMA <- the kind again (tmpb); a macro service or a bank switch: intr's path

routine dmk why="(F4c) DMA at a string's take point: one transfer through the channel block, the string refetched (work order 38's routine); function only"
; ---- TC first (the last transfer's TC pin is known before its cycle)
    alu=MSCA wid=WORD                       ; SIGMA <- the channel block's offset (0E00h + 8 x the channel)
    alu=INC2 ax=SIG wid=WORD                ; + 2
    alu=INC2 ax=SIG wid=WORD                ; + 4
    alu=INC2 ax=SIG wid=WORD                ; + 6
    d1=ADDR s1=SIG bus=MEMR seg=IDB wid=WORD   ; post TC's read
    f alu=MSDC ax=OPR wid=WORD              ; F: SIGMA <- TC - 1; the last transfer latched
    d1=OPRW s1=SIG bus=MEMW seg=IDB wid=WORD   ; post TC's write-back
    f alu=MSMD wid=WORD                     ; F: its end; SIGMA <- the kind
    jc=SGN:dk_d                             ; I/O to memory: the destination side alone
; ---- the source side (memory to memory, memory to I/O): SAR written back first
    alu=MSCA wid=WORD                       ; SIGMA <- the block's offset
    alu=INC2 ax=SIG wid=WORD                ; + 2
    alu=INC2 ax=SIG wid=WORD                ; + 4
    d1=ADDR s1=SIG bus=MEMR seg=IDB wid=WORD   ; post the read of {SARH, DARH}
    f alu=SFRH ax=OPR wid=WORD              ; F: SIGMA <- SARH's segment
    d1=TA s1=SIG alu=MSCA wid=WORD          ; tmpa <- it; SIGMA <- the block's offset (SAR)
    d1=ADDR s1=SIG bus=MEMR seg=IDB wid=WORD   ; post SAR's read
    f d1=TB s1=OPR alu=DMS ax=OPR ay=ZERO wid=WORD   ; F: tmpb <- SAR; SIGMA <- SAR stepped
    d1=OPRW s1=SIG bus=MEMW seg=IDB wid=WORD   ; post SAR's write-back
    f alu=MSDR wid=WORD                     ; F: its end; SIGMA <- {W, 0}
    jc=SGN:dk_sw                            ; a word
    d1=ADDR s1=TB bus=MEMR seg=TA wid=BYTE  ; post the source byte's read
    f d1=OPRW s1=OPR alu=MSMD wid=WORD      ; F: the datum into the write datum; SIGMA <- the kind
    jc=SNZ:dk_e                             ; memory to I/O: done
    jmp=dk_d                                ; memory to memory: the destination side
dk_sw: d1=ADDR s1=TB bus=MEMR seg=TA wid=WORD   ; post the source word's read
    f d1=OPRW s1=OPR alu=MSMD wid=WORD      ; F: the datum into the write datum; SIGMA <- the kind
    jc=SNZ:dk_e                             ; memory to I/O: done
; ---- the destination side (memory to memory, I/O to memory): DAR written back after the write
dk_d: alu=MSCA wid=WORD                     ; SIGMA <- the block's offset
    alu=INC2 ax=SIG wid=WORD                ; + 2
    alu=INC2 ax=SIG wid=WORD                ; + 4
    d1=ADDR s1=SIG bus=MEMR seg=IDB wid=WORD   ; post the read of {SARH, DARH}
    f alu=MSEQ ax=OPR wid=WORD              ; F: SIGMA <- DARH's segment
    d1=TA s1=SIG alu=MSCA wid=WORD          ; tmpa <- it; SIGMA <- the block's offset
    alu=INC2 ax=SIG wid=WORD                ; + 2 (DAR)
    d1=ADDR s1=SIG bus=MEMR seg=IDB wid=WORD   ; post DAR's read
    f d1=TB s1=OPR alu=MSDR wid=WORD        ; F: tmpb <- DAR; SIGMA <- {W, 0}
    jc=SGN:dk_dw                            ; a word
    d1=ADDR s1=TB bus=MEMW seg=TA wid=BYTE  ; post the destination byte's write
    f jmp=dk_da                             ; F: its end
dk_dw: d1=ADDR s1=TB bus=MEMW seg=TA wid=WORD   ; post the destination word's write
    f                                       ; F: its end
dk_da: alu=DMS ax=TB ay=ONE wid=WORD        ; SIGMA <- DAR stepped
    d1=OPRW s1=SIG alu=MSCA wid=WORD        ; the write datum <- it; SIGMA <- the block's offset
    alu=INC2 ax=SIG wid=WORD                ; + 2
    d1=ADDR s1=SIG bus=MEMW seg=IDB wid=WORD   ; post DAR's write-back
    f                                       ; F: its end
; ---- the tail: the instruction (or the HALT) again
dk_e: alu=MSPC ax=TC wid=WORD               ; SIGMA <- the offset to resume at
    flush                                   ; FLUSH: the stream from it
    e                                       ; E: the interrupted instruction again

; (WO43) the vectored entry's word behind the acknowledge (trap.uasm iv_c, intr_k): here so that
; no other routine's ROM address moves
routine iv_tail why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 12) intr's word with no act in front of INT 3's request word; (WO43) moved here behind the acknowledge"
iv_t: open jmp=brk_y                        ; OPEN: (qprobe round 12) a word with no act; INT 3's request word (the eleventh: the cycle 16 clocks after the boundary)
