    open                                    ; OPEN: (qprobe round 13, Q44) a word with no act
    bi                                      ; (qprobe round 13, Q44) B: the bus-idle fifth word
    open call=w1                            ; OPEN: (qprobe round 13, Q44) two words with no act (the call and the shared delay's 1)
