    rb=SP wid=WORD d1=ADDR s1=RB alu=INC2 ax=RB    ; SP into the address register (the segment's); SP + 2
    wr=SP wid=WORD ws=SIG rl=x bi           ; SP <- SP + 2; (qprobe round 8) Y: the second request word, two clocks after the first datum word
    open call=w1                            ; OPEN: (qprobe round 8) a word with no act (2 clocks: the call and the shared delay's 1)
    bus=MEMR seg=SS wid=WORD                ; post the segment's read (Y + 3)
    f wr=PS wid=WORD ws=OPR                 ; D: F: PS <- the segment (RAM and the flop)
    alu=PASS ax=TA                          ; the offset into SIGMA
    open                                    ; OPEN: (qprobe round 8) a word with no act
    flush bi                                ; FLUSH: the stream from the offset in the new PS; (qprobe rule 5) waits while a fetch's pin cycle runs
    e ro                                    ; E: the target's opcode, once delivered; ro: released

; ---- RETF imm16 (CA): V20 RETF_IMM 00E4-00ED + RETF; the immediate popped once the first read is
; on the bus; the reservation from the first datum to the second read (the frozen model's
