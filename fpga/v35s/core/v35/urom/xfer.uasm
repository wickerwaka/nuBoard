    f d1=TA s1=OPR alu=ADD ax=SIG ay=DISP rl=2 ; D P P2: F: the return address into tmpa; SIGMA = SP + 2 + the immediate; the immediate released
    wr=SP wid=WORD ws=SIG alu=PASS ax=TA    ; SP <- SP + 2 + imm; the target into SIGMA
    open                                    ; OPEN: (qprobe round 12, Q40) a word with no act
    flush bi                                ; FLUSH: the stream from the return address (bus-idle)
    e ro                                    ; E: the target's opcode, once delivered

