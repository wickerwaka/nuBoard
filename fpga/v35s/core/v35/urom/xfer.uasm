routine retf_imm op=CA book="RET far pop-value" diff=2 why="OPEN: silicon longer than the book (F35-push-far-callf-retf2-pE-w0: the frozen model's reads issued at S+6 and S+16, the immediate taken at S+7 and S+8, a fetch at the second datum (S+19), the flush eight clocks after it, S+27); three book clocks with no act, the offset's read (S+5), SP + 2, the pops with SP and the next address, F with the reservation, five more, the segment's read (S+15), F: PS, SP + 2, + the immediate, SP with the target, SUSP (S+22: the fetch's end), four more, FLUSH, E"
    open call=w2                            ; OPEN: 3 clocks: a book clock with no act (RET far pop-value 28) (the call and the shared delay's 2)
    rb=SP wid=WORD d1=ADDR s1=RB bus=MEMR seg=SS   ; SP into the address register; post the offset's read (S+5)
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    pop=dl wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG   ; pop the immediate's low byte (S+7); SP <- SP + 2; the segment's address
    pop=dh                                  ; pop its high byte (S+8)
    f d1=TA s1=OPR                          ; F: the offset into tmpa (S+9); the reservation (the second read)
    open call=w4                            ; OPEN: 5 clocks: a book clock with no act (RET far pop-value 28) (the call and the shared delay's 4)
    bus=MEMR seg=SS wid=WORD                ; post the segment's read (S+15)
    f wr=PS wid=WORD ws=OPR                 ; F: PS <- the segment (S+19)
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    alu=ADD ax=SIG ay=DISP                  ; SP + 2 + the immediate
    susp wr=SP wid=WORD ws=SIG alu=PASS ax=TA  ; SUSP (S+22: waits while the fetch at the datum runs); SP <- SP + 2 + imm; the offset into SIGMA
    open call=w3                            ; OPEN: 4 clocks: a book clock with no act (RET far pop-value 28) (the call and the shared delay's 3)
    flush                                   ; FLUSH: the stream from the offset in the new PS
    e                                       ; E: the target's opcode, once the refill's run has ended

; ---- CALL far (9A): V20 CALL_FAR_DIR 0068-006B + CALLF 022C-0232 (four Q pops, SUSP, PS pushed,
; PC pushed, PS and PC loaded, FLUSH E). The offset popped as a displacement (no take sync, the
; model's chained take), the segment as an immediate (the take sync armed), the reservation for
; the pushes from its last pop
routine call_far op=9A book="CALL far-proc" diff=-2 why="OPEN: (qprobe round 8, Q21) CALL far is `. . . . PP . Q . PP . Y D . Y D . . F N .` built without Q (the work order: the far forms' Q not built; the qprobe fl-callf runs at W = 0): the offset popped on the fourth and fifth words and released on the fifth, two words with no act, the segment popped on the eighth and ninth and released on the ninth, SP - 2, SP and the address with PS and Y (the first push due four clocks after it, posted three words later), two words with no act, the post, D (F: the first push's end) with SP - 2, SP and the address with the return offset, the second Y two clocks after the first datum word, two words with no act, the post, D (F: its end), PS and the target, a word with no act, F (the flush, bus-idle) three clocks after the second write's end, N, the dispatch (the target's fetch five clocks after the flush word: one tail for every transfer); book error of two in the book check's machine (its refill fetch on the flush's clock); before round 8: pushes posted at S+13 and S+22, SUSP, FLUSH, E (F35-push-far-callf-pE-w0)"
    open call=w2                            ; OPEN: (qprobe round 8) a word with no act (3 clocks: the call and the shared delay's 2)
    pop=dl                                  ; pop the offset's low byte
    pop=dh rl=2                             ; pop its high byte; (qprobe round 8) PP: both offset bytes released
    open call=w1                            ; OPEN: (qprobe round 8) a word with no act (2 clocks: the call and the shared delay's 1)
    pop=il                                  ; pop the segment's low byte
    pop=ih rl=2                             ; pop its high byte; (qprobe round 8) PP: both segment bytes released
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    ra=PS wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=RA rl=x bi   ; SP <- SP - 2; the address register; PS into the write datum; (qprobe round 8) Y: the first request word
    open call=w1                            ; OPEN: (qprobe round 8) a word with no act (2 clocks: the call and the shared delay's 1)
    bus=MEMW seg=SS wid=WORD                ; post the first push (PS) at SS:SP (Y + 3)
    f rb=SP wid=WORD alu=DEC2 ax=RB         ; D: F: the push's end; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=PC   ; SP <- SP - 2; the address; the return offset into the write datum
    rl=x bi                                 ; (qprobe round 8) Y: the second request word, two clocks after the first datum word
    open call=w1                            ; OPEN: (qprobe round 8) a word with no act (2 clocks: the call and the shared delay's 1)
    bus=MEMW seg=SS wid=WORD                ; post the second push (PC) (Y + 3)
    f                                       ; D: F: the push's end
    wr=PS wid=WORD ws=IMM alu=PASS ax=DISP  ; PS <- the segment (RAM and the flop); the offset into SIGMA
    open                                    ; OPEN: (qprobe round 8) a word with no act
    flush bi                                ; FLUSH: the stream from the offset in the new PS; (qprobe rule 5) waits while a fetch's pin cycle runs
    e ro                                    ; E: the target's opcode, once delivered; ro: released

