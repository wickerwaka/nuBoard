; ---- CALL near (E8): V20 CALL near 014C-0151 (Q, Q, SP - 2, SUSP, PC + disp, FLUSH, MEMW SS E)
; The displacement is popped as a displacement (DL DH: no take sync), the push's reservation raised
; on its last pop: the frozen model posts the push on the displacement's take (post_on_take: no
; take sync; the posted write holds the fetches from then)
routine call_near op=E8 book="CALL near-proc" diff=3 why="OPEN: silicon longer than the book by three (F23-push-call-pE-w0: the frozen model's displacement taken at S+3 and S+4, the push posted there and written at S+10 (S+10 at one wait too, F23-push-call-pE-w1), the flush eight clocks after the write's end, S+21, where the book's 21 places it at S+18; the fetch requests held from S+10); the immediate's latency, the pops with the reservation, SP - 2, SP and the address with the return address, two book clocks with no act, the push's post (S+9), F for its end with SUSP, the target's add, six more, FLUSH, E"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=dl                                  ; pop the displacement's low byte (S+3)
    pop=dh resv                             ; pop its high byte (S+4); the reservation (the push is posted)
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=PC   ; SP <- SP - 2; the address register; the return address into the write datum
    open                                    ; OPEN: a book clock with no act (CALL near 21)
    open                                    ; OPEN: silicon longer than the book (F23-push-call-pE-w0)
    bus=MEMW seg=SS wid=WORD                ; post the push at SS:SP (S+9: written at S+10)
    f susp                                  ; F: the push's end (RAMEN); SUSP (S+10)
    alu=ADD ax=PC ay=DISP                   ; the target: the instruction pointer + the displacement
    open call=w5                            ; OPEN: 6 clocks: a book clock with no act (CALL near 21) (the call and the shared delay's 5)
    flush                                   ; FLUSH: the stream from the target
    e                                       ; E: the target's opcode, once the refill's run has ended

; ---- RET (C3): V20 RET 00F0-00F3 (SP -> IND SUSP MEMR SS, INC2, SP, OPR -> PC F E FLUSH)
routine ret op=C3 book="RET" diff=1 why="OPEN: silicon longer than the book by one (F23-push-callret-pE-w0: the frozen model's stack read issued at S+6, the flush eight clocks after its datum; the fetch requests held from S+6); three book clocks with no act, the read's post (S+5), F with SUSP (S+6), SP + 2, SP with the target, five more, FLUSH, E"
    open call=w2                            ; OPEN: 3 clocks: a book clock with no act (RET 19) (the call and the shared delay's 2)
    rb=SP wid=WORD d1=ADDR s1=RB bus=MEMR seg=SS   ; SP into the address register; post the read at SS:SP (S+5)
    f d1=TA s1=OPR susp                     ; F: the return address into tmpa; SUSP (S+6)
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    wr=SP wid=WORD ws=SIG alu=PASS ax=TA    ; SP <- SP + 2; the target into SIGMA
    open call=w4                            ; OPEN: 5 clocks: a book clock with no act (RET 19) (the call and the shared delay's 4)
    flush                                   ; FLUSH: the stream from the return address
    e                                       ; E: the target's opcode, once the refill's run has ended

