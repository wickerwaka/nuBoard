    d1=ADDR s1=VEC bus=MEMR seg=ZERO wid=WORD   ; the vector's address (4n); post the offset's read at 0:4n (S+10)
    f d1=TC s1=OPR alu=INC2 ax=ADDR         ; F: the offset into tmpc; the vector's address + 2
    d1=TB s1=SIG rb=SP wid=WORD alu=DEC2 ax=RB   ; the segment's address into tmpb; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=PSW bus=MEMW seg=SS   ; SP <- SP - 2; the address; the PSW into the write datum; post its push (S+16)
    f alu=CITF wf                           ; F: the push's end; IE and BRK cleared (CITF)
    open call=w2                            ; OPEN: 3 clocks: a book clock with no act (BRK 3 50) (the call and the shared delay's 2)
    d1=ADDR s1=TB bus=MEMR seg=ZERO wid=WORD    ; post the segment's read at 0:4n + 2 (S+24)
    f d1=TA s1=OPR                          ; F: the segment into tmpa
    rb=SP wid=WORD alu=DEC2 ax=RB           ; SP - 2
    ra=PS wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=RA bus=MEMW seg=SS   ; SP <- SP - 2; the address; PS into the write datum; post its push (S+30)
    f                                       ; F: the push's end
    rb=SP wid=WORD alu=DEC2 ax=RB           ; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=PC   ; SP <- SP - 2; the address; the return offset into the write datum
    open                                    ; OPEN: a book clock with no act (BRK 3 50)
    open                                    ; OPEN: a book clock with no act (BRK 3 50)
    bus=MEMW seg=SS wid=WORD                ; post PC's push (S+39)
