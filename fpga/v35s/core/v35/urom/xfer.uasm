    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    alu=ADD ax=SIG ay=DISP                  ; SP + 2 + the immediate
    wr=SP wid=WORD ws=SIG alu=PASS ax=TA susp  ; SP <- SP + 2 + imm; the target into SIGMA; SUSP (S+13)
