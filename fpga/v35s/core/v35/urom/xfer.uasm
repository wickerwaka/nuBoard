routine bcwz op=E3 book="BCWZ short-label" diff=t:-1,nt:+0 why="OPEN: (qprobe round 10, Q27) BCWZ is taken `. . . B . . P . . F N .`, not taken `. . . B . . PN .` (no lead; the qprobe ie-cxz / ie-cxn runs; taken one under the book: book error of one, F35-out-cw-bcwz-t-n0-pE-w0): CW into SIGMA, two words with no act, B (the bus-idle fourth word), two words with no act and the zero test; not taken E with the displacement released (P N); taken the displacement released with the target's add, two words with no act, FLUSH (F) three words after the displacement, E"
    rb=CW wid=WORD alu=PASS ax=RB call=w2   ; CW into SIGMA; OPEN: (qprobe round 10) the second and third words with no act (the call and the shared delay's 2)
    bi call=w1                              ; (qprobe round 10, Q27) B: the bus-idle fourth word; OPEN: a word with no act (the call and the shared delay's 1)
    jc=XC:bcwz_t                            ; the test (taken when CW is zero)
    e ro rl=1                               ; E (not taken): P N: the displacement and the next opcode released
bcwz_t: alu=ADD ax=PC ay=IMM rl=1 call=w2   ; taken: the target; P: the displacement released; OPEN: two words with no act (the call and the shared delay's 2)
    flush bi                                ; FLUSH: the stream from the target (bus-idle)
    e ro                                    ; E: the target's opcode, once delivered; ro: released

; ---- CALL near (E8): V20 CALL near 014C-0151 (Q, Q, SP - 2, SUSP, PC + disp, FLUSH, MEMW SS E)
; The displacement is popped as a displacement (DL DH: no take sync), the push's reservation raised
; on its last pop: the frozen model posts the push on the displacement's take (post_on_take: no
; take sync; the posted write holds the fetches from then)
routine call_near op=E8 book="CALL near-proc" why="OPEN: (qprobe round 8, Q21) CALL near is `. . . . PP . Y D . . F N .` (the qprobe fl-call / cr runs): SP - 2, the displacement popped on the fourth and fifth words and released on the fifth (SP and the address), the return address into the write datum, Y (the request word: the push due four clocks after it, posted three words later), two words with no act, the push's post, D (F: the push's end), the target's add, a word with no act, F (the flush, bus-idle) three clocks after the write's end, N, the dispatch (the target's fetch five clocks after the flush word: one tail for every transfer); the book's 21 in the book check's machine; before round 8: the push posted at S+9, F with SUSP, the target's add, six words, FLUSH, E (F23-push-call-pE-w0)"
    open call=w1                            ; OPEN: (qprobe round 8) a word with no act (2 clocks: the call and the shared delay's 1)
    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    pop=dl wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG   ; pop the displacement's low byte; SP <- SP - 2; the address register
    pop=dh rl=2                             ; pop its high byte; (qprobe round 8) PP: both displacement bytes released
    d1=OPRW s1=PC                           ; the return address (the byte after the displacement) into the write datum
    rl=x bi                                 ; (qprobe round 8) Y: the request word (the push due four clocks after it, posted three words later)
    open call=w1                            ; OPEN: (qprobe round 8) a word with no act (2 clocks: the call and the shared delay's 1)
    bus=MEMW seg=SS wid=WORD                ; post the push at SS:SP (Y + 3)
    f                                       ; D: F: the push's end
    alu=ADD ax=PC ay=DISP                   ; the target: the instruction pointer + the displacement
    open                                    ; OPEN: (qprobe round 8) a word with no act
    flush bi                                ; FLUSH: the stream from the target; (qprobe rule 5) waits while a fetch's pin cycle runs
    e ro                                    ; E: the target's opcode, once delivered; ro: released

; ---- RET (C3): V20 RET 00F0-00F3 (SP -> IND SUSP MEMR SS, INC2, SP, OPR -> PC F E FLUSH)
routine ret op=C3 book="RET" diff=-2 why="OPEN: (qprobe round 8, Q21) RET is `. . Y D . . F N .` (the qprobe fl-ret / ld-ret / cr runs): SP into the address register, SP + 2, SP's write with Y (the request word: the read due four clocks after it, posted three words later), two words with no act, the read's post, D (F: the return address into tmpa), the target into SIGMA, a word with no act, F (the flush, bus-idle) three clocks after the read's end, N, the dispatch (the target's fetch five clocks after the flush word: one tail for every transfer); book error of two in the book check's machine (its refill fetch on the flush's clock); before round 8: the read's post at S+5, F with SUSP, SP, five words, FLUSH, E (F23-push-callret-pE-w0)"
    rb=SP wid=WORD d1=ADDR s1=RB            ; SP into the address register
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    wr=SP wid=WORD ws=SIG rl=x bi           ; SP <- SP + 2; (qprobe round 8) Y: the request word (the read due four clocks after it, posted three words later)
    open call=w1                            ; OPEN: (qprobe round 8) a word with no act (2 clocks: the call and the shared delay's 1)
    bus=MEMR seg=SS wid=WORD                ; post the read at SS:SP (a word; the address register: SP before the add) (Y + 3)
    f d1=TA s1=OPR                          ; D: F: the return address into tmpa
    alu=PASS ax=TA                          ; the target into SIGMA
    open                                    ; OPEN: (qprobe round 8) a word with no act
    flush bi                                ; FLUSH: the stream from the return address; (qprobe rule 5) waits while a fetch's pin cycle runs
    e ro                                    ; E: the target's opcode, once delivered; ro: released

; ---- BR far (EA; the reset vector's): V20 JMP far 015C-0161 (four Q pops, tmpa -> CS SUSP,
