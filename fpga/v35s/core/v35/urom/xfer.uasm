    rb=SP wid=WORD alu=DEC2 ax=RB           ; SP - 2
    open                                    ; OPEN: (qprobe round 13, Q44) a word with no act
    f d1=TA s1=OPR                          ; D: F: the offset into tmpa (Z on this word: the push requested)
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=PSW bus=MEMW seg=SS   ; SP <- SP - 2; the address; the PSW into the write datum; post its push
    f alu=CITF wf                           ; D: F: the push's end; IE and BRK cleared (CITF)
    open call=w1                            ; OPEN: (qprobe round 13, Q44) two words with no act (the call and the shared delay's 1)
    d1=ADDR s1=TB                           ; U's word: the segment's address
    bus=MEMR seg=ZERO wid=WORD              ; U: post the segment's read at 0:4n + 2
    rb=SP wid=WORD alu=DEC2 ax=RB           ; SP - 2
    open call=w2                            ; OPEN: (qprobe round 13, Q44) three words with no act (the call and the shared delay's 2)
    f d1=TB s1=OPR                          ; D: F: the segment into tmpb (Z on this word)
    ra=PS wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=RA bus=MEMW seg=SS   ; SP <- SP - 2; the address; PS into the write datum; post its push
    f rb=SP wid=WORD alu=DEC2 ax=RB         ; D: F: the push's end; SP - 2
    open call=w2                            ; OPEN: (qprobe round 13, Q44) three words with no act (the call and the shared delay's 2)
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=TC   ; Z's word: SP <- SP - 2; the address; tmpc into the write datum (the return offset; an interrupt's: the interrupted instruction's start)
    bus=MEMW seg=SS wid=WORD                ; Z: post PC's push
    f                                       ; D: F: the push's end
    wr=PS wid=WORD ws=TB alu=PASS ax=TA     ; PS <- the vector's segment; the offset into SIGMA
    open                                    ; OPEN: (qprobe round 13, Q44) a word with no act
    flush bi                                ; FLUSH: the stream from the vector (bus-idle)
    e ro                                    ; E: the handler's opcode, once delivered

; ---- RETI (CF): V20 IRET_ 0110 + IRET 01E4-01EA (three stack reads: PC, PS, the PSW; FLUSH)
routine reti op=CF book="RETI" diff=1 why="OPEN: silicon longer than the book (measured, the extra words OPEN): (qprobe round 13, Q44) RETI is `. . Y D . . . U D . . . U D . . . . . . . . F N .` (the qprobe reti runs, 12 / 12): three stack reads nine clocks apart (Y, then U twice), eight words, Q21's flush tail; the PSW restored whole (RB and MD: the bank switches)"
    rb=SP wid=WORD d1=ADDR s1=RB            ; SP into the address register
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    wr=SP wid=WORD ws=SIG rl=x bi           ; SP <- SP + 2; (qprobe round 13, Q44) Y: the request word (PC's read posted three words later)
    open call=w1                            ; OPEN: (qprobe round 13, Q44) two words with no act (the call and the shared delay's 1)
    bus=MEMR seg=SS wid=WORD                ; post PC's read (Y + 3)
    f d1=TA s1=OPR                          ; D: F: the return offset into tmpa
    rb=SP wid=WORD d1=ADDR s1=RB            ; PS's address
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    wr=SP wid=WORD ws=SIG                   ; SP <- SP + 2
    open                                    ; OPEN: (qprobe round 13, Q44) U's word
    bus=MEMR seg=SS wid=WORD                ; U: post PS's read
    f d1=TC s1=OPR                          ; D: F: the segment into tmpc
    rb=SP wid=WORD d1=ADDR s1=RB            ; the PSW's address
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    open                                    ; OPEN: (qprobe round 13, Q44) a word with no act
    open                                    ; OPEN: (qprobe round 13, Q44) U's word
    bus=MEMR seg=SS wid=WORD                ; U: post the PSW's read
    f wr=SP wid=WORD ws=SIG d1=TB s1=OPR    ; D: F: the PSW into tmpb; SP <- SP + 2 in the old bank (F1: silicon's bank 7 SP, f1_psw)
    wr=PSWA ws=TB                           ; the PSW <- tmpb, all 16 bits: RB and MD restored (F1; the bank switches)
    wr=PS wid=WORD ws=TC alu=PASS ax=TA     ; PS <- the segment in the new bank (F1: f1_psw); the offset into SIGMA
    rb=DS0 wr=DS0 wid=WORD ws=RB            ; (F1) DS0's flop from the new bank's slot
    rb=SS wr=SS wid=WORD ws=RB              ; (F1) SS's
    rb=DS1 wr=DS1 wid=WORD ws=RB            ; (F1) DS1's
    open call=w2                            ; OPEN: (qprobe round 13, Q44) three words with no act (the call and the shared delay's 2)
    flush bi                                ; FLUSH: the stream from the return offset in the new PS (bus-idle)
    e seg=NBI ro                            ; E: the target's opcode, once delivered; (F5c) NBI: no maskable interrupt or single step at the next start (f5_step2)
