    open call=w1                            ; OPEN: (qprobe round 13, Q44) two words with no act (the call and the shared delay's 1)
    bus=MEMR seg=ZERO wid=WORD              ; post the offset's read at 0:4n (Y + 3)
    alu=INC2 ax=ADDR                        ; the vector's address + 2
