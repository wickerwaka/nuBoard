    rb=SP wid=WORD d1=ADDR s1=RB            ; SP into the address register
    rb=SP wid=WORD alu=INC2 ax=RB           ; SP + 2
    wr=SP wid=WORD ws=SIG rl=x bi           ; SP <- SP + 2; (qprobe round 8) Y: the request word (the offset's read due four clocks after it, posted three words later)
    open call=w1                            ; OPEN: (qprobe round 8) a word with no act (2 clocks: the call and the shared delay's 1)
    bus=MEMR seg=SS wid=WORD                ; post the offset's read at SS:SP (Y + 3)
