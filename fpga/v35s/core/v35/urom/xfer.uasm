; MX2 the transfers (README "MX2"). Each routine is the data book's formula as its first draft
; (the book check: the routine's clocks to the FLUSH, the refill's first fetch at W = 0, the E
; word and its post-E word); where silicon's events (the frozen model, exact on the run named)
; place the FLUSH later, the extra words are OPEN and declared "silicon longer than the book".
;
; The acts (one a word unless merged):
;   the target's add      SIGMA <- PC + the displacement (SR_PC: the instruction pointer, the
;                         byte after the routine's last pop; IMM: the displacement, a byte
;                         sign-extended (the short forms' format) or a word)
;   the decide            a jump on the format's condition (CD_XC: the PSW's sixteen for 70-7F,
;                         the counter tests of the loop forms on SIGMA) or on SIGMA (CD_SNZ)
;   fw                    the not-taken decide's wait: while a fetch cycle runs or delivers its
;                         word (the frozen model's untaken=wait, nfgap 1)
;   SUSP                  prefetching suspended from the word to the FLUSH; the word waits while
;                         a fetch cycle runs (the V20 ROM's SUSP; the model's flush_held and the
;                         flush's gap after the last fetch)
;   FLUSH                 the queue and the staging register emptied, the stream from SIGMA in PS
;                         (the queue's flush; the refill's first fetch issues on its clock)
;   E                     after a FLUSH it pops the target's opcode once the refill's fetch run
;                         has ended (the sequencer's refill gate: no fetch in flight, the line
;                         down at the last clock's end)
; A short transfer's displacement is popped by the E word with its opcode (the decode's e2: the
; model's take on the start clock) and arms the take sync: the routine's first word waits for
; the word the pop's room asked for (the model's exec clocks start on its delivery).

; ---- BR short (EB): V20 JMP short 0158-015B (Q -> tmpbL, SUSP, PC -> tmpa, SIGMA -> PC FLUSH)
routine br_short op=EB book="BR short-label" diff=1 why="OPEN: silicon longer than the book by one (F30-store-br-short-n0-nop-pO-w0: the frozen model's flush eight clocks after the take sync's release at S+3, S+11, where the book's 12 places it at S+9; F23-push-br-n0-pE-w0: the fetch requests held from S+6, the flush six after the last fetch's end); the target's add, two book clocks with no act, SUSP (S+6 with the sync's release at S+3), four more, FLUSH, E"
    alu=ADD ax=PC ay=IMM                    ; the target: the instruction pointer + the displacement
    open                                    ; OPEN: a book clock with no act (BR short 12)
    open                                    ; OPEN: a book clock with no act (BR short 12)
    susp                                    ; SUSP: prefetching suspended; waits while a fetch cycle runs
    open call=w3                            ; OPEN: 4 clocks: a book clock with no act (BR short 12) (the call and the shared delay's 3)
    flush                                   ; FLUSH: the stream from the target
    e                                       ; E: the target's opcode, once the refill's run has ended

; ---- Bcond (70-7F): V20 JCC 0034-0039 (Q -> tmpbL ALU ADD, JMP OPC, E; taken SUSP, FLUSH E)
routine bcond op=70-7F book="BC/BZ/BNZ/BNC short-label (Bcond)" diff=t:2,nt:-1 why="OPEN: the book's 8 or 15; not taken a book error of one (F23-push-bne-n0-k1-pE-w0: the frozen model's next start at S+8, five clocks after the take sync's release at S+3: the book's 8 less the sync's clock); taken silicon longer than the book by two (F23-push-be-n0-pE-w0: the flush twelve clocks after the sync's release, S+15, the book's 15 placing it at S+12); the target's add, two book clocks with no act, the decide; not taken the decide's wait (the next start three clocks after the last fetch's end, F23-push-bne-n0-k1-pE-w1), E; taken SUSP (the flush nine after the last fetch's end, F23-push-be-n0-pE-w1), seven, FLUSH, E"
    alu=ADD ax=PC ay=IMM                    ; the target: the instruction pointer + the displacement
    open                                    ; OPEN: a book clock with no act (Bcond 8 or 15)
    open                                    ; OPEN: a book clock with no act (Bcond 8 or 15)
    jc=XC:bc_t                              ; the decide: the condition on the PSW (the encoding's)
    fw                                      ; not taken: the decide's wait (a fetch running or delivering)
    e                                       ; E
bc_t: susp                                  ; taken: SUSP
    open call=w6                            ; OPEN: 7 clocks: a book clock with no act (Bcond 15) (the call and the shared delay's 6)
    flush                                   ; FLUSH: the stream from the target
    e                                       ; E: the target's opcode, once the refill's run has ended

; ---- BR near (E9): V20 JMP near 0154-0157 (Q -> tmpbL, Q -> tmpbH, PC -> tmpa SUSP, FLUSH E)
routine br_near op=E9 book="BR near-label" diff=1 why="OPEN: silicon longer than the book by one (F23-push-brnear-n0-pE-w0: the frozen model's displacement taken at S+3 and S+4, the flush five clocks after the take sync's release at S+7, S+12, where the book's 12 places it at S+9 with no sync; the flush four after the last fetch's end); the immediate's latency (MX1b), the pops, the target's add, one book clock, SUSP, two more, FLUSH, E"
    open                                    ; OPEN: the immediate's latency before its first pop (S+3 in every immediate form: MX1b)
    pop=il                                  ; pop the displacement's low byte (S+3)
    pop=ih                                  ; pop its high byte (S+4): the take sync armed
    alu=ADD ax=PC ay=IMM                    ; the target: the instruction pointer + the displacement
    open                                    ; OPEN: a book clock with no act (BR near 12)
    susp                                    ; SUSP: prefetching suspended; waits while a fetch cycle runs
    open                                    ; OPEN: a book clock with no act (BR near 12)
    open                                    ; OPEN: silicon longer than the book (F23-push-brnear-n0-pE-w0)
    flush                                   ; FLUSH: the stream from the target
    e                                       ; E: the target's opcode, once the refill's run has ended

; ---- DBNZ (E2): V20 LOOP 013C-013F, 0138-013B (CX - 1, JMP NZ; SUSP, PC + disp, FLUSH E)
routine dbnz op=E2 book="DBNZ" diff=t:2 why="OPEN: the book's 8 or 17; not taken the book's 8 (F23-push-dbnz-c1-n0-pE-w0: the frozen model's decide a clock after the take sync's release, the next start six after it); taken silicon longer than the book by two (F23-push-dbnz-c2-n0-pE-w0: the flush fourteen clocks after the sync's release, S+17, the book's 17 placing it at S+14); CW - 1 with the decide's wait, CW written with the count test; not taken four book clocks with no act, E; taken SUSP, eleven, FLUSH, E"
    rb=CW wid=WORD alu=DEC ax=RB fw         ; CW - 1 (no flags); the decide's wait (a fetch running or delivering)
    wr=CW wid=WORD ws=SIG jc=XC:dbnz_t      ; CW <- CW - 1; the count test (taken while not zero)
    open call=w3                            ; OPEN: 4 clocks: a book clock with no act (DBNZ 8) (the call and the shared delay's 3)
    e                                       ; E (not taken)
dbnz_t: susp                                ; taken: SUSP
    alu=ADD ax=PC ay=IMM                    ; the target: the instruction pointer + the displacement
    open call=w9                            ; OPEN: 10 clocks: a book clock with no act (DBNZ 17) (the call and the shared delay's 9)
    flush                                   ; FLUSH: the stream from the target
    e                                       ; E: the target's opcode, once the refill's run has ended

; ---- DBNZNE / DBNZE (E0 / E1): V20 LOOPNZ / LOOPZ 0134-013B (JMP REP: the count and Z)
routine dbnz_z op=E0,E1 book="DBNZE" diff=t:3,nt:-2 why="OPEN: the book's 8 or 17; not taken on the Z test a book error of two (F35-out-cw-dbnze-c1-cmpad-pE-w0: the frozen model's next start four clocks after the decide, the decide a clock after the take sync's release); not taken on the count seven after it (F35-out-cw-dbnze-c1-cmpaa-pE-w0), taken silicon longer than the book by three (F35-out-cw-dbnze-c2-cmpaa-pE-w0: the flush fifteen clocks after the sync's release); CW - 1 with the decide's wait, CW written with the Z test (the loop continues on the encoding's Z), the count test, SUSP, eleven, FLUSH, E"
    rb=CW wid=WORD alu=DEC ax=RB fw         ; CW - 1 (no flags); the decide's wait
    wr=CW wid=WORD ws=SIG jnc=XC:dz_z       ; CW <- CW - 1; the Z test (DBNZNE continues on NZ, DBNZE on Z)
    jnc=SNZ:dz_c                            ; the count test (CW - 1 zero: not taken)
    susp                                    ; taken: SUSP
    alu=ADD ax=PC ay=IMM                    ; the target: the instruction pointer + the displacement
    open call=w9                            ; OPEN: 10 clocks: a book clock with no act (DBNZE 17) (the call and the shared delay's 9)
    flush                                   ; FLUSH: the stream from the target
    e                                       ; E: the target's opcode, once the refill's run has ended
