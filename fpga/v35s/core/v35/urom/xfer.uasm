    rb=SP wid=WORD alu=DEC2 ax=RB           ; read SP; SP - 2
    wr=SP wid=WORD ws=SIG d1=ADDR s1=SIG d2=OPRW s2=PC resv   ; SP <- SP - 2; the address; the return address into the write datum; the reservation
    open call=w3                            ; OPEN: 4 clocks: a book clock with no act (CALL regptr16 21) (the call and the shared delay's 3)
    susp                                    ; SUSP (S+10)
    bus=MEMW seg=SS wid=WORD                ; post the push at SS:SP (S+11)
    f alu=PASS ax=TA                        ; F: the push's end; the target into SIGMA
    open call=w6                            ; OPEN: 7 clocks: a book clock with no act (CALL regptr16 21) (the call and the shared delay's 6)
    flush                                   ; FLUSH: the stream from the target
    e                                       ; E: the target's opcode, once the refill's run has ended

