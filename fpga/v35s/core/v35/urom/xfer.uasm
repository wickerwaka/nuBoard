    open                                    ; OPEN: (qprobe round 13, Q44) a word with no act
    pop=port bi                             ; (qprobe round 13, Q44) B P: pop the type byte (into IL) and release it; bus-idle (the fourth word)
    d1=ADDR s1=VEC d2=TC s2=PC              ; the vector's address (4n); the return offset into tmpc (pushed last)
    bi                                      ; (qprobe round 13, Q44) B: the second bus-idle word
    open                                    ; OPEN: (qprobe round 13, Q44) a word with no act
    open jmp=brk_y                          ; OPEN: (qprobe round 13, Q44) a word with no act; INT 3's request word
