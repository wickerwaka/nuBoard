`verilator_config
// Lint waivers for the old core's files the v35 core reuses unchanged (fpga/v35s/core/:
// v35_refresh.sv includes the old generated v35_chain_params.svh, most of which it does not
// read). Nothing in fpga/v35s/core/v35/ is waived.
lint_off -rule UNUSEDPARAM -file "*v35_chain_params.svh"
lint_off -rule UNUSEDSIGNAL -file "*v35_chain_params.svh"
lint_off -rule UNUSEDSIGNAL -file "*v35_refresh.sv"
lint_off -rule UNUSEDSIGNAL -file "*v35_sfr.sv"
