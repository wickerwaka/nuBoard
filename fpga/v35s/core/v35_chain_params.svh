function automatic int v35_ea(input int mode);
    case (mode)
        V35_EAC_BASE: v35_ea = 2;
        V35_EAC_BASE_DISP: v35_ea = 2;
        V35_EAC_BASE_INDEX: v35_ea = 2;
        V35_EAC_BASE_INDEX_DISP: v35_ea = 2;
        V35_EAC_BASE_INDEX_DISP16: v35_ea = 3;
        V35_EAC_DIRECT: v35_ea = 0;
        V35_EAC_DISP: v35_ea = 2;
        default: v35_ea = 0;
    endcase
endfunction

