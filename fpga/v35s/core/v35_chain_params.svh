// ---- The EU's wbsync step before a template (eu.py: wbsync, or wbsync0 for a
// form without operand bytes when the class has it) ----
function automatic bit v35_wbsync(input int cls, input bit one_byte);
    case (cls)
        V35_CLS_OUT: v35_wbsync = one_byte ? 1'b0 : 1'b1;
        default: v35_wbsync = 1'b0;
    endcase
endfunction
