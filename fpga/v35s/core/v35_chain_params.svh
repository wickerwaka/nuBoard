// a clocks/take/setup count is n + per_count * count (a shift's count)
function automatic int v35_tmpl_len(input int tmpl);
    case (tmpl)
        0: v35_tmpl_len = 5;   // branch_near: e9 00 02, taken
        1: v35_tmpl_len = 5;   // branch_short: 74 00
