        V35_CLS_PUSH_R: v35_cost_has = name inside {V35_CN_GAP, V35_CN_POST, V35_CN_PRE, V35_CN_SETUP, V35_CN_SETUP_FREE, V35_CN_WSETUP};
        V35_CLS_PUSH_SEG: v35_cost_has = name inside {V35_CN_POST, V35_CN_SETUP, V35_CN_SETUP_FREE};
        V35_CLS_REG: v35_cost_has = name inside {V35_CN_EXEC, V35_CN_NX, V35_CN_PRE, V35_CN_PRE0};
        V35_CLS_RET: v35_cost_has = name inside {V35_CN_EXEC, V35_CN_FGAP, V35_CN_HOLD, V35_CN_POST, V35_CN_PRE, V35_CN_SETUP, V35_CN_SETUP_FREE};
        V35_CLS_RMW: v35_cost_has = name inside {V35_CN_ALU, V35_CN_DCLK, V35_CN_DFLOOR, V35_CN_GRP, V35_CN_GRP_FREE, V35_CN_GRPCL, V35_CN_POST, V35_CN_PRE, V35_CN_SETUP, V35_CN_SETUP_FREE, V35_CN_SIDLE};
        V35_CLS_RMW_IMM: v35_cost_has = name inside {V35_CN_ALU, V35_CN_DADD, V35_CN_DFLOOR, V35_CN_GRP, V35_CN_GRP1, V35_CN_GRP_FREE, V35_CN_ISTART, V35_CN_POST, V35_CN_PRE, V35_CN_SETUP, V35_CN_SETUP_FREE, V35_CN_SIDLE};
        V35_CLS_SHIFT_CL: v35_cost_has = name inside {V35_CN_EXEC, V35_CN_HPHASE, V35_CN_LOOP, V35_CN_PRE, V35_CN_WB};
        V35_CLS_SHIFT_IMM: v35_cost_has = name inside {V35_CN_CPRE, V35_CN_EXEC, V35_CN_EXEC0, V35_CN_HPHASE, V35_CN_NX, V35_CN_PRE, V35_CN_WB};
        V35_CLS_STORE: v35_cost_has = name inside {V35_CN_DFLOOR, V35_CN_POST, V35_CN_PRE, V35_CN_PRE0, V35_CN_SETUP};
        V35_CLS_STORE_IMM: v35_cost_has = name inside {V35_CN_DADD, V35_CN_DFLOOR, V35_CN_GRP, V35_CN_GRP1, V35_CN_GRP_FREE, V35_CN_ISTART, V35_CN_POST, V35_CN_PRE, V35_CN_SETUP};
        V35_CLS_STR_CMP: v35_cost_has = name inside {V35_CN_CEXIT, V35_CN_CHOLD, V35_CN_EXEC, V35_CN_FIRST, V35_CN_LOOP, V35_CN_MID, V35_CN_NX, V35_CN_PRE, V35_CN_REXIT, V35_CN_RPRE, V35_CN_SETUP, V35_CN_XFETCH, V35_CN_XSPLIT, V35_CN_XWB, V35_CN_ZEXIT, V35_CN_ZFETCH};
        V35_CLS_STR_IN: v35_cost_has = name inside {V35_CN_EXEC, V35_CN_FIRST, V35_CN_LOOP, V35_CN_MID, V35_CN_PRE, V35_CN_REXIT, V35_CN_RPRE, V35_CN_SETUP, V35_CN_XFETCH, V35_CN_XSPLIT, V35_CN_XWB, V35_CN_ZEXIT, V35_CN_ZFETCH};
        V35_CLS_STR_LOAD: v35_cost_has = name inside {V35_CN_EXEC, V35_CN_FIRST, V35_CN_LOOP, V35_CN_PRE, V35_CN_REXIT, V35_CN_RPRE, V35_CN_SETUP, V35_CN_XFETCH, V35_CN_XSPLIT, V35_CN_XWB, V35_CN_ZEXIT, V35_CN_ZFETCH};
        V35_CLS_STR_MOVE: v35_cost_has = name inside {V35_CN_EXEC, V35_CN_FIRST, V35_CN_LOOP, V35_CN_MID, V35_CN_NX, V35_CN_PRE, V35_CN_REXIT, V35_CN_RPRE, V35_CN_SETUP, V35_CN_XFETCH, V35_CN_XSPLIT, V35_CN_XWB, V35_CN_ZEXIT, V35_CN_ZFETCH};
        V35_CLS_STR_OUT: v35_cost_has = name inside {V35_CN_EXEC, V35_CN_FIRST, V35_CN_LAST, V35_CN_LOOP, V35_CN_MID, V35_CN_NX, V35_CN_PRE, V35_CN_REXIT, V35_CN_RPRE, V35_CN_SETUP, V35_CN_XFETCH, V35_CN_XSPLIT, V35_CN_XWB, V35_CN_ZEXIT, V35_CN_ZFETCH};
        V35_CLS_STR_SCAN: v35_cost_has = name inside {V35_CN_CEXIT, V35_CN_CHOLD, V35_CN_EXEC, V35_CN_FIRST, V35_CN_LOOP, V35_CN_LOOP1, V35_CN_NX, V35_CN_PRE, V35_CN_REXIT, V35_CN_RPRE, V35_CN_SETUP, V35_CN_XFETCH, V35_CN_XSPLIT, V35_CN_XWB, V35_CN_ZEXIT, V35_CN_ZFETCH};
