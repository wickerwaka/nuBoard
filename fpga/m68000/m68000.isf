# Unified flow infers the GPIO instances from the top-level ports. This file
# supplies only board-specific voltage and package-pin assignments.
design.set_property("spi_cs_n", "CONN_TYPE", "NORMAL", "GPIO")
design.set_property("spi_sck", "CONN_TYPE", "NORMAL", "GPIO")

design.assign_pkg_pin("clk_50mhz", "A20")
